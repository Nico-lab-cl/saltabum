/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/modelos/*
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *

/videos/*
  Cache-Control: public, max-age=604800

# Panel interno: sin caché, sin indexar, sin iframes y solo scripts propios (+ Turnstile). Mapa de los QR con teselas de OpenStreetMap.
/admin
  ! X-Frame-Options
  ! Referrer-Policy
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://tile.openstreetmap.org; font-src https://fonts.gstatic.com; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

/admin/*
  ! X-Frame-Options
  ! Referrer-Policy
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
