{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saltabum",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Dominio propio (la zona saltabum.cl ya está en Cloudflare).
  "routes": [
    { "pattern": "saltabum.cl", "custom_domain": true },
    { "pattern": "www.saltabum.cl", "custom_domain": true },
  ],
  // Base de datos de reservas del calendario. Sin database_id: Wrangler la crea sola en el primer deploy
  // (y la tabla la crea el Worker la primera vez que la usa). Ver src/lib/server/reservas-db.ts.
  "d1_databases": [{ "binding": "DB", "database_name": "saltabum-reservas" }],
  // Secretos (NO van aquí): ver README → "Secretos".
}
