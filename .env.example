# Copia este archivo como .env y completa los valores.
# Variables PÚBLICAS: se incrustan en el HTML al compilar (en producción se configuran
# como variables de build en GitHub Actions / Cloudflare). Si una queda vacía, ese tag no se carga.

# Meta (Facebook/Instagram) — Events Manager → Orígenes de datos → ID del píxel
PUBLIC_META_PIXEL_ID=1413656430383762

# Google Ads — ID de conversión (AW-XXXXXXXXX) y etiquetas de cada acción de conversión
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=

# Google Analytics 4 — G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Microsoft Clarity — ID del proyecto
PUBLIC_CLARITY_ID=

# WhatsApp — número en formato internacional sin "+" ni espacios (ej. 56912345678)
PUBLIC_WHATSAPP_NUMBER=
