---
import Home from "@design/pages/Home.astro";
import { DESDE, DESDE_HORAS, FAQS, PRODUCTO } from "@design/data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";

const precioDesde = Number(DESDE.replace(/\D/g, ""));

// Datos estructurados de la portada: el servicio de arriendo y las preguntas frecuentes.
// Las respuestas con datos pendientes ([…]) no se publican en el schema.
const jsonLd = [
  {
    "@type": "Service",
    "@id": `${SITE.url}/#arriendo-inflables`,
    name: "Arriendo de juegos inflables",
    serviceType: "Arriendo de juegos inflables para eventos",
    description: `Arriendo del ${PRODUCTO.nombre} (${PRODUCTO.base}, ${PRODUCTO.alto} de alto, para niños de ${PRODUCTO.edad}) con despacho, montaje, anclaje y retiro incluidos.`,
    provider: { "@id": `${SITE.url}/#negocio` },
    areaServed: SITE.comunas.map((name) => ({ "@type": "City", name })),
    offers: {
      "@type": "Offer",
      priceCurrency: "CLP",
      price: precioDesde,
      description: `Desde ${DESDE} por ${DESDE_HORAS}`,
      availability: "https://schema.org/InStock",
    },
  },
  {
    "@type": "FAQPage",
    "@id": `${SITE.url}/#preguntas`,
    mainEntity: FAQS.filter((f) => !f.a.includes("[")).map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <Home />
</BaseLayout>
