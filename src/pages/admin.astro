---
// Panel interno de reservas: ver reservas, bloquear días u horarios y liberar (cancelar).
// Protegido por el secreto ADMIN_TOKEN (se pide al entrar y se guarda solo en esta pestaña).
// Sin tracking ni banner de cookies, y fuera del sitemap (noindex).
import "@/styles/global.css";
import { BLOQUES } from "@/lib/reservas";
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Reservas · Saltabum</title>
  </head>
  <body class="bg-crema text-noche">
    <main class="mx-auto flex max-w-[960px] flex-col gap-6 px-4 py-8">
      <h1 class="font-display text-4xl font-semibold">Reservas</h1>

      <form data-login class="border-noche bg-blanco flex flex-col gap-3 rounded-[20px] border-2 p-5 sm:flex-row sm:items-end">
        <label class="flex flex-1 flex-col gap-1.5 font-bold">
          Contraseña del panel
          <input name="token" type="password" required autocomplete="current-password" class="border-noche min-h-12 rounded-xl border-2 px-3.5" />
        </label>
        <button class="bg-noche text-crema min-h-12 cursor-pointer rounded-full px-6 font-extrabold">Entrar</button>
      </form>

      <section data-panel hidden class="flex flex-col gap-6">
        <form data-bloqueo class="border-noche bg-blanco grid gap-3 rounded-[20px] border-2 p-5 sm:grid-cols-[1fr_1fr_auto_auto] sm:items-end">
          <label class="flex flex-col gap-1.5 font-bold">
            Fecha
            <input name="fecha" type="date" required class="border-noche min-h-12 rounded-xl border-2 px-3" />
          </label>
          <label class="flex flex-col gap-1.5 font-bold">
            Horario
            <select name="bloque" class="border-noche min-h-12 rounded-xl border-2 px-3">
              <option value="todos">Todo el día</option>
              {BLOQUES.map((b) => <option value={b.id}>{b.inicio} a {b.fin}</option>)}
            </select>
          </label>
          <button name="accion" value="bloquear" class="bg-rojo-texto min-h-12 cursor-pointer rounded-full px-5 font-extrabold text-white">Bloquear</button>
          <button name="accion" value="liberar" class="border-noche min-h-12 cursor-pointer rounded-full border-2 px-5 font-extrabold">Liberar</button>
        </form>
        <p data-estado class="text-noche-suave text-sm" aria-live="polite"></p>
        <div class="border-noche bg-blanco overflow-x-auto rounded-[20px] border-2">
          <table class="w-full text-left text-sm">
            <thead class="bg-arena">
              <tr><th class="p-3">Fecha</th><th class="p-3">Horario</th><th class="p-3">Estado</th><th class="p-3">Cliente</th><th class="p-3">Comuna y dirección</th><th class="p-3"></th></tr>
            </thead>
            <tbody data-filas></tbody>
          </table>
        </div>
      </section>
    </main>

    <script>
      import { etiquetaBloque } from "@/lib/reservas";

      type Fila = {
        fecha: string;
        bloque: string;
        estado: string;
        nombre: string | null;
        telefono: string | null;
        comuna: string | null;
        direccion: string | null;
        mensaje: string | null;
      };
      const CLAVE = "saltabum-admin-token";
      const login = document.querySelector<HTMLFormElement>("[data-login]")!;
      const panel = document.querySelector<HTMLElement>("[data-panel]")!;
      const filas = document.querySelector<HTMLElement>("[data-filas]")!;
      const estado = document.querySelector<HTMLElement>("[data-estado]")!;
      const bloqueo = document.querySelector<HTMLFormElement>("[data-bloqueo]")!;
      const fechaLarga = new Intl.DateTimeFormat("es-CL", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });

      const token = () => sessionStorage.getItem(CLAVE) ?? "";
      const api = (init?: RequestInit) =>
        fetch("/api/admin/reservas", {
          ...init,
          headers: { authorization: `Bearer ${token()}`, "content-type": "application/json" },
        });

      async function cargar() {
        const res = await api();
        if (res.status === 401) {
          sessionStorage.removeItem(CLAVE);
          estado.textContent = "";
          panel.hidden = true;
          login.hidden = false;
          alert("Contraseña incorrecta");
          return;
        }
        if (!res.ok) {
          estado.textContent = "El panel no está configurado (falta ADMIN_TOKEN o la base de datos)";
          return;
        }
        const { filas: datos } = (await res.json()) as { filas: Fila[] };
        login.hidden = true;
        panel.hidden = false;
        filas.replaceChildren(
          ...datos.map((f) => {
            const tr = document.createElement("tr");
            tr.className = "border-noche/10 border-t align-top";
            const celdas = [
              fechaLarga.format(new Date(`${f.fecha}T12:00:00Z`)),
              etiquetaBloque(f.bloque),
              f.estado === "reservado" ? "Reservado" : "Bloqueado",
              [f.nombre, f.telefono, f.mensaje].filter(Boolean).join(" · "),
              [f.comuna, f.direccion].filter(Boolean).join(", "),
            ];
            for (const texto of celdas) {
              const td = document.createElement("td");
              td.className = "p-3";
              td.textContent = texto;
              tr.append(td);
            }
            const td = document.createElement("td");
            td.className = "p-3";
            const boton = document.createElement("button");
            boton.className = "text-rojo-texto cursor-pointer font-bold underline";
            boton.textContent = f.estado === "reservado" ? "Cancelar" : "Liberar";
            boton.addEventListener("click", async () => {
              if (f.estado === "reservado" && !confirm(`¿Cancelar la reserva de ${f.nombre ?? "este cliente"}?`)) return;
              await api({ method: "POST", body: JSON.stringify({ accion: "liberar", fecha: f.fecha, bloque: f.bloque }) });
              void cargar();
            });
            td.append(boton);
            tr.append(td);
            return tr;
          }),
        );
        estado.textContent = datos.length ? "" : "No hay reservas ni bloqueos desde hoy";
      }

      login.addEventListener("submit", (e) => {
        e.preventDefault();
        sessionStorage.setItem(CLAVE, String(new FormData(login).get("token") ?? ""));
        void cargar();
      });

      bloqueo.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = new FormData(bloqueo);
        const accion = (e.submitter as HTMLButtonElement | null)?.value ?? "bloquear";
        const res = await api({
          method: "POST",
          body: JSON.stringify({ accion, fecha: data.get("fecha"), bloque: data.get("bloque") }),
        });
        estado.textContent = res.ok ? (accion === "bloquear" ? "Bloqueado" : "Liberado") : "No se pudo guardar";
        void cargar();
      });

      if (token()) void cargar();
    </script>
  </body>
</html>
