---
// Panel interno de Saltabum. Pestañas:
//   · Reservas: calendario, lista, crear, editar, eliminar, registrar pagos (se informan a Meta como compra) y
//     bloquear horarios. Se actualiza solo y lo que se cambia aquí se ve al tiro en la agenda de la web.
//   · Consultas: los mensajes del formulario de contacto (se pueden pasar a reserva).
//   · Historial: todo lo que pasó con las reservas y consultas, quién lo hizo y qué cambió.
//   · Códigos QR: escaneos del QR impreso.
// Acceso con contraseña y código de verificación (TOTP). La seguridad vive en src/lib/server/admin-auth.ts y los
// encabezados en public/_headers (/admin). Sin tracking ni banner de cookies, y fuera del sitemap (noindex).
import "@/styles/global.css";
import PanelConsultas from "@/components/admin/PanelConsultas.astro";
import PanelHistorial from "@/components/admin/PanelHistorial.astro";
import PanelQr from "@/components/admin/PanelQr.astro";
import PanelReservas from "@/components/admin/PanelReservas.astro";

const campo = "border-noche min-h-12 rounded-xl border-2 px-3.5";
const PESTANAS = [
  ["reservas", "Reservas"],
  ["consultas", "Consultas"],
  ["historial", "Historial"],
  ["qr", "Códigos QR"],
] as const;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Panel · Saltabum</title>
  </head>
  <body class="bg-crema text-noche">
    <main class="mx-auto flex max-w-[1280px] flex-col gap-6 px-4 py-6 lg:py-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <img src="/favicon.svg" alt="" width="40" height="40" class="size-10" />
          <h1 class="font-display text-3xl font-semibold lg:text-4xl">Panel Saltabum</h1>
        </div>
        <div data-usuario hidden class="flex items-center gap-3">
          <span class="text-noche-suave text-sm" data-nombre></span>
          <a href="/" target="_blank" rel="noopener" class="text-azul-texto text-sm font-bold underline">Ver la web</a>
          <button data-salir class="border-noche min-h-11 cursor-pointer rounded-full border-2 px-5 font-extrabold">Cerrar sesión</button>
        </div>
      </div>

      <form data-login class="border-noche bg-blanco flex max-w-[440px] flex-col gap-4 rounded-[20px] border-2 p-6" autocomplete="on">
        <p class="font-display text-2xl font-semibold">Ingresar al panel</p>
        <label class="flex flex-col gap-1.5 font-bold">
          Contraseña
          <input name="clave" type="password" required maxlength="256" autocomplete="current-password" autofocus class={campo} />
        </label>
        <label data-campo-codigo hidden class="flex flex-col gap-1.5 font-bold">
          Código de verificación
          <input
            name="codigo"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            autocomplete="one-time-code"
            placeholder="6 dígitos de tu app"
            class={campo}
          />
        </label>
        <button class="bg-noche text-crema min-h-12 cursor-pointer rounded-full px-6 font-extrabold disabled:opacity-50">Entrar</button>
        <p data-error class="text-rojo-texto text-sm font-bold" aria-live="assertive"></p>
      </form>

      <section data-configurar hidden class="border-noche bg-blanco flex max-w-[640px] flex-col gap-4 rounded-[20px] border-2 p-6">
        <p class="font-display text-2xl font-semibold">Crear la contraseña del panel</p>
        <p class="text-noche-suave">
          El panel todavía no tiene contraseña. Escríbela aquí: se transforma en una clave cifrada en este mismo navegador y
          la contraseña no se envía a ningún lado.
        </p>
        <form data-crear class="flex flex-col gap-3">
          <label class="flex flex-col gap-1.5 font-bold">
            Contraseña (mínimo 12 caracteres, una frase larga es lo más seguro)
            <input name="nueva" type="password" required minlength="12" maxlength="256" autocomplete="new-password" class={campo} />
          </label>
          <label class="flex flex-col gap-1.5 font-bold">
            Repite la contraseña
            <input name="repetir" type="password" required minlength="12" maxlength="256" autocomplete="new-password" class={campo} />
          </label>
          <button class="bg-noche text-crema min-h-12 cursor-pointer rounded-full px-6 font-extrabold disabled:opacity-50">Generar clave cifrada</button>
          <p data-crear-error class="text-rojo-texto text-sm font-bold" aria-live="assertive"></p>
        </form>
        <div data-resultado hidden class="flex flex-col gap-3">
          <p class="font-bold">Copia esta línea y pégala en Cloudflare como el secreto <code>ADMIN_USUARIOS</code></p>
          <textarea data-linea readonly rows="4" class="border-noche bg-crema rounded-xl border-2 p-3 font-mono text-xs break-all"></textarea>
          <button data-copiar type="button" class="border-noche min-h-12 cursor-pointer rounded-full border-2 px-6 font-extrabold">Copiar</button>
          <p class="text-noche-suave text-sm">
            Cuando la guardes en Cloudflare, recarga esta página y entra con tu contraseña. Esta línea no permite entrar por
            sí sola, pero guárdala solo en Cloudflare.
          </p>
        </div>
      </section>

      <div data-panel hidden class="flex flex-col gap-6">
        <nav role="tablist" aria-label="Secciones del panel" class="border-noche bg-blanco flex w-fit max-w-full overflow-x-auto rounded-full border-2 p-1">
          {
            PESTANAS.map(([id, nombre], i) => (
              <button
                type="button"
                role="tab"
                id={`pestana-${id}`}
                aria-controls={`panel-${id}`}
                aria-selected={i === 0 ? "true" : "false"}
                data-pestana={id}
                class="aria-selected:bg-noche aria-selected:text-crema min-h-10 cursor-pointer rounded-full px-5 font-extrabold whitespace-nowrap"
              >
                {nombre}
                {id === "consultas" && (
                  <span data-contador="consultas" hidden class="bg-rojo-texto ml-1.5 inline-flex min-w-5 items-center justify-center rounded-full px-1.5 text-xs leading-5 text-white" />
                )}
              </button>
            ))
          }
        </nav>
        <div id="panel-reservas" role="tabpanel" aria-labelledby="pestana-reservas" data-pestana-panel="reservas"><PanelReservas /></div>
        <div id="panel-consultas" role="tabpanel" aria-labelledby="pestana-consultas" data-pestana-panel="consultas" hidden><PanelConsultas /></div>
        <div id="panel-historial" role="tabpanel" aria-labelledby="pestana-historial" data-pestana-panel="historial" hidden><PanelHistorial /></div>
        <div id="panel-qr" role="tabpanel" aria-labelledby="pestana-qr" data-pestana-panel="qr" hidden><PanelQr /></div>
      </div>
    </main>

    <!-- Aviso flotante común a todas las pestañas -->
    <p data-aviso-panel hidden role="status" class="bg-noche text-crema shadow-pop fixed right-4 bottom-4 z-50 max-w-[360px] rounded-2xl px-4 py-3 text-sm font-bold"></p>

    <script>
      const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const login = $<HTMLFormElement>("[data-login]");
      const errorLogin = $("[data-error]");
      const panel = $("[data-panel]");
      const cajaUsuario = $("[data-usuario]");
      const configurar = $("[data-configurar]");
      const campoCodigo = $("[data-campo-codigo]");

      // Encabezado propio: un sitio ajeno no puede enviarlo (defensa CSRF junto con SameSite=Strict y el origen).
      const api = (ruta: string, init?: RequestInit) =>
        fetch(ruta, {
          ...init,
          credentials: "same-origin",
          headers: { "x-saltabum-admin": "1", "content-type": "application/json" },
        });

      function mostrarLogin(mensaje = "") {
        const estabaAbierto = !panel.hidden;
        panel.hidden = true;
        cajaUsuario.hidden = true;
        configurar.hidden = true;
        login.hidden = false;
        errorLogin.textContent = mensaje;
        if (estabaAbierto) document.dispatchEvent(new Event("panel:cerrado"));
      }

      // ── Pestañas ──────────────────────────────────────────────────────────
      function abrirPestana(id: string) {
        document.querySelectorAll<HTMLElement>("[data-pestana]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.pestana === id)));
        document.querySelectorAll<HTMLElement>("[data-pestana-panel]").forEach((p) => (p.hidden = p.dataset.pestanaPanel !== id));
        history.replaceState(null, "", id === "reservas" ? location.pathname : `#${id}`);
        document.dispatchEvent(new CustomEvent("panel:pestana", { detail: id }));
      }
      document.querySelectorAll<HTMLElement>("[data-pestana]").forEach((b) => b.addEventListener("click", () => abrirPestana(b.dataset.pestana!)));
      // Flechas izquierda/derecha entre pestañas.
      $("[role=tablist]").addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const tabs = [...document.querySelectorAll<HTMLElement>("[data-pestana]")];
        const i = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
        const sig = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
        sig.focus();
        abrirPestana(sig.dataset.pestana!);
      });

      // ── Sesión ────────────────────────────────────────────────────────────
      async function cargar() {
        const res = await api("/api/admin/reservas").catch(() => null);
        if (!res) return mostrarLogin("Sin conexión con el panel");
        if (res.status === 401) return mostrarLogin();
        if (res.status === 503) {
          // Sin contraseña cargada: se muestra el asistente para crearla.
          login.hidden = true;
          panel.hidden = true;
          configurar.hidden = false;
          return;
        }
        if (!res.ok) return mostrarLogin("No se pudo cargar el panel");
        const datos = (await res.json()) as { usuario: string };
        login.hidden = true;
        login.reset();
        campoCodigo.hidden = true;
        panel.hidden = false;
        cajaUsuario.hidden = false;
        $("[data-nombre]").textContent = `Sesión de ${datos.usuario}`;
        // Las pestañas cargan sus datos con este aviso (Reservas recibe estos mismos datos).
        document.dispatchEvent(new CustomEvent("panel:listo", { detail: datos }));
        abrirPestana(["consultas", "historial", "qr"].includes(location.hash.slice(1)) ? location.hash.slice(1) : "reservas");
      }

      document.addEventListener("panel:sin-sesion", () => mostrarLogin("Tu sesión expiró, vuelve a ingresar"));
      document.addEventListener("panel:abrir-pestana", (e) => abrirPestana((e as CustomEvent<string>).detail));

      // Contador de pendientes en una pestaña (ej. consultas nuevas).
      document.addEventListener("panel:contador", (e) => {
        const { pestana, n } = (e as CustomEvent<{ pestana: string; n: number }>).detail;
        const contador = document.querySelector<HTMLElement>(`[data-contador="${pestana}"]`);
        if (!contador) return;
        contador.textContent = String(n);
        contador.hidden = n === 0;
      });

      // Aviso flotante (lo piden las pestañas con el evento «panel:aviso»).
      const aviso = $("[data-aviso-panel]");
      let temporizador: ReturnType<typeof setTimeout> | undefined;
      document.addEventListener("panel:aviso", (e) => {
        aviso.textContent = (e as CustomEvent<string>).detail;
        aviso.hidden = false;
        clearTimeout(temporizador);
        temporizador = setTimeout(() => (aviso.hidden = true), 6000);
      });

      login.addEventListener("submit", async (e) => {
        e.preventDefault();
        const datos = new FormData(login);
        const btn = login.querySelector("button")!;
        btn.disabled = true;
        errorLogin.textContent = "";
        const res = await api("/api/admin/login", {
          method: "POST",
          body: JSON.stringify({
            clave: String(datos.get("clave") ?? ""),
            codigo: String(datos.get("codigo") ?? "") || undefined,
          }),
        }).catch(() => null);
        btn.disabled = false;
        if (res?.ok) return void cargar();
        if (res?.status === 401 && ((await res.json().catch(() => ({}))) as { error?: string }).error === "codigo") {
          campoCodigo.hidden = false;
          errorLogin.textContent = "Escribe el código de 6 dígitos de tu app";
          return;
        }
        login.querySelector<HTMLInputElement>("[name=clave]")!.value = "";
        login.querySelector<HTMLInputElement>("[name=codigo]")!.value = "";
        errorLogin.textContent =
          res?.status === 429
            ? "Demasiados intentos. Espera unos minutos antes de volver a probar"
            : res?.status === 403
              ? "No se pudo ingresar, recarga la página"
              : res?.status === 503
                ? "El panel no está configurado"
                : "Contraseña incorrecta";
      });

      $("[data-salir]").addEventListener("click", async () => {
        await api("/api/admin/logout", { method: "POST" }).catch(() => null);
        mostrarLogin("Sesión cerrada");
      });

      // ── Crear contraseña ──────────────────────────────────────────────────
      // Genera la línea del secreto ADMIN_USUARIOS en el navegador (PBKDF2-SHA256, 100.000 iteraciones, sal aleatoria).
      const crear = $<HTMLFormElement>("[data-crear]");
      crear.addEventListener("submit", async (e) => {
        e.preventDefault();
        const datos = new FormData(crear);
        const clave = String(datos.get("nueva") ?? "");
        const error = $("[data-crear-error]");
        if (clave.length < 12) return void (error.textContent = "Usa al menos 12 caracteres");
        if (clave !== String(datos.get("repetir") ?? "")) return void (error.textContent = "Las contraseñas no coinciden");
        error.textContent = "";
        const sal = crypto.getRandomValues(new Uint8Array(16));
        const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(clave), "PBKDF2", false, ["deriveBits"]);
        const bits = await crypto.subtle.deriveBits({ name: "PBKDF2", hash: "SHA-256", salt: sal, iterations: 100_000 }, key, 256);
        const b64 = (u: Uint8Array) => btoa(String.fromCharCode(...u));
        $<HTMLTextAreaElement>("[data-linea]").value = ["saltabum:pbkdf2", "100000", b64(sal), b64(new Uint8Array(bits))].join("$");
        crear.reset();
        crear.hidden = true;
        $("[data-resultado]").hidden = false;
      });
      $("[data-copiar]").addEventListener("click", async () => {
        const linea = $<HTMLTextAreaElement>("[data-linea]");
        linea.select();
        await navigator.clipboard?.writeText(linea.value).catch(() => document.execCommand("copy"));
        $("[data-copiar]").textContent = "Copiada";
      });

      void cargar();
    </script>
  </body>
</html>
