---
// Panel interno de reservas: ver reservas, marcar pagos (se informan a Meta como compra), bloquear un día completo
// o un rango de horas y liberar (cancelar). Acceso con usuario, contraseña y código de verificación (TOTP).
// La seguridad vive en src/lib/server/admin-auth.ts y los encabezados en public/_headers (/admin).
// Sin tracking ni banner de cookies, y fuera del sitemap (noindex).
import "@/styles/global.css";
import Turnstile from "@/components/core/Turnstile.astro";
import PanelQr from "@/components/admin/PanelQr.astro";
import { APERTURA, CIERRE, PASO, aHora } from "@/lib/reservas";

const HORAS: string[] = [];
for (let m = APERTURA; m <= CIERRE; m += PASO) HORAS.push(aHora(m));
const campo = "border-noche min-h-12 rounded-xl border-2 px-3.5";
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Reservas · Saltabum</title>
  </head>
  <body class="bg-crema text-noche">
    <main class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="font-display text-4xl font-semibold">Reservas</h1>
        <div data-usuario hidden class="flex items-center gap-3">
          <span class="text-noche-suave text-sm" data-nombre></span>
          <button data-salir class="border-noche min-h-11 cursor-pointer rounded-full border-2 px-5 font-extrabold">Cerrar sesión</button>
        </div>
      </div>

      <form data-login class="border-noche bg-blanco flex max-w-[440px] flex-col gap-4 rounded-[20px] border-2 p-6" autocomplete="on">
        <p class="font-display text-2xl font-semibold">Ingresar al panel</p>
        <label class="flex flex-col gap-1.5 font-bold">
          Contraseña
          <input name="clave" type="password" required maxlength="256" autocomplete="current-password" autofocus class={campo} />
        </label>
        <label data-campo-codigo hidden class="flex flex-col gap-1.5 font-bold">
          Código de verificación
          <input
            name="codigo"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            autocomplete="one-time-code"
            placeholder="6 dígitos de tu app"
            class={campo}
          />
        </label>
        <Turnstile />
        <button class="bg-noche text-crema min-h-12 cursor-pointer rounded-full px-6 font-extrabold disabled:opacity-50">Entrar</button>
        <p data-error class="text-rojo-texto text-sm font-bold" aria-live="assertive"></p>
      </form>

      <section data-configurar hidden class="border-noche bg-blanco flex max-w-[640px] flex-col gap-4 rounded-[20px] border-2 p-6">
        <p class="font-display text-2xl font-semibold">Crear la contraseña del panel</p>
        <p class="text-noche-suave">
          El panel todavía no tiene contraseña. Escríbela aquí: se transforma en una clave cifrada en este mismo navegador y
          la contraseña no se envía a ningún lado.
        </p>
        <form data-crear class="flex flex-col gap-3">
          <label class="flex flex-col gap-1.5 font-bold">
            Contraseña (mínimo 12 caracteres, una frase larga es lo más seguro)
            <input name="nueva" type="password" required minlength="12" maxlength="256" autocomplete="new-password" class={campo} />
          </label>
          <label class="flex flex-col gap-1.5 font-bold">
            Repite la contraseña
            <input name="repetir" type="password" required minlength="12" maxlength="256" autocomplete="new-password" class={campo} />
          </label>
          <button class="bg-noche text-crema min-h-12 cursor-pointer rounded-full px-6 font-extrabold disabled:opacity-50">Generar clave cifrada</button>
          <p data-crear-error class="text-rojo-texto text-sm font-bold" aria-live="assertive"></p>
        </form>
        <div data-resultado hidden class="flex flex-col gap-3">
          <p class="font-bold">Copia esta línea y pégala en Cloudflare como el secreto <code>ADMIN_USUARIOS</code></p>
          <textarea data-linea readonly rows="4" class="border-noche bg-crema rounded-xl border-2 p-3 font-mono text-xs break-all"></textarea>
          <button data-copiar type="button" class="border-noche min-h-12 cursor-pointer rounded-full border-2 px-6 font-extrabold">Copiar</button>
          <p class="text-noche-suave text-sm">
            Cuando la guardes en Cloudflare, recarga esta página y entra con tu contraseña. Esta línea no permite entrar por
            sí sola, pero guárdala solo en Cloudflare.
          </p>
        </div>
      </section>

      <section data-panel hidden class="flex flex-col gap-6">
        <form data-bloqueo class="border-noche bg-blanco grid gap-3 rounded-[20px] border-2 p-5 sm:grid-cols-[1fr_1fr_1fr_auto] sm:items-end">
          <label class="flex flex-col gap-1.5 font-bold">
            Fecha
            <input name="fecha" type="date" required class="border-noche min-h-12 rounded-xl border-2 px-3" />
          </label>
          <label class="flex flex-col gap-1.5 font-bold">
            Desde
            <select name="desde" class="border-noche min-h-12 rounded-xl border-2 px-3">
              <option value="">Todo el día</option>
              {HORAS.map((h) => <option>{h}</option>)}
            </select>
          </label>
          <label class="flex flex-col gap-1.5 font-bold">
            Hasta
            <select name="hasta" class="border-noche min-h-12 rounded-xl border-2 px-3">
              <option value="">Todo el día</option>
              {HORAS.map((h) => <option>{h}</option>)}
            </select>
          </label>
          <button class="bg-rojo-texto min-h-12 cursor-pointer rounded-full px-5 font-extrabold text-white">Bloquear</button>
        </form>
        <p data-estado class="text-noche-suave text-sm" aria-live="polite"></p>
        <div class="border-noche bg-blanco overflow-x-auto rounded-[20px] border-2">
          <table class="w-full text-left text-sm">
            <thead class="bg-arena">
              <tr>
                <th class="p-3">Fecha</th><th class="p-3">Horario</th><th class="p-3">Estado</th><th class="p-3">Cliente</th>
                <th class="p-3">Comuna y dirección</th><th class="p-3">Total</th><th class="p-3">Pago</th><th class="p-3"></th>
              </tr>
            </thead>
            <tbody data-filas></tbody>
          </table>
        </div>
        <p class="text-noche-suave text-xs">
          Al marcar una reserva como pagada se informa a Meta como venta, para medir qué anuncios traen clientes reales.
          La sesión se cierra sola tras 2 horas sin uso.
        </p>
      </section>

      <PanelQr />
    </main>

    <script>
      import { etiquetaHorario, pesos } from "@/lib/reservas";

      type Fila = {
        id: number;
        fecha: string;
        producto: string;
        inicio: number;
        fin: number;
        total: number | null;
        estado: string;
        nombre: string | null;
        telefono: string | null;
        comuna: string | null;
        direccion: string | null;
        mensaje: string | null;
        pagado: number | null;
        pagado_en: string | null;
        pagado_por: string | null;
      };
      const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const login = $<HTMLFormElement>("[data-login]");
      const errorLogin = $("[data-error]");
      const panel = $("[data-panel]");
      const filas = $("[data-filas]");
      const estado = $("[data-estado]");
      const bloqueo = $<HTMLFormElement>("[data-bloqueo]");
      const cajaUsuario = $("[data-usuario]");
      const fechaLarga = new Intl.DateTimeFormat("es-CL", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });

      // Encabezado propio: un sitio ajeno no puede enviarlo (defensa CSRF junto con SameSite=Strict y el origen).
      const api = (ruta: string, init?: RequestInit) =>
        fetch(ruta, {
          ...init,
          credentials: "same-origin",
          headers: { "x-saltabum-admin": "1", "content-type": "application/json" },
        });

      const configurar = $("[data-configurar]");
      const campoCodigo = $("[data-campo-codigo]");

      function mostrarLogin(mensaje = "") {
        panel.hidden = true;
        cajaUsuario.hidden = true;
        configurar.hidden = true;
        login.hidden = false;
        errorLogin.textContent = mensaje;
        filas.replaceChildren();
        document.dispatchEvent(new Event("panel:cerrado"));
      }

      function celda(texto: string) {
        const td = document.createElement("td");
        td.className = "p-3";
        td.textContent = texto;
        return td;
      }

      function boton(texto: string, clase: string, accion: () => void) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = `cursor-pointer font-bold underline ${clase}`;
        b.textContent = texto;
        b.addEventListener("click", accion);
        return b;
      }

      async function enviar(datos: Record<string, unknown>) {
        const res = await api("/api/admin/reservas", { method: "POST", body: JSON.stringify(datos) });
        if (res.status === 401) mostrarLogin("Tu sesión expiró, vuelve a ingresar");
        return res;
      }

      function celdaPago(f: Fila) {
        const td = celda("");
        if (f.estado !== "reservado") return td;
        if (f.pagado) {
          td.textContent = `Pagada ${pesos(f.pagado)}`;
          td.title = `Por ${f.pagado_por ?? "?"} el ${f.pagado_en ? new Date(f.pagado_en).toLocaleString("es-CL") : "?"}`;
          td.classList.add("font-bold");
          return td;
        }
        td.append(
          boton("Marcar pagada", "text-azul-texto", () => {
            // Pide el monto en la misma celda (abono o total), sin ventanas emergentes.
            const input = document.createElement("input");
            input.type = "number";
            input.min = "1000";
            input.step = "10";
            input.value = String(f.total ?? 20000);
            input.className = "border-noche w-28 rounded-lg border-2 px-2 py-1";
            input.setAttribute("aria-label", "Monto pagado en pesos");
            const ok = boton("Confirmar", "text-azul-texto ml-2", async () => {
              const monto = Math.round(Number(input.value));
              if (!(monto >= 1000)) return void (estado.textContent = "Escribe el monto pagado en pesos");
              ok.disabled = true;
              const res = await enviar({ accion: "pagada", id: f.id, monto });
              const data = (await res.json().catch(() => ({}))) as { meta?: string };
              estado.textContent = res.ok
                ? data.meta === "enviada"
                  ? "Pago guardado y enviado a Meta"
                  : "Pago guardado (Meta no está configurado o no respondió)"
                : "No se pudo guardar el pago";
              void cargar();
            });
            const cancelar = boton("Cancelar", "text-noche-suave ml-2", () => void cargar());
            td.replaceChildren(input, ok, cancelar);
            input.focus();
          }),
        );
        return td;
      }

      async function cargar() {
        const res = await api("/api/admin/reservas");
        if (res.status === 401) return mostrarLogin();
        if (res.status === 503) {
          // Sin contraseña cargada: se muestra el asistente para crearla.
          login.hidden = true;
          panel.hidden = true;
          configurar.hidden = false;
          return;
        }
        if (!res.ok) return mostrarLogin("No se pudo cargar el panel");
        const { filas: datos, usuario } = (await res.json()) as { filas: Fila[]; usuario: string };
        // La sección de los QR (PanelQr) carga sus datos cuando hay sesión.
        if (panel.hidden) document.dispatchEvent(new Event("panel:listo"));
        login.hidden = true;
        login.reset();
        panel.hidden = false;
        cajaUsuario.hidden = false;
        $("[data-nombre]").textContent = `Sesión de ${usuario}`;
        filas.replaceChildren(
          ...datos.map((f) => {
            const tr = document.createElement("tr");
            tr.className = "border-noche/10 border-t align-top";
            tr.append(
              celda(fechaLarga.format(new Date(`${f.fecha}T12:00:00Z`))),
              celda(f.inicio === 0 && f.fin === 24 * 60 ? "Todo el día" : etiquetaHorario(f.inicio, f.fin)),
              celda(f.estado === "reservado" ? "Reservado" : "Bloqueado"),
              celda([f.nombre, f.telefono, f.mensaje].filter(Boolean).join(" · ")),
              celda([f.comuna, f.direccion].filter(Boolean).join(", ")),
              celda(f.total ? pesos(f.total) : ""),
              celdaPago(f),
            );
            const td = celda("");
            td.append(
              boton(f.estado === "reservado" ? "Cancelar" : "Liberar", "text-rojo-texto", async () => {
                if (f.estado === "reservado" && !confirm(`¿Cancelar la reserva de ${f.nombre ?? "este cliente"}?`)) return;
                await enviar({ accion: "liberar", id: f.id });
                void cargar();
              }),
            );
            tr.append(td);
            return tr;
          }),
        );
        if (!datos.length) estado.textContent = "No hay reservas ni bloqueos desde hoy";
      }

      login.addEventListener("submit", async (e) => {
        e.preventDefault();
        const datos = new FormData(login);
        const btn = login.querySelector("button")!;
        btn.disabled = true;
        errorLogin.textContent = "";
        const res = await api("/api/admin/login", {
          method: "POST",
          body: JSON.stringify({
            clave: String(datos.get("clave") ?? ""),
            codigo: String(datos.get("codigo") ?? "") || undefined,
            turnstile_token: String(datos.get("cf-turnstile-response") ?? "") || undefined,
          }),
        }).catch(() => null);
        btn.disabled = false;
        (window as { turnstile?: { reset: () => void } }).turnstile?.reset();
        if (res?.ok) return void cargar();
        if (res?.status === 401 && ((await res.json().catch(() => ({}))) as { error?: string }).error === "codigo") {
          campoCodigo.hidden = false;
          errorLogin.textContent = "Escribe el código de 6 dígitos de tu app";
          return;
        }
        login.querySelector<HTMLInputElement>("[name=clave]")!.value = "";
        login.querySelector<HTMLInputElement>("[name=codigo]")!.value = "";
        errorLogin.textContent =
          res?.status === 429
            ? "Demasiados intentos. Espera unos minutos antes de volver a probar"
            : res?.status === 403
              ? "No se pudo verificar que eres una persona, recarga la página"
              : res?.status === 503
                ? "El panel no está configurado"
                : "Contraseña incorrecta";
      });

      $("[data-salir]").addEventListener("click", async () => {
        await api("/api/admin/logout", { method: "POST" }).catch(() => null);
        mostrarLogin("Sesión cerrada");
      });

      bloqueo.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = new FormData(bloqueo);
        const desde = String(data.get("desde") ?? "");
        const hasta = String(data.get("hasta") ?? "");
        const res = await enviar({ accion: "bloquear", fecha: data.get("fecha"), ...(desde && hasta ? { desde, hasta } : {}) });
        estado.textContent = res.ok ? "Bloqueado" : "No se pudo guardar (revisa que «hasta» sea después de «desde»)";
        void cargar();
      });

      // Genera la línea del secreto ADMIN_USUARIOS en el navegador (PBKDF2-SHA256, 100.000 iteraciones, sal aleatoria).
      const crear = $<HTMLFormElement>("[data-crear]");
      crear.addEventListener("submit", async (e) => {
        e.preventDefault();
        const datos = new FormData(crear);
        const clave = String(datos.get("nueva") ?? "");
        const error = $("[data-crear-error]");
        if (clave.length < 12) return void (error.textContent = "Usa al menos 12 caracteres");
        if (clave !== String(datos.get("repetir") ?? "")) return void (error.textContent = "Las contraseñas no coinciden");
        error.textContent = "";
        const sal = crypto.getRandomValues(new Uint8Array(16));
        const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(clave), "PBKDF2", false, ["deriveBits"]);
        const bits = await crypto.subtle.deriveBits({ name: "PBKDF2", hash: "SHA-256", salt: sal, iterations: 100_000 }, key, 256);
        const b64 = (u: Uint8Array) => btoa(String.fromCharCode(...u));
        $<HTMLTextAreaElement>("[data-linea]").value = ["saltabum:pbkdf2", "100000", b64(sal), b64(new Uint8Array(bits))].join("$");
        crear.reset();
        crear.hidden = true;
        $("[data-resultado]").hidden = false;
      });
      $("[data-copiar]").addEventListener("click", async () => {
        const linea = $<HTMLTextAreaElement>("[data-linea]");
        linea.select();
        await navigator.clipboard?.writeText(linea.value).catch(() => document.execCommand("copy"));
        $("[data-copiar]").textContent = "Copiada";
      });

      void cargar();
    </script>
  </body>
</html>
