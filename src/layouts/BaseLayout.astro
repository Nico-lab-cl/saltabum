---
// Layout raíz: SEO, tracking, consentimiento y scripts de conversión.
// El diseño visual (header, footer, secciones) vive en src/design y se inserta vía <slot />.
import "@/styles/global.css";
import ChatIA from "@design/components/ChatIA.astro";
import CookieBanner from "@/components/core/CookieBanner.astro";
import SEO, { type SEOProps } from "@/components/core/SEO.astro";
import Tracking from "@/components/core/Tracking.astro";
import { SITE } from "@/config/site";

type Props = SEOProps;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Una sola dirección: http://… y www.… pasan a https://saltabum.cl (las páginas son estáticas y Cloudflare las
         entrega sin pasar por el Worker, así que se hace aquí; lo ideal es además «Always Use HTTPS» y una regla de
         redirección en Cloudflare). -->
    <script is:inline>
      if (/^(www\.)?saltabum\.cl$/.test(location.hostname) && (location.protocol === "http:" || location.hostname !== "saltabum.cl"))
        location.replace("https://saltabum.cl" + location.pathname + location.search + location.hash);
    </script>
    <!-- Verificación del dominio en Meta Business (portafolio Saltabum) -->
    <meta name="facebook-domain-verification" content="nl7nemsi54vr1uwin20089ymy3n2hl" />
    <!-- Íconos: monograma oficial (saltabum_logo/Favicon). ICO para navegadores antiguos y para Google, SVG para el resto. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <SEO {...Astro.props} />
    <Tracking />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <ChatIA />
    <CookieBanner />

    <script>
      import { captureAttribution } from "@/lib/client/attribution";
      import { bindChat } from "@/lib/client/chat";
      import { bindLeadForms } from "@/lib/client/lead-form";
      import { bindDeclarativeTracking } from "@/lib/client/track";

      captureAttribution();
      bindDeclarativeTracking();
      bindLeadForms();
      bindChat();
    </script>
  </body>
</html>
