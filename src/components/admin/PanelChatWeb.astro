---
// Pestaña «Chats» del panel /admin: las conversaciones del chat de saltabum.cl y los mensajes directos de Instagram y
// Facebook (atendidos por la misma IA, ver src/lib/server/redes.ts). A la izquierda la lista y a la
// derecha la conversación. «Tomar el control» hace que la IA deje de responder y el equipo conteste desde aquí
// (el cliente lo ve en la misma burbuja); «Devolver a la IA» la vuelve a activar. Se actualiza cada 5 segundos con
// una conversación abierta y cada 20 la lista. En las redes, con REDES_MODO=sugerencia, la IA deja una respuesta
// propuesta que el equipo envía tal cual, corrige o descarta. «Responder comentarios» prende o apaga a Sali en los
// comentarios de publicaciones y reels (ver src/lib/server/comentarios.ts).
---

<section data-chatweb-panel class="flex flex-col gap-4">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="font-display text-3xl font-semibold">Chats</h2>
      <p class="text-noche-suave text-sm">Chat de saltabum.cl y mensajes de Instagram y Facebook, con la IA o con el equipo</p>
    </div>
    <div role="radiogroup" aria-label="Qué conversaciones ver" class="border-noche bg-blanco flex max-w-full overflow-x-auto rounded-full border-2 p-1">
      {
        [
          ["todas", "Todas"],
          ["sugerencia", "Por aprobar"],
          ["ayuda", "Piden ayuda"],
          ["web", "Web"],
          ["instagram", "Instagram"],
          ["messenger", "Facebook"],
          ["humano", "Con el equipo"],
          ["reserva", "Con reserva"],
        ].map(([id, nombre], i) => (
          <button
            type="button"
            role="radio"
            aria-checked={i === 0 ? "true" : "false"}
            data-filtro-chatweb={id}
            class="aria-checked:bg-noche aria-checked:text-crema min-h-9 cursor-pointer rounded-full px-3 text-sm font-extrabold whitespace-nowrap"
          >
            {nombre}
          </button>
        ))
      }
    </div>
  </div>
  <label class="border-noche bg-blanco flex w-fit cursor-pointer items-center gap-3 rounded-2xl border-2 px-4 py-2.5">
    <input type="checkbox" data-chatweb-comentarios class="accent-verde size-5 cursor-pointer" />
    <span class="text-sm">
      <span class="font-extrabold">Responder comentarios</span>
      <span class="text-noche-suave block text-xs">Sali contesta «¡Te escribimos por interno! 📩» a los interesados en Instagram y Facebook y les escribe por privado</span>
    </span>
  </label>
  <p data-chatweb-estado class="text-noche-suave text-sm" aria-live="polite"></p>

  <div class="grid gap-4 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)]">
    <div data-chatweb-lista class="flex max-h-[75vh] flex-col gap-2 overflow-y-auto pr-1"></div>
    <div data-chatweb-chat class="border-noche bg-blanco flex min-h-[460px] flex-col rounded-2xl border-2">
      <p class="text-noche-suave m-auto p-6 text-center text-sm">Elige una conversación para verla</p>
    </div>
  </div>
</section>

<script>
  type Conversacion = {
    id: string;
    creado: string;
    actualizado: string;
    modo: "ia" | "humano";
    atiende: string | null;
    ayuda: number;
    nombre: string | null;
    telefono: string | null;
    email: string | null;
    reserva_id: number | null;
    pagina: string | null;
    mensajes: number;
    ultimo: string | null;
    canal: "web" | "instagram" | "messenger" | null;
    sugerencia: string | null;
  };
  const CANAL = { web: "Web", instagram: "Instagram", messenger: "Facebook" } as const;
  const canalDe = (c: Conversacion) => c.canal ?? "web";
  const esRed = (c: Conversacion) => canalDe(c) !== "web";
  type Mensaje = { id: number; rol: "cliente" | "ia" | "equipo" | "sistema"; texto: string; autor: string | null; creado: string };

  const root = document.querySelector<HTMLElement>("[data-chatweb-panel]")!;
  const lista = root.querySelector<HTMLElement>("[data-chatweb-lista]")!;
  const vista = root.querySelector<HTMLElement>("[data-chatweb-chat]")!;
  const estado = root.querySelector<HTMLElement>("[data-chatweb-estado]")!;
  const interruptor = root.querySelector<HTMLInputElement>("[data-chatweb-comentarios]")!;
  interruptor.addEventListener("change", async () => {
    interruptor.disabled = true;
    const activo = interruptor.checked;
    const res = await api("/api/admin/chatweb", { method: "POST", body: JSON.stringify({ accion: "comentarios", activo }) }).catch(() => null);
    interruptor.disabled = false;
    if (res?.status === 401) return sinSesion();
    if (!res?.ok) {
      interruptor.checked = !activo;
      return avisar("No se pudo cambiar la respuesta a comentarios");
    }
    avisar(activo ? "Sali responderá los comentarios" : "Sali ya no responde comentarios");
  });

  const hora = new Intl.DateTimeFormat("es-CL", { hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
  const dia = new Intl.DateTimeFormat("es-CL", { weekday: "short", day: "numeric", month: "short" });
  const cuando = (iso: string) => {
    const f = new Date(iso);
    return f.toDateString() === new Date().toDateString() ? hora.format(f) : `${dia.format(f)} ${hora.format(f)}`;
  };
  const QUIEN = { cliente: "Cliente", ia: "IA", equipo: "Equipo", sistema: "" } as const;

  let conversaciones: Conversacion[] = [];
  let filtro = "todas";
  let abierta: string | null = null;
  let pintada: string | null = null;
  let ultimoPintado = "";
  let activo = false;
  let visible = false;
  let conocidas: Map<string, string> | undefined;
  let modoRedes: "sugerencia" | "auto" = "sugerencia";

  const api = (ruta: string, init?: RequestInit) =>
    fetch(ruta, { ...init, credentials: "same-origin", headers: { "x-saltabum-admin": "1", "content-type": "application/json" } });
  const avisar = (texto: string) => document.dispatchEvent(new CustomEvent("panel:aviso", { detail: texto }));
  const sinSesion = () => document.dispatchEvent(new CustomEvent("panel:sin-sesion"));

  function el(tag: string, clase: string, texto?: string | null) {
    const e = document.createElement(tag);
    e.className = clase;
    if (texto) e.textContent = texto;
    return e;
  }
  function boton(texto: string, clase: string, accion: () => void) {
    const b = el("button", `min-h-9 cursor-pointer rounded-full border-2 px-3 text-sm font-extrabold disabled:opacity-50 ${clase}`, texto) as HTMLButtonElement;
    b.type = "button";
    b.addEventListener("click", accion);
    return b;
  }
  const etiqueta = (texto: string, clase: string) => el("span", `rounded-full border px-2 text-xs font-extrabold whitespace-nowrap ${clase}`, texto);

  async function cargarLista() {
    const res = await api("/api/admin/chatweb").catch(() => null);
    if (res?.status === 401) return sinSesion();
    if (!res?.ok) return void (estado.textContent = "No se pudieron cargar las conversaciones");
    const datos = (await res.json()) as { conversaciones: Conversacion[]; modoRedes?: "sugerencia" | "auto"; comentarios?: boolean };
    const nuevas = datos.conversaciones;
    if (typeof datos.comentarios === "boolean" && !interruptor.disabled) interruptor.checked = datos.comentarios;
    if (datos.modoRedes) modoRedes = datos.modoRedes;
    // Aviso cuando la IA pide ayuda en una conversación nueva para el panel.
    if (conocidas) {
      const piden = nuevas.filter((c) => c.ayuda && conocidas!.get(c.id) !== c.actualizado && c.id !== abierta);
      if (piden.length) avisar(`${CANAL[canalDe(piden[0])]}: ${piden[0].nombre ?? "un cliente"} necesita una persona`);
      const aprobar = nuevas.filter((c) => c.sugerencia && conocidas!.get(c.id) !== c.actualizado && c.id !== abierta);
      if (aprobar.length) avisar(`${CANAL[canalDe(aprobar[0])]}: respuesta de la IA lista para ${aprobar[0].nombre ?? "un cliente"}`);
    }
    conocidas = new Map(nuevas.map((c) => [c.id, c.actualizado]));
    conversaciones = nuevas;
    contar();
    pintarLista();
  }

  // El número de la pestaña son las conversaciones que piden ayuda o tienen una respuesta de la IA por aprobar.
  const contar = () =>
    document.dispatchEvent(
      new CustomEvent("panel:contador", { detail: { pestana: "chatweb", n: conversaciones.filter((c) => c.ayuda || c.sugerencia).length } }),
    );

  function pintarLista() {
    const visibles = conversaciones.filter((c) =>
      filtro === "ayuda"
        ? c.ayuda
        : filtro === "sugerencia"
          ? c.sugerencia
          : filtro === "humano"
            ? c.modo === "humano"
            : filtro === "reserva"
              ? c.reserva_id
              : filtro === "web" || filtro === "instagram" || filtro === "messenger"
                ? canalDe(c) === filtro
                : true,
    );
    lista.replaceChildren(
      ...visibles.map((c) => {
        const b = el(
          "button",
          `border-noche flex w-full cursor-pointer flex-col gap-1 rounded-2xl border-2 p-3 text-left ${c.id === abierta ? "bg-sol/40" : "bg-blanco"}`,
        ) as HTMLButtonElement;
        b.type = "button";
        const fila = el("div", "flex items-center justify-between gap-2");
        fila.append(el("p", "truncate font-extrabold", c.nombre ?? "Visitante"), el("span", "text-noche-suave shrink-0 text-xs", cuando(c.actualizado)));
        const marcas = el("div", "flex flex-wrap gap-1");
        marcas.append(etiqueta(CANAL[canalDe(c)], esRed(c) ? "border-noche bg-celeste" : "border-noche/30 bg-blanco"));
        if (c.sugerencia) marcas.append(etiqueta("✨ Por aprobar", "border-noche bg-sol"));
        if (c.ayuda) marcas.append(etiqueta("Pide ayuda", "border-rojo-texto bg-rojo-suave text-rojo-texto"));
        marcas.append(c.modo === "humano" ? etiqueta(`Equipo${c.atiende ? ` · ${c.atiende}` : ""}`, "border-noche bg-celeste") : etiqueta("IA", "border-noche/30 bg-crema"));
        if (c.reserva_id) marcas.append(etiqueta("Reservó", "border-noche bg-verde"));
        b.append(fila, marcas);
        if (c.ultimo) b.append(el("p", "text-noche-suave line-clamp-2 text-sm", c.ultimo));
        b.addEventListener("click", () => void abrir(c.id));
        return b;
      }),
    );
    estado.textContent = visibles.length ? "" : "No hay conversaciones en esta vista";
  }

  async function abrir(id: string, forzar = true) {
    if (forzar) ultimoPintado = "";
    abierta = id;
    history.replaceState(null, "", `#chatweb=${id}`);
    const res = await api(`/api/admin/chatweb?id=${encodeURIComponent(id)}`).catch(() => null);
    if (res?.status === 401) return sinSesion();
    if (!res?.ok) return void avisar("No se pudo abrir la conversación");
    const respuesta = (await res.json()) as { conversacion: Conversacion; mensajes: Mensaje[]; modoRedes?: "sugerencia" | "auto" };
    const { conversacion, mensajes } = respuesta;
    if (respuesta.modoRedes) modoRedes = respuesta.modoRedes;
    // Abrirla cuenta como vista: deja de pedir ayuda y baja el número de la pestaña.
    const enLista = conversaciones.find((c) => c.id === id);
    if (conversacion.ayuda || enLista?.ayuda) {
      conversacion.ayuda = 0;
      if (enLista) enLista.ayuda = 0;
      contar();
      ultimoPintado = "";
      void api("/api/admin/chatweb", { method: "POST", body: JSON.stringify({ accion: "visto", id }) });
    }
    // Si no cambió nada, no se repinta (así no se borra lo que el equipo está escribiendo).
    const firma = `${conversacion.modo}|${conversacion.atiende}|${mensajes.at(-1)?.id ?? 0}|${conversacion.sugerencia ?? ""}`;
    if (firma === ultimoPintado) return;
    ultimoPintado = firma;
    pintarConversacion(conversacion, mensajes);
    pintarLista();
  }

  const ERRORES: Record<string, string> = {
    ventana_24h: "Meta no deja responder: pasaron más de 24 horas desde su último mensaje. Escríbele por WhatsApp o desde la app",
    meta: "Meta no aceptó el mensaje, inténtalo de nuevo o responde desde la app",
    redes_sin_configurar: "Falta conectar Instagram y Facebook (token de la página)",
    ia: "La IA no pudo proponer una respuesta, inténtalo de nuevo",
  };
  async function enviar(datos: Record<string, unknown>, ok: string): Promise<boolean> {
    const res = await api("/api/admin/chatweb", { method: "POST", body: JSON.stringify(datos) }).catch(() => null);
    if (res?.status === 401) {
      sinSesion();
      return false;
    }
    const error = res && !res.ok ? ((await res.json().catch(() => ({}))) as { error?: string }).error : undefined;
    avisar(res?.ok ? ok : (error && ERRORES[error]) || "No se pudo guardar, inténtalo de nuevo");
    if (abierta) await abrir(abierta);
    void cargarLista();
    return !!res?.ok;
  }

  function pintarConversacion(c: Conversacion, mensajes: Mensaje[]) {
    // Lo que el equipo estaba escribiendo se mantiene al llegar mensajes nuevos.
    const previa = pintada === c.id ? vista.querySelector<HTMLTextAreaElement>("textarea") : null;
    const borrador = previa?.value ?? "";
    const enfocado = !!previa && document.activeElement === previa;
    pintada = c.id;
    const cabeza = el("div", "border-noche flex flex-wrap items-center justify-between gap-2 border-b-2 p-3");
    const datos = el("div", "flex min-w-0 flex-col");
    datos.append(el("p", "font-extrabold", c.nombre ?? (esRed(c) ? `Persona de ${CANAL[canalDe(c)]}` : "Visitante de la web")));
    const detalle = [esRed(c) ? `por ${CANAL[canalDe(c)]}` : "", c.telefono, c.email, c.reserva_id ? `reserva N° ${c.reserva_id}` : "", `desde ${cuando(c.creado)}`].filter(Boolean).join(" · ");
    datos.append(el("p", "text-noche-suave text-xs", detalle));
    const acciones = el("div", "flex flex-wrap gap-2");
    if (c.telefono) {
      const d = c.telefono.replace(/\D/g, "");
      const wa = el("a", "border-noche bg-verde inline-flex min-h-9 items-center rounded-full border-2 px-3 text-sm font-extrabold no-underline", "WhatsApp") as HTMLAnchorElement;
      wa.href = `https://wa.me/${d.length === 9 ? `56${d}` : d}`;
      wa.target = "_blank";
      wa.rel = "noopener";
      acciones.append(wa);
    }
    acciones.append(
      c.modo === "ia"
        ? boton("✋ Tomar el control", "border-noche bg-sol", () => void enviar({ accion: "modo", id: c.id, modo: "humano" }, "Tomaste el control: la IA ya no responde"))
        : boton("🤖 Devolver a la IA", "border-noche bg-crema", () => void enviar({ accion: "modo", id: c.id, modo: "ia" }, "La IA vuelve a responder")),
    );
    cabeza.append(datos, acciones);

    const caja = el("div", "flex max-h-[60vh] flex-1 flex-col gap-2 overflow-y-auto p-3");
    for (const m of mensajes) {
      if (m.rol === "sistema") {
        caja.append(el("p", "text-noche-suave self-center text-center text-xs font-bold", `${m.texto} · ${cuando(m.creado)}`));
        continue;
      }
      const propio = m.rol !== "cliente";
      const burbuja = el(
        "div",
        `max-w-[80%] rounded-2xl px-3 py-2 text-sm whitespace-pre-line ${propio ? "self-end rounded-br-md" : "self-start rounded-bl-md"} ${m.rol === "equipo" ? "bg-celeste" : m.rol === "ia" ? "bg-arena" : "bg-crema border-noche/20 border"}`,
      );
      burbuja.append(el("p", "", m.texto));
      burbuja.append(el("p", "text-noche-suave mt-1 text-[11px] font-bold", `${QUIEN[m.rol]}${m.autor && m.rol === "equipo" ? ` (${m.autor})` : ""} · ${cuando(m.creado)}`));
      caja.append(burbuja);
    }

    const form = el("form", "border-noche flex items-end gap-2 border-t-2 p-3") as HTMLFormElement;
    const area = el("textarea", "border-noche bg-crema max-h-40 min-h-11 flex-1 resize-y rounded-xl border-2 px-3 py-2") as HTMLTextAreaElement;

    // Redes: respuesta propuesta por la IA (enviar tal cual, corregirla o descartarla) o botón para pedir una.
    let propuesta: HTMLElement | null = null;
    if (esRed(c) && c.sugerencia) {
      const sug = c.sugerencia;
      propuesta = el("div", "border-noche bg-sol/30 flex flex-col gap-2 border-t-2 p-3");
      propuesta.append(el("p", "text-xs font-extrabold", "✨ Respuesta propuesta por la IA (aún no se envía)"));
      propuesta.append(el("p", "text-sm whitespace-pre-line", sug));
      const botones = el("div", "flex flex-wrap gap-2");
      const enviarla = boton("Enviar tal cual", "border-noche bg-verde", async () => {
        enviarla.disabled = true;
        await enviar({ accion: "responder", id: c.id, texto: sug }, `Enviada por ${CANAL[canalDe(c)]}`);
      });
      botones.append(
        enviarla,
        boton("Corregir", "border-noche bg-blanco", () => {
          area.value = sug;
          area.focus();
        }),
        boton("Descartar", "border-noche/40 bg-crema", () => void enviar({ accion: "descartar", id: c.id }, "Sugerencia descartada")),
      );
      propuesta.append(botones);
    } else if (esRed(c) && mensajes.filter((m) => m.rol !== "sistema").at(-1)?.rol === "cliente") {
      propuesta = el("div", "border-noche flex justify-end border-t-2 p-3");
      const pedir = boton("✨ Pedir respuesta a la IA", "border-noche bg-sol", async () => {
        pedir.disabled = true;
        pedir.textContent = "Pensando…";
        await enviar({ accion: "sugerir", id: c.id }, "La IA propuso una respuesta");
      });
      propuesta.append(pedir);
    }
    area.rows = 2;
    area.maxLength = 2000;
    area.placeholder = esRed(c)
      ? `Escribe tu respuesta (se envía por ${CANAL[canalDe(c)]}${c.modo === "ia" && modoRedes === "auto" ? ", la IA deja de responder" : ""})`
      : c.modo === "ia"
        ? "Escribe para responder tú (la IA deja de responder)"
        : "Escribe tu respuesta…";
    const mandar = el("button", "bg-noche text-crema min-h-11 cursor-pointer rounded-full px-5 font-extrabold disabled:opacity-50", "Enviar") as HTMLButtonElement;
    area.value = borrador;
    form.append(area, mandar);
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const texto = area.value.trim();
      if (!texto) return;
      mandar.disabled = true;
      area.value = "";
      const ok = await enviar({ accion: "responder", id: c.id, texto }, esRed(c) ? `Enviada por ${CANAL[canalDe(c)]}` : "Respuesta enviada al chat");
      // Si Meta lo rechazó, se devuelve el texto para no perderlo.
      if (!ok) {
        const nueva = vista.querySelector<HTMLTextAreaElement>("textarea");
        if (nueva && !nueva.value) nueva.value = texto;
      }
    });
    area.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    vista.replaceChildren(...[cabeza, caja, propuesta, form].filter((x): x is HTMLElement => !!x));
    caja.scrollTop = caja.scrollHeight;
    if (enfocado) area.focus();
  }

  root.querySelectorAll<HTMLButtonElement>("[data-filtro-chatweb]").forEach((b) =>
    b.addEventListener("click", () => {
      filtro = b.dataset.filtroChatweb!;
      root.querySelectorAll("[data-filtro-chatweb]").forEach((x) => x.setAttribute("aria-checked", String(x === b)));
      pintarLista();
    }),
  );

  document.addEventListener("panel:listo", () => {
    activo = true;
    void cargarLista();
    // Enlace directo desde el aviso de WhatsApp: /admin#chatweb=<id>
    const enlace = location.hash.match(/^#chatweb=([0-9a-f-]{36})$/);
    if (enlace) {
      document.dispatchEvent(new CustomEvent("panel:abrir-pestana", { detail: "chatweb" }));
      void abrir(enlace[1]);
    }
  });
  document.addEventListener("panel:pestana", (e) => {
    visible = (e as CustomEvent<string>).detail === "chatweb";
    if (activo && visible) void cargarLista();
  });
  // Desde la ficha de un contacto: abre esa conversación en esta pestaña.
  document.addEventListener("panel:abrir-chatweb", (e) => {
    document.dispatchEvent(new CustomEvent("panel:abrir-pestana", { detail: "chatweb" }));
    void abrir((e as CustomEvent<string>).detail);
  });
  setInterval(() => {
    if (activo && visible && abierta && document.visibilityState === "visible") void abrir(abierta, false);
  }, 5_000);
  setInterval(() => {
    if (activo && document.visibilityState === "visible") void cargarLista();
  }, 20_000);
  document.addEventListener("panel:cerrado", () => {
    activo = false;
    conversaciones = [];
    conocidas = undefined;
    abierta = null;
    pintada = null;
    lista.replaceChildren();
  });
</script>
