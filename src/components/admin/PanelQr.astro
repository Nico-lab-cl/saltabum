---
// Sección «Escaneos de códigos QR» del panel /admin: mapa, escaneos por día y por hora, rankings y la lista de
// cada escaneo. Se carga cuando el panel avisa que hay sesión (evento «panel:listo») y agrupa los datos en el
// navegador a partir de GET /api/admin/qr.
const tarjeta = "border-noche bg-blanco rounded-[20px] border-2 p-5";
const RANKINGS = [
  ["ciudad", "Ciudades"],
  ["equipo", "Celulares"],
  ["so", "Sistema"],
  ["navegador", "Navegador"],
  ["operador", "Compañía de internet"],
  ["codigo", "Campañas"],
] as const;
---

<section data-qr-panel hidden class="flex flex-col gap-5">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 class="font-display text-3xl font-semibold">Escaneos de códigos QR</h2>
    <div class="flex flex-wrap items-end gap-3">
      <label class="flex flex-col gap-1 text-sm font-bold">
        Campaña
        <select data-qr-campana class="border-noche min-h-11 rounded-xl border-2 px-3">
          <option value="">Todas</option>
        </select>
      </label>
      <label class="flex flex-col gap-1 text-sm font-bold">
        Período
        <select data-qr-dias class="border-noche min-h-11 rounded-xl border-2 px-3">
          <option value="7">Últimos 7 días</option>
          <option value="30" selected>Últimos 30 días</option>
          <option value="90">Últimos 90 días</option>
          <option value="365">Último año</option>
        </select>
      </label>
      <button data-qr-csv type="button" class="border-noche min-h-11 cursor-pointer rounded-full border-2 px-5 font-extrabold">
        Descargar CSV
      </button>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
    {
      [
        ["escaneos", "Escaneos"],
        ["personas", "Personas distintas"],
        ["hoy", "Hoy"],
        ["ciudades", "Ciudades"],
      ].map(([clave, titulo]) => (
        <div class={tarjeta}>
          <p class="text-noche-suave text-sm font-bold">{titulo}</p>
          <p class="font-display text-4xl font-semibold" data-qr-kpi={clave}>0</p>
        </div>
      ))
    }
  </div>

  <div class={`${tarjeta} flex flex-col gap-3`}>
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="font-display text-xl font-semibold">Dónde escanearon</h3>
      <p class="text-noche-suave text-xs">Ubicación aproximada según la conexión (ciudad), no el GPS del celular</p>
    </div>
    <div data-qr-mapa class="border-noche/20 h-[380px] overflow-hidden rounded-xl border"></div>
  </div>

  <div class="grid gap-5 lg:grid-cols-2">
    <div class={`${tarjeta} flex flex-col gap-3`}>
      <h3 class="font-display text-xl font-semibold" data-qr-titulo-dias>Escaneos por día</h3>
      <div data-qr-dias-barras class="flex h-40 items-end gap-[2px]"></div>
      <div data-qr-dias-ejes class="text-noche-suave flex justify-between text-xs"></div>
    </div>
    <div class={`${tarjeta} flex flex-col gap-3`}>
      <h3 class="font-display text-xl font-semibold">A qué hora escanean</h3>
      <div data-qr-horas class="flex h-40 items-end gap-[2px]"></div>
      <div class="text-noche-suave flex justify-between text-xs"><span>00</span><span>06</span><span>12</span><span>18</span><span>23</span></div>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      RANKINGS.map(([clave, titulo]) => (
        <div class={`${tarjeta} flex flex-col gap-3`}>
          <h3 class="font-display text-xl font-semibold">{titulo}</h3>
          <ol data-qr-ranking={clave} class="flex flex-col gap-2 text-sm" />
        </div>
      ))
    }
  </div>

  <div class="flex flex-col gap-3">
    <h3 class="font-display text-xl font-semibold">Cada escaneo</h3>
    <div class="border-noche bg-blanco max-h-[520px] overflow-auto rounded-[20px] border-2">
      <table class="w-full text-left text-sm">
        <thead class="bg-arena sticky top-0">
          <tr>
            <th class="p-3">Fecha y hora</th><th class="p-3">Campaña</th><th class="p-3">Lugar</th><th class="p-3">Celular</th>
            <th class="p-3">Sistema</th><th class="p-3">Navegador</th><th class="p-3">Compañía</th><th class="p-3">Persona</th>
          </tr>
        </thead>
        <tbody data-qr-filas></tbody>
      </table>
    </div>
    <p class="text-noche-suave text-xs">
      Se cuentan todos los escaneos, aunque la persona no acepte cookies. No se guarda la IP. «Persona» es un código que
      agrupa los escaneos del mismo celular en un mismo día. El modelo del celular solo lo entregan los Android con
      Chrome; los iPhone no lo informan.
    </p>
  </div>
</section>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  type Escaneo = {
    id: number;
    codigo: string;
    ciudad: string | null;
    region: string | null;
    pais: string | null;
    lat: number | null;
    lon: number | null;
    operador: string | null;
    dispositivo: string;
    so: string | null;
    modelo: string | null;
    navegador: string | null;
    idioma: string | null;
    visitante: string | null;
    creado: string;
  };

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const seccion = $("[data-qr-panel]");
  const selCampana = $<HTMLSelectElement>("[data-qr-campana]");
  const selDias = $<HTMLSelectElement>("[data-qr-dias]");
  const ZONA = "America/Santiago";
  const diaChile = (iso: string) => new Date(iso).toLocaleDateString("en-CA", { timeZone: ZONA });
  const horaChile = (iso: string) => Number(new Date(iso).toLocaleString("en-US", { timeZone: ZONA, hour: "2-digit", hourCycle: "h23" }));
  const fechaHora = new Intl.DateTimeFormat("es-CL", { dateStyle: "medium", timeStyle: "short", timeZone: ZONA });

  let todos: Escaneo[] = [];
  let mapa: L.Map | undefined;
  let capa: L.LayerGroup | undefined;

  // Cloudflare entrega la razón social de la red: se muestra la marca que la gente conoce.
  const MARCAS: [RegExp, string][] = [
    [/entel/i, "Entel"],
    [/telefonica|movistar/i, "Movistar"],
    [/claro|telmex/i, "Claro"],
    [/wom|nextel/i, "WOM"],
    [/vtr/i, "VTR"],
    [/pacifico cable|mundo/i, "Mundo"],
    [/gtd|telsur/i, "GTD"],
  ];
  const compania = (e: Escaneo) => (e.operador ? (MARCAS.find(([re]) => re.test(e.operador!))?.[1] ?? e.operador) : "Sin dato");
  const lugar = (e: Escaneo) => [e.ciudad, e.region].filter(Boolean).join(", ") || "Sin dato";
  const equipo = (e: Escaneo) =>
    e.modelo || (e.dispositivo === "ios" ? "iPhone" : e.dispositivo === "android" ? "Android (sin modelo)" : e.dispositivo === "ipad" ? "iPad" : "Computador u otro");
  const valor: Record<string, (e: Escaneo) => string> = {
    ciudad: (e) => e.ciudad || "Sin dato",
    equipo,
    so: (e) => e.so || "Sin dato",
    navegador: (e) => e.navegador || "Sin dato",
    operador: compania,
    codigo: (e) => e.codigo,
  };

  function contar<T>(lista: T[], clave: (x: T) => string) {
    const m = new Map<string, number>();
    for (const x of lista) m.set(clave(x), (m.get(clave(x)) ?? 0) + 1);
    return [...m].sort((a, b) => b[1] - a[1]);
  }

  /** Barras verticales de una sola serie; el valor y la etiqueta salen en el tooltip nativo. */
  function barras(caja: HTMLElement, datos: [string, number][]) {
    const max = Math.max(1, ...datos.map(([, n]) => n));
    caja.replaceChildren(
      ...datos.map(([etiqueta, n]) => {
        const col = document.createElement("div");
        col.className = "group relative flex h-full flex-1 items-end";
        col.title = `${etiqueta}: ${n} ${n === 1 ? "escaneo" : "escaneos"}`;
        const barra = document.createElement("div");
        barra.className = "bg-azul-texto group-hover:bg-noche w-full rounded-t-[4px]";
        barra.style.height = n ? `${Math.max(4, (n / max) * 100)}%` : "0";
        col.append(barra);
        return col;
      }),
    );
  }

  function ranking(lista: HTMLElement, datos: [string, number][], total: number) {
    if (!datos.length) return lista.replaceChildren(Object.assign(document.createElement("li"), { textContent: "Sin escaneos", className: "text-noche-suave" }));
    lista.replaceChildren(
      ...datos.slice(0, 8).map(([nombre, n]) => {
        const li = document.createElement("li");
        li.className = "flex flex-col gap-1";
        const fila = document.createElement("div");
        fila.className = "flex justify-between gap-3";
        fila.append(Object.assign(document.createElement("span"), { textContent: nombre, className: "truncate font-bold" }));
        fila.append(Object.assign(document.createElement("span"), { textContent: `${n} · ${Math.round((n / total) * 100)} %`, className: "text-noche-suave shrink-0" }));
        const pista = document.createElement("div");
        pista.className = "bg-arena h-2 rounded-full";
        const relleno = document.createElement("div");
        relleno.className = "bg-azul-texto h-2 rounded-full";
        relleno.style.width = `${(n / datos[0][1]) * 100}%`;
        pista.append(relleno);
        li.append(fila, pista);
        return li;
      }),
    );
  }

  function dibujarMapa(lista: Escaneo[]) {
    if (!mapa) {
      mapa = L.map($("[data-qr-mapa]"), { scrollWheelZoom: false }).setView([-33.05, -71.5], 9);
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 18,
        // El panel no manda referer (no-referrer), pero el servidor de mapas lo exige: solo el dominio, sin la ruta.
        referrerPolicy: "strict-origin",
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(mapa);
      capa = L.layerGroup().addTo(mapa);
    }
    capa!.clearLayers();
    const puntos = new Map<string, { lat: number; lon: number; lugar: string; n: number }>();
    for (const e of lista) {
      if (e.lat == null || e.lon == null) continue;
      const k = `${e.lat.toFixed(2)},${e.lon.toFixed(2)}`;
      const p = puntos.get(k) ?? { lat: e.lat, lon: e.lon, lugar: lugar(e), n: 0 };
      p.n++;
      puntos.set(k, p);
    }
    const max = Math.max(1, ...[...puntos.values()].map((p) => p.n));
    for (const p of puntos.values()) {
      L.circleMarker([p.lat, p.lon], {
        radius: 7 + Math.sqrt(p.n / max) * 13,
        color: "#ffffff",
        weight: 2,
        fillColor: "#c9361a",
        fillOpacity: 0.75,
      })
        .bindTooltip(`<strong>${p.lugar.replace(/</g, "&lt;")}</strong><br>${p.n} ${p.n === 1 ? "escaneo" : "escaneos"}`)
        .addTo(capa!);
    }
    if (puntos.size) mapa.fitBounds(L.latLngBounds([...puntos.values()].map((p) => [p.lat, p.lon])).pad(0.4), { maxZoom: 11 });
    // El mapa se crea con la sección oculta: hay que recalcular su tamaño al mostrarla.
    setTimeout(() => mapa!.invalidateSize(), 50);
  }

  function celda(texto: string, clase = "") {
    const td = document.createElement("td");
    td.className = `p-3 ${clase}`;
    td.textContent = texto;
    return td;
  }

  function filtrados() {
    return selCampana.value ? todos.filter((e) => e.codigo === selCampana.value) : todos;
  }

  function dibujar() {
    const lista = filtrados();
    const dias = Number(selDias.value);
    const hoy = diaChile(new Date().toISOString());

    $("[data-qr-kpi=escaneos]").textContent = String(lista.length);
    $("[data-qr-kpi=personas]").textContent = String(new Set(lista.map((e) => e.visitante ?? `id${e.id}`)).size);
    $("[data-qr-kpi=hoy]").textContent = String(lista.filter((e) => diaChile(e.creado) === hoy).length);
    $("[data-qr-kpi=ciudades]").textContent = String(new Set(lista.map((e) => e.ciudad).filter(Boolean)).size);

    // Por día (o por mes en el último año), con los días sin escaneos en cero.
    const porMes = dias > 90;
    $("[data-qr-titulo-dias]").textContent = porMes ? "Escaneos por mes" : "Escaneos por día";
    const cuenta = new Map(contar(lista, (e) => (porMes ? diaChile(e.creado).slice(0, 7) : diaChile(e.creado))));
    const serie: [string, number][] = [];
    const etiqueta = (k: string) =>
      new Date(`${porMes ? `${k}-01` : k}T12:00:00Z`).toLocaleDateString("es-CL", porMes ? { month: "short", year: "2-digit", timeZone: "UTC" } : { day: "numeric", month: "short", timeZone: "UTC" });
    if (porMes) {
      const d = new Date();
      for (let i = 11; i >= 0; i--) {
        const k = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() - i, 1)).toISOString().slice(0, 7);
        serie.push([etiqueta(k), cuenta.get(k) ?? 0]);
      }
    } else {
      for (let i = dias - 1; i >= 0; i--) {
        const k = diaChile(new Date(Date.now() - i * 864e5).toISOString());
        serie.push([etiqueta(k), cuenta.get(k) ?? 0]);
      }
    }
    barras($("[data-qr-dias-barras]"), serie);
    $("[data-qr-dias-ejes]").replaceChildren(
      ...[serie[0], serie[Math.floor(serie.length / 2)], serie.at(-1)!].map(([t]) => Object.assign(document.createElement("span"), { textContent: t })),
    );

    const horas = Array.from({ length: 24 }, () => 0);
    for (const e of lista) horas[horaChile(e.creado)]++;
    barras($("[data-qr-horas]"), horas.map((n, h) => [`${String(h).padStart(2, "0")}:00 a ${String(h).padStart(2, "0")}:59`, n]));

    for (const clave of Object.keys(valor)) ranking($(`[data-qr-ranking=${clave}]`), contar(lista, valor[clave]), lista.length);

    dibujarMapa(lista);

    $("[data-qr-filas]").replaceChildren(
      ...(lista.length
        ? lista.slice(0, 300).map((e) => {
            const tr = document.createElement("tr");
            tr.className = "border-noche/10 border-t";
            tr.append(
              celda(fechaHora.format(new Date(e.creado)), "whitespace-nowrap"),
              celda(e.codigo),
              celda(lugar(e)),
              celda(equipo(e)),
              celda(e.so ?? ""),
              celda(e.navegador ?? ""),
              celda(e.operador ? compania(e) : ""),
              celda(e.visitante?.slice(0, 6) ?? "", "font-mono text-xs"),
            );
            return tr;
          })
        : [Object.assign(document.createElement("tr"), { innerHTML: '<td class="p-3" colspan="8">Todavía no hay escaneos en este período</td>' })]),
    );
  }

  async function cargar() {
    const res = await fetch(`/api/admin/qr?dias=${selDias.value}`, { credentials: "same-origin", headers: { "x-saltabum-admin": "1" } });
    if (!res.ok) return;
    todos = ((await res.json()) as { escaneos: Escaneo[] }).escaneos;
    const elegida = selCampana.value;
    const campanas = [...new Set(todos.map((e) => e.codigo))].sort();
    selCampana.replaceChildren(new Option("Todas", ""), ...campanas.map((c) => new Option(c, c, false, c === elegida)));
    seccion.hidden = false;
    dibujar();
  }

  selDias.addEventListener("change", () => void cargar());
  selCampana.addEventListener("change", dibujar);

  $("[data-qr-csv]").addEventListener("click", () => {
    const cols = ["creado", "codigo", "ciudad", "region", "pais", "lat", "lon", "operador", "dispositivo", "so", "modelo", "navegador", "idioma", "visitante"] as const;
    const esc = (v: unknown) => `"${String(v ?? "").replace(/"/g, '""')}"`;
    const csv = [cols.join(","), ...filtrados().map((e) => cols.map((c) => esc(c === "creado" ? fechaHora.format(new Date(e.creado)) : e[c])).join(","))].join("\n");
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8" }));
    a.download = `escaneos-qr-saltabum-${diaChile(new Date().toISOString())}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  document.addEventListener("panel:listo", () => void cargar());
  document.addEventListener("panel:cerrado", () => {
    seccion.hidden = true;
    todos = [];
  });
</script>
