---
// Pestaña «Contactos» del panel /admin (CRM): una ficha por persona que une WhatsApp, chat de la web, consultas y
// reservas, con su etapa (Lead → Calificado → Cotizado → Reservado → Cliente → Promotor), si está perdida y por qué,
// desde dónde llegó y su línea de tiempo. «Por atender» son las personas que esperan respuesta del equipo, la que
// lleva más tiempo esperando primero. Se actualiza cada 30 segundos.
const campo = "border-noche bg-blanco min-h-11 rounded-xl border-2 px-3";
---

<section data-crm-panel class="flex flex-col gap-4">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="font-display text-3xl font-semibold">Contactos</h2>
      <p class="text-noche-suave text-sm">
        Cada persona con su etapa, desde dónde llegó y si espera respuesta
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <div role="radiogroup" aria-label="Vista" class="border-noche bg-blanco flex rounded-full border-2 p-1">
        {[
          ["lista", "Lista"],
          ["tablero", "Tablero"],
          ["tareas", "Tareas"],
        ].map(([id, nombre], i) => (
          <button
            type="button"
            role="radio"
            aria-checked={i === 0 ? "true" : "false"}
            data-crm-vista={id}
            class="aria-checked:bg-noche aria-checked:text-crema min-h-9 cursor-pointer rounded-full px-4 text-sm font-extrabold"
          >
            {nombre}
          </button>
        ))}
      </div>
      <input
        data-crm-buscar
        type="search"
        placeholder="Buscar nombre, teléfono, comuna…"
        class={`${campo} w-full sm:w-[260px]`}
      />
      <button
        data-crm-actualizar
        type="button"
        class="border-noche bg-blanco min-h-11 cursor-pointer rounded-full border-2 px-4 text-sm font-extrabold"
      >
        ↻ Actualizar
      </button>
    </div>
  </div>

  <div data-crm-en-lista class="flex flex-col gap-4">
    <div data-crm-filtros role="radiogroup" aria-label="Qué contactos ver" class="flex flex-wrap gap-2"></div>
    <p data-crm-estado class="text-noche-suave text-sm" aria-live="polite"></p>

    <div class="grid gap-4 lg:grid-cols-[minmax(0,360px)_minmax(0,1fr)]">
      <div data-crm-lista class="flex max-h-[75vh] flex-col gap-2 overflow-y-auto pr-1"></div>
      <div data-crm-ficha class="border-noche bg-blanco flex min-h-[420px] flex-col rounded-2xl border-2">
        <p class="text-noche-suave m-auto p-6 text-center text-sm">Elige un contacto para ver su ficha</p>
      </div>
    </div>
  </div>

  <!-- Pipeline de negocios: una tarjeta por oportunidad abierta, se arrastra entre columnas (o «Mover a…») -->
  <div data-crm-en-tablero hidden class="flex flex-col gap-2">
    <p class="text-noche-suave text-sm">
      Arrastra una tarjeta a otra columna o usa «Mover a…». Ganado y Perdido muestran los últimos 30 días
    </p>
    <div data-crm-tablero class="flex gap-3 overflow-x-auto pb-2"></div>
  </div>

  <!-- Tareas de seguimiento: automáticas (según la situación de cada contacto) y anotadas por el equipo -->
  <div data-crm-en-tareas hidden class="flex flex-col gap-3">
    <p class="text-noche-suave text-sm">
      Seguimientos que tocan hoy, con un mensaje sugerido que puedes editar antes de enviar. Las automáticas
      desaparecen solas si la persona responde
    </p>
    <div data-crm-tareas class="flex flex-col gap-4"></div>
  </div>

  <dialog
    data-crm-motivo
    class="border-noche bg-blanco m-auto w-[min(420px,calc(100%-32px))] rounded-2xl border-2 p-5 backdrop:bg-black/40"
  >
    <form method="dialog" class="flex flex-col gap-3">
      <p class="font-display text-xl font-semibold">¿Por qué se perdió?</p>
      <p data-crm-motivo-quien class="text-noche-suave text-sm"></p>
      <select name="motivo" required class={campo}></select>
      <p data-crm-motivo-aviso hidden class="bg-sol/40 rounded-xl px-3 py-2 text-sm font-bold">
        Tiene una reserva sin pagar. Después de marcarlo, libera esa fecha en Reservas
      </p>
      <div class="flex justify-end gap-2">
        <button
          value=""
          class="border-noche min-h-11 cursor-pointer rounded-full border-2 px-4 font-extrabold"
        >
          Cancelar
        </button>
        <button
          value="ok"
          class="bg-noche text-crema min-h-11 cursor-pointer rounded-full px-5 font-extrabold"
        >
          Marcar perdido
        </button>
      </div>
    </form>
  </dialog>
</section>

<script>
  type Etapa = "lead" | "calificado" | "cotizado" | "reservado" | "cliente" | "promotor";
  type Motivo =
    | "no_respondio"
    | "sin_disponibilidad"
    | "fuera_de_zona"
    | "presupuesto"
    | "otra_empresa"
    | "cancelo"
    | "spam";
  type Reserva = {
    id: number;
    fecha: string;
    producto: string;
    total: number | null;
    pagado: number | null;
    pagado_en: string | null;
    creado: string;
    origen: string | null;
  };
  type Contacto = {
    clave: string;
    nombre: string | null;
    telefono: string | null;
    email: string | null;
    comuna: string | null;
    etapa: Etapa;
    etapa_auto: Etapa;
    perdido: { motivo: Motivo; etapa: Etapa; en: string; por: string | null } | null;
    reactivado: boolean;
    esperando: string | null;
    espera_en: "whatsapp" | "chatweb" | "consulta" | null;
    origen: string;
    creado: string;
    ultimo: string;
    notas: string | null;
    whatsapp: { jid: string; anuncio: number; titulo: string | null } | null;
    chats: string[];
    consultas: number[];
    reservas: Reserva[];
    festejado: { nombre: string | null; cumple: string | null };
    resena: string | null;
    encuestas: { reserva: number; nota: number; comentario: string | null; en: string }[];
  };
  type Tarea = {
    id: string;
    tipo:
      | "seguimiento"
      | "ultimo_intento"
      | "cerrar"
      | "abono"
      | "logistica"
      | "encuesta"
      | "resena"
      | "recuperar"
      | "cumple"
      | "manual";
    clave: string;
    nombre: string;
    titulo: string;
    motivo: string;
    vence: string;
    mensaje: string | null;
    jid: string | null;
    telefono: string | null;
    reserva?: number;
  };
  type Evento = {
    en: string;
    tipo: "whatsapp" | "chatweb" | "consulta" | "reserva" | "pago" | "cotizacion" | "encuesta" | "equipo";
    texto: string;
  };

  const ETAPAS: { id: Etapa; nombre: string; clase: string }[] = [
    { id: "lead", nombre: "Lead", clase: "bg-crema" },
    { id: "calificado", nombre: "Calificado", clase: "bg-celeste" },
    { id: "cotizado", nombre: "Cotizado", clase: "bg-sol" },
    { id: "reservado", nombre: "Reservado", clase: "bg-verde-burbuja" },
    { id: "cliente", nombre: "Cliente", clase: "bg-verde" },
    { id: "promotor", nombre: "Promotor", clase: "bg-verde" },
  ];
  const MOTIVOS: Record<Motivo, string> = {
    no_respondio: "No respondió",
    sin_disponibilidad: "Sin disponibilidad para su fecha",
    fuera_de_zona: "Fuera de la zona de despacho",
    presupuesto: "Presupuesto",
    otra_empresa: "Eligió otra empresa",
    cancelo: "Canceló la reserva",
    spam: "Spam o número equivocado",
  };
  const MANUALES: Etapa[] = ["calificado", "cotizado", "promotor"];
  const ESPERA_EN = { whatsapp: "WhatsApp", chatweb: "chat web", consulta: "formulario" } as const;
  const ICONO: Record<Evento["tipo"], string> = {
    whatsapp: "💬",
    chatweb: "🤖",
    consulta: "📝",
    reserva: "📅",
    pago: "💰",
    cotizacion: "🧾",
    encuesta: "⭐",
    equipo: "👤",
  };
  /** Minutos de espera antes de marcar en rojo (los cuadernos de ventas hablan de 5 a 15). */
  const LIMITE_ESPERA = 15;

  const root = document.querySelector<HTMLElement>("[data-crm-panel]")!;
  const lista = root.querySelector<HTMLElement>("[data-crm-lista]")!;
  const ficha = root.querySelector<HTMLElement>("[data-crm-ficha]")!;
  const estado = root.querySelector<HTMLElement>("[data-crm-estado]")!;
  const filtros = root.querySelector<HTMLElement>("[data-crm-filtros]")!;
  const buscar = root.querySelector<HTMLInputElement>("[data-crm-buscar]")!;

  const hora = new Intl.DateTimeFormat("es-CL", { hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
  const dia = new Intl.DateTimeFormat("es-CL", { weekday: "short", day: "numeric", month: "short" });
  const diaEvento = new Intl.DateTimeFormat("es-CL", {
    weekday: "short",
    day: "numeric",
    month: "short",
    timeZone: "UTC",
  });
  const cuando = (iso: string) => {
    const f = new Date(iso);
    return f.toDateString() === new Date().toDateString()
      ? hora.format(f)
      : `${dia.format(f)} ${hora.format(f)}`;
  };
  const hace = (iso: string) => {
    const min = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60_000));
    if (min < 60) return `${min} min`;
    if (min < 48 * 60) return `${Math.round(min / 60)} h`;
    return `${Math.round(min / 1440)} días`;
  };
  const sinTildes = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  const nombreDe = (c: Contacto) => c.nombre ?? (c.telefono ? `+${c.telefono}` : (c.email ?? "Sin nombre"));
  const etapaDe = (id: Etapa) => ETAPAS.find((e) => e.id === id)!;

  let contactos: Contacto[] = [];
  let tareas: Tarea[] = [];
  let filtro = "atender";
  let abierto: string | null = null;
  let activo = false;

  const api = (ruta: string, init?: RequestInit) =>
    fetch(ruta, {
      ...init,
      credentials: "same-origin",
      headers: { "x-saltabum-admin": "1", "content-type": "application/json" },
    });
  const avisar = (texto: string) => document.dispatchEvent(new CustomEvent("panel:aviso", { detail: texto }));
  const sinSesion = () => document.dispatchEvent(new CustomEvent("panel:sin-sesion"));

  function el(tag: string, clase: string, texto?: string | null) {
    const e = document.createElement(tag);
    e.className = clase;
    if (texto) e.textContent = texto;
    return e;
  }
  function boton(texto: string, clase: string, accion: () => void) {
    const b = el(
      "button",
      `min-h-9 cursor-pointer rounded-full border-2 px-3 text-sm font-extrabold disabled:opacity-50 ${clase}`,
      texto,
    ) as HTMLButtonElement;
    b.type = "button";
    b.addEventListener("click", accion);
    return b;
  }
  const chip = (texto: string, clase: string) =>
    el("span", `rounded-full border px-2 text-xs font-extrabold whitespace-nowrap ${clase}`, texto);
  const chipEtapa = (c: Contacto) =>
    c.perdido
      ? chip(`Perdido · ${MOTIVOS[c.perdido.motivo]}`, "border-noche/40 bg-arena")
      : chip(etapaDe(c.etapa).nombre, `border-noche ${etapaDe(c.etapa).clase}`);

  // ── Filtros ───────────────────────────────────────────────────────────
  const FILTROS: { id: string; nombre: string; cumple: (c: Contacto) => boolean }[] = [
    { id: "atender", nombre: "Por atender", cumple: (c) => !!c.esperando },
    ...ETAPAS.map((e) => ({
      id: e.id,
      nombre: e.nombre,
      cumple: (c: Contacto) => !c.perdido && c.etapa === e.id,
    })),
    { id: "perdido", nombre: "Perdidos", cumple: (c) => !!c.perdido },
    { id: "todos", nombre: "Todos", cumple: () => true },
  ];

  function pintarFiltros() {
    filtros.replaceChildren(
      ...FILTROS.map((f) => {
        const n = contactos.filter(f.cumple).length;
        const b = boton(
          `${f.nombre} ${n}`,
          `${f.id === filtro ? "border-noche bg-noche text-crema" : f.id === "atender" && n ? "border-rojo-texto bg-rojo-suave text-rojo-texto" : "border-noche bg-blanco"}`,
          () => {
            filtro = f.id;
            pintarFiltros();
            pintarLista();
          },
        );
        b.setAttribute("role", "radio");
        b.setAttribute("aria-checked", String(f.id === filtro));
        return b;
      }),
    );
  }

  async function cargar() {
    const [res, resTareas] = await Promise.all([
      api("/api/admin/contactos").catch(() => null),
      api("/api/admin/contactos?tareas=1").catch(() => null),
    ]);
    if (res?.status === 401) return sinSesion();
    if (!res?.ok) return void (estado.textContent = "No se pudieron cargar los contactos");
    contactos = ((await res.json()) as { contactos: Contacto[] }).contactos;
    if (resTareas?.ok) tareas = ((await resTareas.json()) as { tareas: Tarea[] }).tareas;
    pintarBotonTareas();
    document.dispatchEvent(
      new CustomEvent("panel:contador", {
        detail: { pestana: "contactos", n: contactos.filter((c) => c.esperando).length },
      }),
    );
    pintarFiltros();
    pintarLista();
    if (vista === "tablero") pintarTablero();
    if (vista === "tareas") pintarTareas();
  }

  function pintarLista() {
    const f = FILTROS.find((x) => x.id === filtro)!;
    const q = sinTildes(buscar.value.trim());
    const visibles = contactos
      .filter(
        (c) =>
          f.cumple(c) &&
          (!q ||
            sinTildes(
              [c.nombre, c.telefono, c.email, c.comuna, c.origen, c.notas].filter(Boolean).join(" "),
            ).includes(q)),
      )
      // En «Por atender», la persona que lleva más tiempo esperando va primero.
      .sort((a, b) => (filtro === "atender" ? a.esperando!.localeCompare(b.esperando!) : 0));
    lista.replaceChildren(...visibles.slice(0, 300).map(fila));
    estado.textContent = visibles.length
      ? visibles.length > 300
        ? `Se muestran 300 de ${visibles.length}, usa el buscador`
        : ""
      : filtro === "atender"
        ? "Nadie espera respuesta 🎉"
        : "No hay contactos en esta vista";
  }

  function fila(c: Contacto): HTMLElement {
    const atrasado = c.esperando && Date.now() - Date.parse(c.esperando) > LIMITE_ESPERA * 60_000;
    const b = el(
      "button",
      `flex w-full cursor-pointer flex-col gap-1 rounded-2xl border-2 p-3 text-left ${c.clave === abierto ? "bg-sol/40" : atrasado ? "bg-rojo-suave/50" : "bg-blanco"} ${atrasado ? "border-rojo-texto" : "border-noche"}`,
    ) as HTMLButtonElement;
    b.type = "button";
    const arriba = el("div", "flex items-center justify-between gap-2");
    arriba.append(
      el("span", "truncate font-extrabold", nombreDe(c)),
      el("span", "text-noche-suave shrink-0 text-xs font-semibold", cuando(c.ultimo)),
    );
    b.append(arriba);
    const chips = el("div", "flex flex-wrap items-center gap-1");
    chips.append(chipEtapa(c));
    if (c.reactivado) chips.append(chip("Volvió", "border-noche bg-celeste"));
    if (c.esperando)
      chips.append(
        chip(
          `Espera hace ${hace(c.esperando)} · ${ESPERA_EN[c.espera_en!]}`,
          atrasado ? "border-rojo-texto bg-rojo-texto text-white" : "border-noche bg-sol",
        ),
      );
    b.append(chips);
    b.append(el("p", "text-noche-suave truncate text-xs", [c.origen, c.comuna].filter(Boolean).join(" · ")));
    b.addEventListener("click", () => void abrir(c.clave, true));
    return b;
  }

  // ── Ficha ─────────────────────────────────────────────────────────────
  async function abrir(clave: string, desplazar: boolean) {
    abierto = clave;
    pintarLista();
    const res = await api(`/api/admin/contactos?clave=${encodeURIComponent(clave)}`).catch(() => null);
    if (res?.status === 401) return sinSesion();
    if (!res?.ok) return avisar("No se pudo abrir el contacto");
    const { contacto, eventos } = (await res.json()) as { contacto: Contacto; eventos: Evento[] };
    if (abierto !== clave) return;
    pintarFicha(contacto, eventos);
    if (desplazar && window.matchMedia("(max-width: 1023px)").matches)
      ficha.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  async function enviar(datos: Record<string, unknown>, ok: string) {
    const res = await api("/api/admin/contactos", { method: "POST", body: JSON.stringify(datos) }).catch(
      () => null,
    );
    if (res?.status === 401) return sinSesion();
    avisar(res?.ok ? ok : "No se pudo guardar, inténtalo de nuevo");
    await cargar();
    if (abierto) await abrir(abierto, false);
  }

  function pintarFicha(c: Contacto, eventos: Evento[]) {
    const cabeza = el("div", "border-noche flex flex-col gap-3 border-b-2 p-4");
    const fila1 = el("div", "flex flex-wrap items-start justify-between gap-2");
    const quien = el("div", "flex min-w-0 flex-col");
    quien.append(el("p", "font-display text-xl font-semibold", nombreDe(c)));
    const datos = el("p", "flex flex-wrap gap-x-3 text-sm");
    if (c.telefono) {
      const a = el("a", "text-azul-texto font-semibold underline", `+${c.telefono}`) as HTMLAnchorElement;
      a.href = `https://wa.me/${c.telefono}`;
      a.target = "_blank";
      a.rel = "noopener";
      datos.append(a);
    }
    if (c.email) datos.append(el("span", "text-noche-suave break-all", c.email));
    if (c.comuna) datos.append(el("span", "text-noche-suave", c.comuna));
    quien.append(datos, el("p", "text-noche-suave text-xs", `Llegó por ${c.origen} · ${cuando(c.creado)}`));
    fila1.append(quien);

    // Ir a la conversación en su pestaña.
    const ir = el("div", "flex flex-wrap gap-2");
    if (c.whatsapp)
      ir.append(
        boton("Abrir WhatsApp", "border-noche bg-verde-burbuja", () =>
          document.dispatchEvent(new CustomEvent("panel:abrir-chat-wa", { detail: c.whatsapp!.jid })),
        ),
      );
    c.chats.forEach((id, i) =>
      ir.append(
        boton(c.chats.length > 1 ? `Chat web ${i + 1}` : "Abrir chat web", "border-noche bg-celeste", () =>
          document.dispatchEvent(new CustomEvent("panel:abrir-chatweb", { detail: id })),
        ),
      ),
    );
    if (c.consultas.length)
      ir.append(
        boton("Ver consulta", "border-noche bg-sol", () =>
          document.dispatchEvent(new CustomEvent("panel:abrir-pestana", { detail: "consultas" })),
        ),
      );
    fila1.append(ir);
    cabeza.append(fila1);

    // Etapas: la actual marcada, las pasadas en color.
    const pasos = el("ol", "flex flex-wrap gap-1");
    ETAPAS.forEach((e, i) => {
      const actual = e.id === c.etapa;
      const pasada = i < ETAPAS.findIndex((x) => x.id === c.etapa);
      const p = el(
        "li",
        `rounded-full border-2 px-2.5 py-0.5 text-xs font-extrabold ${actual ? `border-noche ${e.clase}` : pasada ? "border-noche/40 bg-crema" : "border-noche/15 text-noche-suave"}`,
        e.nombre,
      );
      if (actual) p.setAttribute("aria-current", "step");
      pasos.append(p);
    });
    cabeza.append(pasos);

    if (c.perdido)
      cabeza.append(
        el(
          "p",
          "bg-arena rounded-xl px-3 py-2 text-sm font-bold",
          `Perdido en ${etapaDe(c.perdido.etapa).nombre}: ${MOTIVOS[c.perdido.motivo]} · ${cuando(c.perdido.en)}${c.perdido.por ? ` · ${c.perdido.por}` : ""}`,
        ),
      );
    else if (c.reactivado)
      cabeza.append(
        el(
          "p",
          "bg-celeste/50 rounded-xl px-3 py-2 text-sm font-bold",
          "Estaba perdido y volvió a escribir o reservar",
        ),
      );
    if (c.esperando)
      cabeza.append(
        el(
          "p",
          "bg-rojo-suave text-rojo-texto rounded-xl px-3 py-2 text-sm font-bold",
          `Espera respuesta por ${ESPERA_EN[c.espera_en!]} hace ${hace(c.esperando)}`,
        ),
      );
    const sinPagar = c.reservas.filter((r) => !r.pagado);
    if (sinPagar.length)
      cabeza.append(
        el(
          "p",
          "bg-sol/40 rounded-xl px-3 py-2 text-sm font-bold",
          `Falta el pago de la reserva del ${diaEvento.format(new Date(`${sinPagar[0]!.fecha}T12:00:00Z`))}`,
        ),
      );

    // Acciones del equipo.
    const acciones = el("div", "flex flex-wrap items-center gap-2");
    const esCliente = c.etapa === "cliente" || c.etapa === "promotor";
    if (c.perdido)
      acciones.append(
        boton(
          "Reactivar",
          "border-noche bg-celeste",
          () => void enviar({ accion: "reactivar", clave: c.clave }, "Contacto reactivado"),
        ),
      );
    else if (!esCliente) {
      const motivo = el(
        "select",
        "border-noche bg-blanco min-h-9 rounded-full border-2 px-3 text-sm font-bold",
      ) as HTMLSelectElement;
      motivo.setAttribute("aria-label", "Motivo de pérdida");
      motivo.append(
        new Option("Marcar perdido por…", ""),
        ...(Object.entries(MOTIVOS) as [Motivo, string][]).map(([id, nombre]) => new Option(nombre, id)),
      );
      motivo.addEventListener("change", () => {
        if (!motivo.value) return;
        void enviar({ accion: "perdido", clave: c.clave, motivo: motivo.value }, "Marcado como perdido");
      });
      acciones.append(motivo);
    }
    const etapa = el(
      "select",
      "border-noche bg-blanco min-h-9 rounded-full border-2 px-3 text-sm font-bold",
    ) as HTMLSelectElement;
    etapa.setAttribute("aria-label", "Cambiar etapa");
    etapa.append(
      new Option(`Etapa automática (${etapaDe(c.etapa_auto).nombre})`, ""),
      // Reservado y Cliente salen solo de la agenda y del pago (que además avisa a Meta), no se marcan a mano.
      ...ETAPAS.filter(
        (e) => MANUALES.includes(e.id) && ETAPAS.indexOf(e) > ETAPAS.findIndex((x) => x.id === c.etapa_auto),
      ).map((e) => new Option(`Subir a ${e.nombre}`, e.id)),
    );
    etapa.value = c.etapa !== c.etapa_auto ? c.etapa : "";
    etapa.addEventListener(
      "change",
      () => void enviar({ accion: "etapa", clave: c.clave, etapa: etapa.value || null }, "Etapa actualizada"),
    );
    acciones.append(etapa);
    cabeza.append(acciones);
    if (esCliente || c.etapa === "reservado")
      cabeza.append(
        el(
          "p",
          "text-noche-suave text-xs",
          "«Cliente» llega solo al marcar la reserva como pagada en Reservas, y «Promotor» al pagar una segunda reserva",
        ),
      );

    // Festejado (para el recordatorio del próximo cumpleaños) y reseña.
    const deleitar = el("div", "flex flex-wrap items-center gap-2 text-sm");
    const f = c.festejado;
    const cumpleTexto = f.cumple
      ? new Date(`${f.cumple}T12:00:00Z`).toLocaleDateString("es-CL", {
          day: "numeric",
          month: "long",
          timeZone: "UTC",
        })
      : null;
    deleitar.append(
      el(
        "p",
        "font-semibold",
        f.nombre || f.cumple
          ? `🎂 ${[f.nombre, cumpleTexto && `cumple el ${cumpleTexto}`].filter(Boolean).join(", ")}`
          : "🎂 Sin datos del festejado",
      ),
    );
    const editarFestejado = boton(
      f.nombre || f.cumple ? "Editar" : "Anotar festejado",
      "border-noche/30 bg-crema",
      () => {
        const nombre = el(
          "input",
          "border-noche bg-crema min-h-10 min-w-0 flex-1 rounded-xl border-2 px-3",
        ) as HTMLInputElement;
        nombre.maxLength = 80;
        nombre.placeholder = "Nombre del niño o niña";
        nombre.value = f.nombre ?? "";
        const cumple = el(
          "input",
          "border-noche bg-crema min-h-10 rounded-xl border-2 px-3",
        ) as HTMLInputElement;
        cumple.type = "date";
        cumple.value = f.cumple ?? "";
        cumple.setAttribute("aria-label", "Fecha de cumpleaños");
        deleitar.replaceChildren(
          nombre,
          cumple,
          boton(
            "Guardar",
            "border-noche bg-noche text-crema",
            () =>
              void enviar(
                { accion: "festejado", clave: c.clave, nombre: nombre.value.trim(), cumple: cumple.value },
                "Festejado guardado",
              ),
          ),
        );
        nombre.focus();
      },
    );
    deleitar.append(editarFestejado);
    if (c.encuestas.length)
      deleitar.append(chip(`Nota ${c.encuestas.map((e) => e.nota).join(", ")} de 5`, "border-noche bg-sol"));
    if (c.resena) deleitar.append(chip("Dejó reseña", "border-noche bg-verde"));
    else if (esCliente)
      deleitar.append(
        boton(
          "Dejó reseña",
          "border-noche/30 bg-crema",
          () =>
            void enviar({ accion: "resena", clave: c.clave, si: true }, "Reseña anotada: ahora es Promotor"),
        ),
      );
    cabeza.append(deleitar);

    // Tareas de este contacto y «Agregar tarea».
    const suyas = tareas.filter((t) => t.clave === c.clave);
    const cajaTareas = el("div", "flex flex-col gap-2 text-sm");
    if (suyas.length) cajaTareas.append(...suyas.map((t) => tarjetaTarea(t, false)));
    const agregar = boton("Agregar tarea", "border-noche/30 bg-crema w-fit", () => {
      const texto = el(
        "input",
        "border-noche bg-crema min-h-10 min-w-0 flex-1 rounded-xl border-2 px-3",
      ) as HTMLInputElement;
      texto.maxLength = 300;
      texto.placeholder = "Ej.: llamar para confirmar la dirección";
      const dia = el("input", "border-noche bg-crema min-h-10 rounded-xl border-2 px-3") as HTMLInputElement;
      dia.type = "date";
      dia.value = mananaChile();
      dia.setAttribute("aria-label", "Para cuándo");
      const fila = el("div", "flex flex-wrap items-center gap-2");
      fila.append(
        texto,
        dia,
        boton("Guardar tarea", "border-noche bg-noche text-crema", () => {
          if (texto.value.trim().length < 2 || !dia.value) return texto.focus();
          // 10:00 en Chile (13:00 UTC) del día elegido.
          void enviar(
            {
              accion: "tarea",
              clave: c.clave,
              texto: texto.value.trim(),
              vence: `${dia.value}T13:00:00.000Z`,
            },
            "Tarea guardada",
          );
        }),
      );
      agregar.replaceWith(fila);
      texto.focus();
    });
    cajaTareas.append(agregar);
    cabeza.append(cajaTareas);

    // Notas internas.
    const notas = el("div", "flex flex-col gap-1 text-sm");
    if (c.notas) notas.append(el("p", "bg-sol/25 rounded-lg px-2 py-1 whitespace-pre-line", c.notas));
    notas.append(
      boton(c.notas ? "Editar nota" : "Agregar nota", "border-noche/30 bg-crema w-fit", () => {
        const area = el(
          "textarea",
          "border-noche bg-crema w-full rounded-xl border-2 px-3 py-2",
        ) as HTMLTextAreaElement;
        area.rows = 3;
        area.maxLength = 2000;
        area.value = c.notas ?? "";
        area.placeholder = "Ej.: cumpleaños de Sofía (5 años), prefiere el castillo, llamar el jueves";
        notas.replaceChildren(
          area,
          boton(
            "Guardar nota",
            "border-noche bg-noche text-crema w-fit",
            () => void enviar({ accion: "notas", clave: c.clave, notas: area.value }, "Nota guardada"),
          ),
        );
        area.focus();
      }),
    );
    cabeza.append(notas);

    // Línea de tiempo.
    const tiempo = el("ol", "flex max-h-[50vh] flex-col gap-2 overflow-y-auto p-4");
    for (const e of eventos) {
      const li = el("li", "flex gap-2 text-sm");
      li.append(el("span", "shrink-0", ICONO[e.tipo]));
      const cuerpo = el("div", "min-w-0");
      cuerpo.append(
        el("p", "break-words", e.texto),
        el("p", "text-noche-suave text-xs font-semibold", cuando(e.en)),
      );
      li.append(cuerpo);
      tiempo.append(li);
    }
    if (!eventos.length) tiempo.append(el("li", "text-noche-suave text-sm", "Sin actividad registrada"));

    ficha.replaceChildren(
      cabeza,
      el("p", "font-display px-4 pt-3 text-lg font-semibold", "Línea de tiempo"),
      tiempo,
    );
  }

  // ── Tablero (pipeline de negocios) ────────────────────────────────────
  // Cada tarjeta es una oportunidad abierta: un contacto que todavía no reserva (Nuevo o Cotizado), una reserva sin
  // pago (Falta pago), una reserva pagada hace poco o con el evento por venir (Ganado) o un perdido reciente.
  type Columna = "nuevo" | "cotizado" | "falta_pago" | "ganado" | "perdido";
  type Tarjeta = { c: Contacto; reserva?: Reserva };
  const COLUMNAS: { id: Columna; nombre: string; clase: string }[] = [
    { id: "nuevo", nombre: "Nuevo", clase: "bg-crema" },
    { id: "cotizado", nombre: "Cotizado", clase: "bg-sol/50" },
    { id: "falta_pago", nombre: "Falta pago", clase: "bg-verde-burbuja/50" },
    { id: "ganado", nombre: "Ganado", clase: "bg-verde/50" },
    { id: "perdido", nombre: "Perdido", clase: "bg-arena" },
  ];
  const RECIENTE = 30 * 86_400_000;
  /** Días sin movimiento antes de avisar que un cotizado se está enfriando (los cuadernos insisten a las 24 h y a los 3 días). */
  const DIAS_FRIO = 3;
  const tablero = root.querySelector<HTMLElement>("[data-crm-tablero]")!;
  const hoyChile = () =>
    new Intl.DateTimeFormat("en-CA", { timeZone: "America/Santiago" }).format(new Date());
  const pesos = (n: number) => `$${n.toLocaleString("es-CL")}`;
  let vista: "lista" | "tablero" | "tareas" = "lista";
  let arrastrando: { tarjeta: Tarjeta; desde: Columna } | null = null;

  function repartir(): Record<Columna, Tarjeta[]> {
    const cols: Record<Columna, Tarjeta[]> = {
      nuevo: [],
      cotizado: [],
      falta_pago: [],
      ganado: [],
      perdido: [],
    };
    const hoy = hoyChile();
    const q = sinTildes(buscar.value.trim());
    for (const c of contactos) {
      if (
        q &&
        !sinTildes([c.nombre, c.telefono, c.email, c.comuna, c.origen].filter(Boolean).join(" ")).includes(q)
      )
        continue;
      if (c.perdido) {
        if (Date.now() - Date.parse(c.perdido.en) < RECIENTE) cols.perdido.push({ c });
        continue;
      }
      const sinPagar = c.reservas.filter((r) => !r.pagado);
      for (const r of sinPagar) cols.falta_pago.push({ c, reserva: r });
      for (const r of c.reservas.filter(
        (r) =>
          r.pagado && (r.fecha >= hoy || (r.pagado_en && Date.now() - Date.parse(r.pagado_en) < RECIENTE)),
      ))
        cols.ganado.push({ c, reserva: r });
      // Sin reservas: está antes de la venta.
      if (!c.reservas.length) {
        if (c.etapa === "cotizado") cols.cotizado.push({ c });
        else if (c.etapa === "lead" || c.etapa === "calificado") cols.nuevo.push({ c });
      }
    }
    cols.falta_pago.sort((a, b) => a.reserva!.fecha.localeCompare(b.reserva!.fecha));
    cols.ganado.sort((a, b) => b.reserva!.fecha.localeCompare(a.reserva!.fecha));
    return cols;
  }

  /** A qué columnas se puede llevar una tarjeta desde la suya. */
  function destinos(t: Tarjeta, desde: Columna): Columna[] {
    if (desde === "nuevo") return ["cotizado", "falta_pago", "perdido"];
    if (desde === "cotizado")
      return t.c.etapa_auto === "cotizado" ? ["falta_pago", "perdido"] : ["nuevo", "falta_pago", "perdido"];
    if (desde === "falta_pago") return ["ganado", "perdido"];
    if (desde === "perdido") return ["nuevo"];
    return [];
  }

  async function mover(t: Tarjeta, desde: Columna, a: Columna) {
    if (!destinos(t, desde).includes(a)) return;
    const c = t.c;
    if (a === "perdido") return pedirMotivo(c);
    if (desde === "perdido")
      return void enviar({ accion: "reactivar", clave: c.clave }, "Contacto reactivado");
    if (a === "cotizado")
      return void enviar({ accion: "etapa", clave: c.clave, etapa: "cotizado" }, "Movido a Cotizado");
    if (a === "nuevo") return void enviar({ accion: "etapa", clave: c.clave, etapa: null }, "Movido a Nuevo");
    if (a === "falta_pago") {
      // Pasar a «Falta pago» es crear la reserva: se abre el formulario con sus datos.
      const [nombre, ...resto] = (c.nombre ?? "").split(/\s+/);
      document.dispatchEvent(new CustomEvent("panel:abrir-pestana", { detail: "reservas" }));
      document.dispatchEvent(
        new CustomEvent("panel:nueva-reserva", {
          detail: {
            nombre: nombre ?? "",
            apellido: resto.join(" "),
            telefono: c.telefono ? `+${c.telefono}` : "",
            email: c.email ?? "",
            comuna: c.comuna ?? "",
            notas: c.notas ?? "",
          },
        }),
      );
      return;
    }
    if (a === "ganado" && t.reserva) {
      // Ganado = registrar el pago en Reservas (así también se avisa la venta a Meta).
      document.dispatchEvent(new CustomEvent("panel:abrir-pestana", { detail: "reservas" }));
      document.dispatchEvent(new CustomEvent("panel:registrar-pago", { detail: t.reserva.id }));
    }
  }

  const dialogo = root.querySelector<HTMLDialogElement>("[data-crm-motivo]")!;
  const selectMotivo = dialogo.querySelector<HTMLSelectElement>("select")!;
  selectMotivo.append(
    new Option("Elige el motivo", ""),
    ...(Object.entries(MOTIVOS) as [Motivo, string][]).map(([id, nombre]) => new Option(nombre, id)),
  );
  let perdiendo: Contacto | null = null;
  function pedirMotivo(c: Contacto) {
    perdiendo = c;
    selectMotivo.value = c.reservas.some((r) => !r.pagado) ? "cancelo" : "";
    dialogo.querySelector("[data-crm-motivo-quien]")!.textContent =
      `${nombreDe(c)} · ${etapaDe(c.etapa).nombre}`;
    dialogo.querySelector<HTMLElement>("[data-crm-motivo-aviso]")!.hidden = !c.reservas.some(
      (r) => !r.pagado,
    );
    dialogo.showModal();
  }
  dialogo.addEventListener("close", () => {
    if (dialogo.returnValue === "ok" && perdiendo && selectMotivo.value)
      void enviar(
        { accion: "perdido", clave: perdiendo.clave, motivo: selectMotivo.value },
        "Marcado como perdido",
      );
    perdiendo = null;
  });

  function pintarTablero() {
    const cols = repartir();
    tablero.replaceChildren(
      ...COLUMNAS.map((col) => {
        const tarjetas = cols[col.id];
        const caja = el("section", `flex min-w-[232px] flex-1 flex-col gap-2 rounded-2xl p-2 ${col.clase}`);
        caja.dataset.columna = col.id;
        const suma = tarjetas.reduce((s, t) => s + (t.reserva?.total ?? 0), 0);
        const cabeza = el("div", "flex items-baseline justify-between gap-2 px-1");
        cabeza.append(
          el("h3", "font-extrabold", `${col.nombre} · ${tarjetas.length}`),
          el("span", "text-noche-suave text-xs font-bold", suma ? pesos(suma) : ""),
        );
        caja.append(cabeza);
        const cuerpo = el("div", "flex max-h-[65vh] min-h-24 flex-col gap-2 overflow-y-auto");
        cuerpo.append(...tarjetas.slice(0, 150).map((t) => tarjeta(t, col.id)));
        if (!tarjetas.length) cuerpo.append(el("p", "text-noche-suave px-1 text-xs", "Sin tarjetas"));
        caja.append(cuerpo);
        // Soltar una tarjeta arrastrada.
        caja.addEventListener("dragover", (e) => {
          if (arrastrando && destinos(arrastrando.tarjeta, arrastrando.desde).includes(col.id)) {
            e.preventDefault();
            caja.classList.add("outline-noche", "outline-2", "outline-dashed");
          }
        });
        caja.addEventListener("dragleave", () =>
          caja.classList.remove("outline-noche", "outline-2", "outline-dashed"),
        );
        caja.addEventListener("drop", (e) => {
          e.preventDefault();
          caja.classList.remove("outline-noche", "outline-2", "outline-dashed");
          if (arrastrando) void mover(arrastrando.tarjeta, arrastrando.desde, col.id);
          arrastrando = null;
        });
        return caja;
      }),
    );
  }

  function tarjeta(t: Tarjeta, col: Columna): HTMLElement {
    const { c, reserva: r } = t;
    const hoy = hoyChile();
    const frio =
      (col === "cotizado" || col === "nuevo") && Date.now() - Date.parse(c.ultimo) > DIAS_FRIO * 86_400_000;
    const vencida = col === "falta_pago" && r && r.fecha < hoy;
    const caja = el(
      "article",
      `bg-blanco flex cursor-grab flex-col gap-1 rounded-xl border-2 p-2.5 text-sm ${vencida || (c.esperando && col !== "perdido") ? "border-rojo-texto" : frio ? "border-sol" : "border-noche"}`,
    );
    caja.draggable = destinos(t, col).length > 0;
    caja.addEventListener("dragstart", () => (arrastrando = { tarjeta: t, desde: col }));
    caja.addEventListener("dragend", () => (arrastrando = null));

    const nombre = el(
      "button",
      "text-left font-extrabold underline-offset-2 hover:underline",
      nombreDe(c),
    ) as HTMLButtonElement;
    nombre.type = "button";
    nombre.addEventListener("click", () => {
      cambiarVista("lista");
      filtro = "todos";
      pintarFiltros();
      void abrir(c.clave, true);
    });
    caja.append(nombre);
    if (r)
      caja.append(
        el(
          "p",
          "font-semibold",
          `${diaEvento.format(new Date(`${r.fecha}T12:00:00Z`))}${r.total ? ` · ${pesos(r.total)}` : ""}${r.pagado && r.total && r.pagado < r.total ? ` · abonó ${pesos(r.pagado)}` : ""}`,
        ),
      );
    const chips = el("div", "flex flex-wrap gap-1");
    if (col === "perdido" && c.perdido)
      chips.append(chip(MOTIVOS[c.perdido.motivo], "border-noche/40 bg-crema"));
    if (col === "nuevo" && c.etapa === "calificado")
      chips.append(chip("Calificado", "border-noche bg-celeste"));
    if (c.esperando && col !== "perdido")
      chips.append(chip(`Espera hace ${hace(c.esperando)}`, "border-rojo-texto bg-rojo-texto text-white"));
    if (vencida)
      chips.append(chip("Fecha pasada sin pago", "border-rojo-texto bg-rojo-suave text-rojo-texto"));
    if (frio && !c.esperando)
      chips.append(chip(`Sin movimiento hace ${hace(c.ultimo)}`, "border-noche bg-sol"));
    if (c.perdido && c.reservas.some((x) => !x.pagado))
      chips.append(chip("Liberar fecha en Reservas", "border-noche bg-sol"));
    if (chips.childElementCount) caja.append(chips);
    caja.append(el("p", "text-noche-suave truncate text-xs", c.origen));

    // «Mover a…» para el celular (donde no se puede arrastrar) y para quien prefiera el teclado.
    const opciones = destinos(t, col);
    if (opciones.length) {
      const sel = el(
        "select",
        "border-noche/40 bg-crema mt-1 min-h-8 rounded-full border px-2 text-xs font-bold",
      ) as HTMLSelectElement;
      sel.setAttribute("aria-label", `Mover a ${nombreDe(c)}`);
      sel.append(
        new Option("Mover a…", ""),
        // Sacar de Perdido es reactivarlo: vuelve a la columna de su etapa.
        ...opciones.map(
          (o) => new Option(col === "perdido" ? "Reactivar" : COLUMNAS.find((x) => x.id === o)!.nombre, o),
        ),
      );
      sel.addEventListener("change", () => {
        if (sel.value) void mover(t, col, sel.value as Columna);
        sel.value = "";
      });
      caja.append(sel);
    }
    return caja;
  }

  // ── Tareas ────────────────────────────────────────────────────────────
  const listaTareas = root.querySelector<HTMLElement>("[data-crm-tareas]")!;
  const mananaChile = () =>
    new Intl.DateTimeFormat("en-CA", { timeZone: "America/Santiago" }).format(
      new Date(Date.now() + 86_400_000),
    );
  const ICONO_TAREA: Record<Tarea["tipo"], string> = {
    seguimiento: "🔔",
    ultimo_intento: "⏳",
    cerrar: "🗂️",
    abono: "💰",
    logistica: "🚚",
    encuesta: "⭐",
    resena: "🌟",
    recuperar: "📞",
    cumple: "🎂",
    manual: "📌",
  };

  function pintarBotonTareas() {
    const atrasadas = tareas.filter((t) => t.vence <= new Date().toISOString()).length;
    const b = root.querySelector<HTMLElement>("[data-crm-vista=tareas]")!;
    b.textContent = atrasadas ? `Tareas ${atrasadas}` : "Tareas";
  }

  async function hecha(t: Tarea, hasta?: string) {
    await enviar(
      { accion: "tarea_hecha", clave: t.clave, id: t.id, hasta },
      hasta ? "Tarea pospuesta para mañana" : "Tarea hecha",
    );
  }

  function tarjetaTarea(t: Tarea, conNombre: boolean): HTMLElement {
    const atrasada = t.vence <= new Date().toISOString();
    const caja = el(
      "article",
      `bg-blanco flex flex-col gap-2 rounded-2xl border-2 p-3 text-sm ${atrasada ? "border-rojo-texto" : "border-noche"}`,
    );
    const arriba = el("div", "flex flex-wrap items-baseline justify-between gap-2");
    const titulo = el("p", "font-extrabold", `${ICONO_TAREA[t.tipo]} ${t.titulo}`);
    if (conNombre) {
      const quien = el(
        "button",
        "text-azul-texto ml-1 font-extrabold underline",
        t.nombre,
      ) as HTMLButtonElement;
      quien.type = "button";
      quien.addEventListener("click", () => {
        cambiarVista("lista");
        filtro = "todos";
        pintarFiltros();
        void abrir(t.clave, true);
      });
      titulo.append(" · ", quien);
    }
    arriba.append(
      titulo,
      el(
        "span",
        `text-xs font-bold ${atrasada ? "text-rojo-texto" : "text-noche-suave"}`,
        atrasada ? `Desde ${cuando(t.vence)}` : `Para ${cuando(t.vence)}`,
      ),
    );
    caja.append(arriba, el("p", "text-noche-suave", t.motivo));

    const acciones = el("div", "flex flex-wrap items-center gap-2");
    if (t.mensaje) {
      const area = el(
        "textarea",
        "border-noche/40 bg-crema w-full rounded-xl border-2 px-3 py-2",
      ) as HTMLTextAreaElement;
      area.rows = 3;
      area.maxLength = 4000;
      area.value = t.mensaje;
      area.setAttribute("aria-label", `Mensaje para ${t.nombre}`);
      caja.append(area);
      if (t.jid) {
        // Sale desde el WhatsApp de Saltabum (Evolution), igual que una respuesta de la pestaña WhatsApp.
        const mandar = boton("Enviar por WhatsApp", "border-noche bg-verde-burbuja", async () => {
          const texto = area.value.trim();
          if (!texto) return area.focus();
          mandar.disabled = true;
          const res = await api("/api/admin/whatsapp", {
            method: "POST",
            body: JSON.stringify({ accion: "responder", jid: t.jid, texto }),
          }).catch(() => null);
          if (res?.status === 401) return sinSesion();
          if (!res?.ok) {
            mandar.disabled = false;
            return avisar("WhatsApp no respondió, inténtalo de nuevo");
          }
          await hecha(t);
        });
        acciones.append(mandar);
      } else if (t.telefono) {
        const a = el(
          "a",
          "border-noche bg-verde-burbuja inline-flex min-h-9 items-center rounded-full border-2 px-3 text-sm font-extrabold no-underline",
          "Abrir en WhatsApp",
        ) as HTMLAnchorElement;
        a.target = "_blank";
        a.rel = "noopener";
        a.href = `https://wa.me/${t.telefono}`;
        a.addEventListener(
          "click",
          () => (a.href = `https://wa.me/${t.telefono}?text=${encodeURIComponent(area.value)}`),
        );
        acciones.append(a);
      }
    }
    if (t.tipo === "encuesta" && t.reserva) {
      // Cuando el cliente responde, se anota su nota: con 4 o 5 aparece «Pedir reseña», con 3 o menos «Llamar».
      const notas = el("div", "flex w-full flex-wrap items-center gap-1");
      notas.append(el("span", "text-noche-suave mr-1 text-xs font-bold", "Su nota"));
      for (let nota = 1; nota <= 5; nota++)
        notas.append(
          boton(
            "★".repeat(nota),
            "border-noche/40 bg-sol/40 min-h-8 px-2 text-xs",
            () =>
              void enviar(
                { accion: "encuesta", clave: t.clave, reserva: t.reserva, nota },
                `Nota ${nota} de 5 guardada`,
              ),
          ),
        );
      caja.append(notas);
    }
    if (t.tipo === "resena")
      acciones.append(
        boton(
          "Dejó reseña",
          "border-noche bg-verde",
          () =>
            void enviar({ accion: "resena", clave: t.clave, si: true }, "Reseña anotada: ahora es Promotor"),
        ),
      );
    if (t.tipo === "cerrar")
      acciones.append(
        boton(
          "Marcar perdido: no respondió",
          "border-noche bg-arena",
          () =>
            void enviar(
              { accion: "perdido", clave: t.clave, motivo: "no_respondio" },
              "Marcado como perdido",
            ),
        ),
      );
    acciones.append(
      boton(
        t.mensaje && (t.jid || t.telefono) ? "Ya lo hice" : "Hecha",
        "border-noche bg-blanco",
        () => void hecha(t),
      ),
      boton("Mañana", "border-noche/30 bg-crema", () => void hecha(t, `${mananaChile()}T13:00:00.000Z`)),
    );
    caja.append(acciones);
    return caja;
  }

  function pintarTareas() {
    const ahora = new Date().toISOString();
    const finHoy = `${mananaChile()}T03:00:00.000Z`; // medianoche en Chile
    const q = sinTildes(buscar.value.trim());
    const visibles = tareas.filter((t) => !q || sinTildes(`${t.nombre} ${t.titulo}`).includes(q));
    const grupos: [string, Tarea[]][] = [
      ["Atrasadas", visibles.filter((t) => t.vence <= ahora)],
      ["Hoy", visibles.filter((t) => t.vence > ahora && t.vence < finHoy)],
      ["Próximas", visibles.filter((t) => t.vence >= finHoy)],
    ];
    listaTareas.replaceChildren(
      ...grupos
        .filter(([, ts]) => ts.length)
        .map(([nombre, ts]) => {
          const g = el("section", "flex flex-col gap-2");
          g.append(
            el("h3", "font-display text-xl font-semibold", `${nombre} · ${ts.length}`),
            ...ts.slice(0, 100).map((t) => tarjetaTarea(t, true)),
          );
          return g;
        }),
    );
    if (!visibles.length)
      listaTareas.append(el("p", "text-noche-suave text-sm", "No hay tareas pendientes 🎉"));
  }

  function cambiarVista(v: "lista" | "tablero" | "tareas") {
    vista = v;
    root
      .querySelectorAll<HTMLElement>("[data-crm-vista]")
      .forEach((b) => b.setAttribute("aria-checked", String(b.dataset.crmVista === v)));
    root.querySelector<HTMLElement>("[data-crm-en-lista]")!.hidden = v !== "lista";
    root.querySelector<HTMLElement>("[data-crm-en-tablero]")!.hidden = v !== "tablero";
    root.querySelector<HTMLElement>("[data-crm-en-tareas]")!.hidden = v !== "tareas";
    if (v === "tablero") pintarTablero();
    if (v === "tareas") pintarTareas();
    try {
      localStorage.setItem("saltabum-crm-vista", v);
    } catch {
      // Sin almacenamiento: la vista vuelve a «Lista» al recargar.
    }
  }
  root
    .querySelectorAll<HTMLElement>("[data-crm-vista]")
    .forEach((b) =>
      b.addEventListener("click", () => cambiarVista(b.dataset.crmVista as "lista" | "tablero" | "tareas")),
    );
  try {
    const guardada = localStorage.getItem("saltabum-crm-vista");
    if (guardada === "tablero" || guardada === "tareas") cambiarVista(guardada);
  } catch {
    // Sin almacenamiento: se queda en «Lista».
  }

  buscar.addEventListener("input", () =>
    vista === "tablero" ? pintarTablero() : vista === "tareas" ? pintarTareas() : pintarLista(),
  );
  root.querySelector("[data-crm-actualizar]")!.addEventListener("click", () => void cargar());

  document.addEventListener("panel:listo", () => {
    activo = true;
    void cargar();
  });
  document.addEventListener("panel:pestana", (e) => {
    if (activo && (e as CustomEvent<string>).detail === "contactos") void cargar();
  });
  setInterval(() => {
    if (activo && document.visibilityState === "visible") void cargar();
  }, 30_000);
  document.addEventListener("panel:cerrado", () => {
    activo = false;
    contactos = [];
    abierto = null;
    lista.replaceChildren();
  });
</script>
