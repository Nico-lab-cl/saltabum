---
// Metadatos SEO y para compartir (Open Graph / Twitter) + datos estructurados schema.org.
// Cada página puede sumar nodos al grafo con `jsonLd` (ej. FAQPage, Service, BreadcrumbList).
import { SITE } from "@/config/site";

export interface SEOProps {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Nodos schema.org extra para esta página (se agregan al @graph). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.defaultDescription,
  image = SITE.defaultOgImage,
  imageAlt = SITE.defaultOgImageAlt,
  noindex = false,
  jsonLd = [],
} = Astro.props as SEOProps;

const fullTitle = title ? `${title} | ${SITE.name}` : SITE.defaultTitle;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const negocioId = `${SITE.url}/#negocio`;

const grafo = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": negocioId,
      name: SITE.legalName,
      alternateName: SITE.name,
      description: SITE.businessDescription,
      url: SITE.url,
      logo: new URL("/logo.png", SITE.url).href,
      image: new URL(SITE.defaultOgImage, SITE.url).href,
      telephone: SITE.telefonoE164,
      email: SITE.email,
      priceRange: "$$",
      currenciesAccepted: "CLP",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Valparaíso",
        addressRegion: "Región de Valparaíso",
        addressCountry: "CL",
      },
      areaServed: SITE.comunas.map((name) => ({ "@type": "City", name })),
      knowsLanguage: "es-CL",
      sameAs: SITE.redes.map((r) => r.url),
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#sitio`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: SITE.lang,
      publisher: { "@id": negocioId },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#pagina`,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: SITE.lang,
      isPartOf: { "@id": `${SITE.url}/#sitio` },
      about: { "@id": negocioId },
      primaryImageOfPage: ogImage,
    },
    ...jsonLd,
  ],
});
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="theme-color" content="#ffc23a" />

<script type="application/ld+json" set:html={grafo} />
