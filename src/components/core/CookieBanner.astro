---
// Banner de consentimiento. Funcional y con estilo neutro: Claude Design puede reemplazar
// el markup/clases libremente mientras conserve los atributos data-consent-*.
// Cualquier elemento con [data-consent-open] (ej. link "Configurar cookies" en el footer) lo reabre.
---

<div
  data-consent-banner
  hidden
  role="dialog"
  aria-live="polite"
  aria-label="Preferencias de cookies"
  class="border-noche bg-blanco text-noche shadow-pop fixed inset-x-2 bottom-[88px] z-50 flex items-center gap-2.5 rounded-2xl border-2 p-2.5 pl-3.5 text-[13px] leading-[18px] max-[419px]:bottom-[92px] lg:right-auto lg:bottom-6 lg:left-6 lg:block lg:max-w-[440px] lg:rounded-3xl lg:p-5 lg:text-[15px] lg:leading-[22px]"
>
  <!-- En el celular va en una franja corta junto a los botones (antes tapaba un tercio de la primera pantalla) -->
  <p class="min-w-0 flex-1">
    <span class="lg:hidden">Usamos cookies para medir el sitio y mostrarte publicidad.&nbsp;</span><span
      class="hidden lg:inline"
      >Usamos cookies propias y de terceros (Google, Meta y Microsoft) para medir cómo se usa el sitio y mostrarte
      publicidad relevante. Más información en nuestra&nbsp;</span
    ><a href="/politica-de-privacidad" class="text-azul-texto font-bold underline"
      ><span class="lg:hidden">Ver más</span><span class="hidden lg:inline">política de privacidad</span></a
    >.
  </p>
  <div class="flex shrink-0 gap-1.5 lg:mt-3 lg:gap-2.5">
    <button
      type="button"
      data-consent-reject
      class="border-noche bg-blanco text-noche min-h-10 cursor-pointer rounded-full border-2 px-3 font-extrabold lg:min-h-11 lg:flex-1"
    >
      Rechazar
    </button>
    <button
      type="button"
      data-consent-accept
      class="border-noche bg-noche text-crema min-h-10 cursor-pointer rounded-full border-2 px-3 font-extrabold lg:min-h-11 lg:flex-1"
    >
      Aceptar
    </button>
  </div>
</div>

<style is:global>
  /* Con el chat abierto el aviso se esconde: en el celular tapaba el botón «Empezar a chatear». Vuelve al cerrarlo. */
  body:has([data-chat][data-abierto]) [data-consent-banner] {
    display: none;
  }
</style>

<script>
  import { getConsent, setConsent } from "@/lib/client/consent";

  const banner = document.querySelector<HTMLElement>("[data-consent-banner]");
  if (banner) {
    if (getConsent() === null) banner.hidden = false;
    banner.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
      setConsent("granted");
      banner.hidden = true;
    });
    banner.querySelector("[data-consent-reject]")?.addEventListener("click", () => {
      setConsent("denied");
      banner.hidden = true;
    });
    document.addEventListener("click", (e) => {
      if ((e.target as Element | null)?.closest("[data-consent-open]")) {
        e.preventDefault();
        banner.hidden = false;
      }
    });
  }
</script>
