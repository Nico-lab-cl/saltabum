---
// Banner de consentimiento. Funcional y con estilo neutro: Claude Design puede reemplazar
// el markup/clases libremente mientras conserve los atributos data-consent-*.
// Cualquier elemento con [data-consent-open] (ej. link "Configurar cookies" en el footer) lo reabre.
---

<div
  data-consent-banner
  hidden
  role="dialog"
  aria-live="polite"
  aria-label="Preferencias de cookies"
  class="border-noche bg-blanco text-noche shadow-pop fixed inset-x-3 bottom-24 z-50 rounded-[20px] border-2 p-4 text-sm leading-5 lg:right-auto lg:bottom-6 lg:left-6 lg:max-w-[440px] lg:rounded-3xl lg:p-5 lg:text-[15px] lg:leading-[22px]"
>
  <p>
    Usamos cookies propias y de terceros (Google, Meta y Microsoft) para medir qué juegos les gustan más y
    mostrarte publicidad relevante. Más información en nuestra
    <a href="/politica-de-privacidad" class="text-azul-texto font-bold underline">política de privacidad</a>.
  </p>
  <div class="mt-3 flex gap-2.5">
    <button
      type="button"
      data-consent-reject
      class="border-noche bg-blanco text-noche min-h-11 flex-1 cursor-pointer rounded-full border-2 font-extrabold"
    >
      Rechazar
    </button>
    <button
      type="button"
      data-consent-accept
      class="border-noche bg-noche text-crema min-h-11 flex-1 cursor-pointer rounded-full border-2 font-extrabold"
    >
      Aceptar
    </button>
  </div>
</div>

<script>
  import { getConsent, setConsent } from "@/lib/client/consent";

  const banner = document.querySelector<HTMLElement>("[data-consent-banner]");
  if (banner) {
    if (getConsent() === null) banner.hidden = false;
    banner.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
      setConsent("granted");
      banner.hidden = true;
    });
    banner.querySelector("[data-consent-reject]")?.addEventListener("click", () => {
      setConsent("denied");
      banner.hidden = true;
    });
    document.addEventListener("click", (e) => {
      if ((e.target as Element | null)?.closest("[data-consent-open]")) {
        e.preventDefault();
        banner.hidden = false;
      }
    });
  }
</script>
