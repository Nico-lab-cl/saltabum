---
// /gracias/ — después de reservar en la agenda o de enviar el formulario de contacto (?tipo=consulta, el nombre
// llega en sessionStorage «saltabum:consulta»). El resumen (fecha, horario, lugar y total) lo deja la agenda en
// sessionStorage («saltabum:reserva») justo antes de traer al cliente aquí; si no está (página abierta directo o
// almacenamiento bloqueado), se muestra el agradecimiento sin el resumen. No dispara conversiones: la reserva
// ya se midió al enviarse.
import { ABONO, PRODUCTO } from "../data";
import { RUTAS } from "../seo";
import Icon from "../components/Icon.astro";
import Rayos from "../components/Rayos.astro";
import WaButton from "../components/WaButton.astro";
import Footer from "../sections/Footer.astro";
import Header from "../sections/Header.astro";

const abono = `$${ABONO.toLocaleString("es-CL")}`;

/** Confeti en los colores de la marca (posiciones fijas para que el HTML sea siempre igual). */
const COLORES = ["#f0462d", "#ffc23a", "#2db866", "#2f8fea", "#8e5be8", "#ff6fae", "#7fd3f7", "#ff8a1f"];
const CONFETI = Array.from({ length: 28 }, (_, i) => ({
  x: (i * 37) % 100,
  c: COLORES[i % COLORES.length],
  d: (-((i * 0.53) % 4.5)).toFixed(2),
  t: (4.5 + ((i * 0.71) % 3)).toFixed(2),
  r: (i * 47) % 360,
  forma: i % 3,
}));

const PASOS = [
  {
    color: "bg-sol",
    titulo: "Te escribimos por WhatsApp",
    texto: "Hoy mismo, para confirmar el horario y la dirección del evento",
  },
  {
    color: "bg-verde",
    titulo: `Pagas el abono de ${abono}`,
    texto: "Con eso queda confirmada tu reserva, y se descuenta del total",
  },
  {
    color: "bg-celeste",
    titulo: "Llegamos antes de la hora",
    texto: "Montamos en unos 30 minutos, lo anclamos al piso y lo retiramos al terminar",
  },
];

const PREPARA = [
  `Un espacio libre de ${PRODUCTO.espacioLibre}, sin ramas ni techos bajos`,
  "Un enchufe a menos de 15 metros",
  "El patio o pasto despejado antes de que lleguemos",
];
---

<Header />
<main class="overflow-x-clip">
  <section class="border-noche bg-sol text-noche relative isolate overflow-clip border-b-2" aria-labelledby="gracias-titulo">
    <Rayos x="50%" y="0%" />
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      {
        CONFETI.map((p) => (
          <span
            class:list={["confeti absolute -top-6 block", p.forma === 0 ? "h-3.5 w-2 rounded-sm" : p.forma === 1 ? "size-3 rounded-full" : "h-2 w-4 rounded-sm"]}
            style={`left:${p.x}%;background:${p.c};--d:${p.d}s;--t:${p.t}s;--r:${p.r}deg`}
          />
        ))
      }
    </div>

    <div class="mx-auto flex max-w-[880px] flex-col items-center gap-6 px-4 pt-12 pb-14 text-center lg:gap-8 lg:pt-20 lg:pb-24">
      <span class="sello border-noche bg-verde shadow-pop-l flex size-20 items-center justify-center rounded-full border-2 lg:size-24">
        <Icon name="check" size={44} strokeWidth={3.2} />
      </span>
      <div>
        <p data-gracias-eyebrow class="text-xs font-extrabold tracking-[1.2px] uppercase">Reserva recibida</p>
        <h1 id="gracias-titulo" class="font-display mt-2 text-[38px] leading-[42px] font-semibold lg:text-6xl lg:leading-[64px]">
          ¡Gracias<span data-gracias-nombre></span>! <span data-gracias-titulo>Tu horario quedó reservado</span>
        </h1>
        <p data-gracias-bajada class="mx-auto mt-3 max-w-[560px] text-lg lg:text-xl">
          Te escribimos por WhatsApp para confirmar tu reserva con el abono de {abono}
        </p>
      </div>

      <!-- Resumen (lo completa el script con lo que dejó la agenda) -->
      <div data-gracias-resumen hidden class="border-noche bg-blanco shadow-pop lg:shadow-pop-l w-full max-w-[560px] rounded-[28px] border-2 p-5 text-left lg:p-7">
        <p class="font-display text-2xl leading-8 font-semibold">Tu reserva</p>
        <dl class="mt-3 flex flex-col gap-2.5">
          {
            [
              { id: "juego", nombre: "Juego", icono: "check" as const },
              { id: "fecha", nombre: "Fecha", icono: "calendario" as const },
              { id: "horario", nombre: "Horario", icono: "puntual" as const },
              { id: "lugar", nombre: "Lugar", icono: "ubicacion" as const },
            ].map((r) => (
              <div class="flex items-center gap-3">
                <span class="border-noche bg-crema flex size-10 shrink-0 items-center justify-center rounded-full border-2">
                  <Icon name={r.icono} size={19} />
                </span>
                <div class="min-w-0">
                  <dt class="text-noche-suave text-xs font-extrabold tracking-[1px] uppercase">{r.nombre}</dt>
                  <dd data-gracias={r.id} class="leading-5 font-bold first-letter:uppercase" />
                </div>
              </div>
            ))
          }
        </dl>
        <div class="border-noche/20 mt-4 flex items-end justify-between gap-3 border-t-2 border-dashed pt-3">
          <span class="font-extrabold">Total</span>
          <strong data-gracias="total" class="font-display text-[32px] leading-9 font-bold"></strong>
        </div>
        <p class="text-noche-suave mt-1 text-sm">Abono para confirmar: {abono}, que se descuenta del total</p>
      </div>

      <div class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row">
        <WaButton
          placement="gracias"
          size="l"
          message="Hola, acabo de reservar en saltabum.cl y quiero confirmar con el abono."
          class="w-full text-center leading-[22px] sm:w-auto"
        >
          <span data-gracias-cta>Confirmar ahora por WhatsApp</span>
        </WaButton>
        <a
          href={RUTAS.inicio}
          class="bounce border-noche bg-blanco shadow-pop inline-flex min-h-14 w-full items-center justify-center rounded-full border-2 px-6 text-[17px] font-extrabold no-underline sm:w-auto lg:min-h-15"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  </section>

  <section class="border-noche bg-crema text-noche border-b-2" aria-labelledby="sigue-titulo">
    <div class="mx-auto max-w-[1120px] px-4 py-12 lg:px-10 lg:py-20">
      <p class="text-rojo-texto text-xs font-extrabold tracking-[1.2px] uppercase">Lo que sigue</p>
      <h2 id="sigue-titulo" class="font-display mt-1.5 text-[32px] leading-9 font-semibold lg:text-5xl lg:leading-[52px]">
        Tres pasos y a saltar
      </h2>
      <ol class="mt-6 grid gap-4 lg:mt-10 lg:grid-cols-3 lg:gap-6">
        {
          PASOS.map((p, i) => (
            <li class="border-noche bg-blanco shadow-pop flex gap-4 rounded-3xl border-2 p-5 lg:flex-col lg:p-6">
              <span class:list={["border-noche font-display flex size-12 shrink-0 items-center justify-center rounded-full border-2 text-2xl font-bold", p.color]}>
                {i + 1}
              </span>
              <div>
                <p class="font-display text-[22px] leading-7 font-semibold">{p.titulo}</p>
                <p class="text-noche-suave mt-1">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="border-noche bg-verde-burbuja mt-6 rounded-3xl border-2 p-5 lg:mt-8 lg:flex lg:items-center lg:gap-8 lg:p-7">
        <p class="font-display shrink-0 text-2xl leading-8 font-semibold">Para el día del evento</p>
        <ul class="mt-3 flex flex-col gap-2 lg:mt-0 lg:flex-row lg:flex-wrap lg:gap-x-6">
          {
            PREPARA.map((t) => (
              <li class="flex items-start gap-2 font-semibold">
                <Icon name="check" size={22} strokeWidth={3} class="text-verde mt-px shrink-0" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</main>
<Footer />

<style>
  .confeti {
    border: 1.5px solid var(--color-noche);
    rotate: var(--r);
    animation: caer var(--t) linear var(--d) infinite;
  }
  @keyframes caer {
    to {
      translate: 0 110vh;
      rotate: calc(var(--r) + 540deg);
    }
  }
  .sello {
    animation: aparecer 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  @keyframes aparecer {
    from {
      scale: 0.4;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .confeti {
      display: none;
    }
    .sello {
      animation: none;
    }
  }
</style>

<script>
  // Lee el resumen que dejó la agenda. Nada de esto viaja en la URL.
  type Resumen = { nombre?: string; juego?: string; fecha?: string; horario?: string; lugar?: string; total?: string; whatsapp?: string };
  const texto = (sel: string, t: string) => {
    const el = document.querySelector<HTMLElement>(sel);
    if (el) el.textContent = t;
  };
  const leer = <T,>(clave: string): T | null => {
    try {
      return JSON.parse(sessionStorage.getItem(clave) ?? "null") as T | null;
    } catch {
      return null;
    }
  };

  // Después del formulario de contacto: otro mensaje y sin resumen de reserva.
  const esConsulta = new URLSearchParams(location.search).get("tipo") === "consulta";
  if (esConsulta) {
    const c = leer<{ nombre?: string }>("saltabum:consulta");
    if (c?.nombre) texto("[data-gracias-nombre]", `, ${c.nombre}`);
    texto("[data-gracias-eyebrow]", "Consulta recibida");
    texto("[data-gracias-titulo]", "Recibimos tu mensaje");
    texto("[data-gracias-bajada]", "Te respondemos hoy mismo por WhatsApp o por teléfono. Si te urge, escríbenos directo");
    texto("[data-gracias-cta]", "Escríbenos por WhatsApp");
    document.title = "¡Consulta recibida! | Saltabum";
  }

  const r = esConsulta ? null : leer<Resumen>("saltabum:reserva");
  if (r) {
    const nombre = document.querySelector<HTMLElement>("[data-gracias-nombre]");
    if (nombre && r.nombre) nombre.textContent = `, ${r.nombre}`;
    for (const clave of ["juego", "fecha", "horario", "lugar", "total"] as const) {
      const el = document.querySelector<HTMLElement>(`[data-gracias="${clave}"]`);
      if (el && r[clave]) el.textContent = r[clave];
    }
    const resumen = document.querySelector<HTMLElement>("[data-gracias-resumen]");
    if (resumen && r.fecha && r.horario) resumen.hidden = false;
    const wa = document.querySelector<HTMLAnchorElement>("main a[data-track]");
    if (wa && r.whatsapp) {
      const url = new URL(wa.href);
      url.search = `?text=${encodeURIComponent(r.whatsapp)}`;
      wa.href = url.toString();
    }
  }
</script>
