---
// /ver-en-tu-espacio/<inflable>/ — a donde lleva el QR de cada inflable (el de «¿Cabe en tu espacio?» y el impreso).
// Pensada para el celular: el modelo 3D carga de inmediato y el botón grande «Verlo en tu espacio» abre la cámara
// (WebXR o Scene Viewer en Android, Quick Look en iPhone) para poner el juego en el suelo a tamaño real. Si el celular
// no lo permite, se avisa y queda el 3D. Abajo, enlaces a la misma página de los otros juegos.
import { getImage } from "astro:assets";
import { CAMARA, INFLABLES, base, metros, verEnTuEspacio, type Inflable } from "../inflables";
import Icon from "../components/Icon.astro";
import WaButton from "../components/WaButton.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  inflable: Inflable;
}
const { inflable: i } = Astro.props;
const otros = INFLABLES.filter((o) => o.id !== i.id);

const poster = await getImage({ src: i.fotos[0].src, width: 900, height: 900, fit: "cover", position: "center", format: "webp", quality: 78 });
const PASOS = [
  "Ve al lugar del evento, toca «Verlo en tu espacio» y permite usar la cámara",
  "Apunta al suelo, mueve el celular despacio y retrocede unos 10 metros para ver el juego completo",
  `El recuadro blanco en el suelo marca el espacio libre que necesita y la flecha amarilla marca el frente, donde baja el tobogán`,
];
---

<div class="bg-celeste text-noche flex min-h-dvh flex-col">
  <header class="border-noche bg-sol border-b-2">
    <div class="mx-auto flex max-w-[720px] items-center justify-between gap-3 px-4 py-2.5">
      <a href="/" class="no-underline" aria-label="Saltabum y Entretenciones, inicio">
        <Wordmark class="text-[26px]" />
      </a>
      <a href={i.ruta} class="text-noche inline-flex min-h-11 items-center text-sm font-extrabold underline">Medidas y precio</a>
    </div>
  </header>

  <main class="mx-auto flex w-full max-w-[720px] flex-1 flex-col gap-4 px-4 pt-5 pb-8">
    <div>
      <p class="text-xs font-extrabold tracking-[1.2px] uppercase">Realidad aumentada</p>
      <h1 class="font-display mt-1 text-[32px] leading-9 font-semibold">Mira el {i.nombre} en tu espacio</h1>
      <p class="mt-1.5">A tamaño real, {base(i)} de base y {metros(i.medidas.alto)} m de alto, con la cámara de tu celular</p>
    </div>

    <div class="border-noche bg-blanco shadow-pop-l relative overflow-hidden rounded-[28px] border-2">
      <model-viewer
        data-visor-espacio
        src={i.modelo}
        poster={poster.src}
        alt={`Modelo 3D del ${i.nombre} a tamaño real`}
        loading="eager"
        reveal="auto"
        camera-controls
        touch-action="pan-y"
        auto-rotate
        auto-rotate-delay="1200"
        rotation-per-second="18deg"
        shadow-intensity="1"
        exposure="1.05"
        camera-orbit={i.camara ?? CAMARA}
        ar
        ar-modes="webxr scene-viewer quick-look"
        ar-scale="fixed"
        ar-placement="floor"
        class="block h-[min(58dvh,520px)] w-full bg-[radial-gradient(circle_at_50%_40%,#fff6ea_0%,#f3e6d3_100%)]"
      >
        <button
          slot="ar-button"
          type="button"
          class="bounce bg-verde border-noche shadow-pop absolute bottom-4 left-1/2 inline-flex min-h-15 -translate-x-1/2 cursor-pointer items-center gap-2.5 rounded-full border-2 px-7 text-lg font-extrabold whitespace-nowrap"
        >
          <Icon name="despacho" size={24} />
          Verlo en tu espacio
        </button>
      </model-viewer>
      <p data-cargando class="bg-crema/90 text-noche-suave pointer-events-none absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-bold">
        Cargando el modelo 3D…
      </p>
    </div>

    <!-- Se muestra si el celular o el navegador no permiten la realidad aumentada. -->
    <div data-sin-ar hidden class="border-noche bg-crema rounded-[20px] border-2 p-4">
      <p class="font-extrabold">Este dispositivo no permite verlo con la cámara</p>
      <p class="text-noche-suave mt-1 text-[15px] leading-[21px]">
        Funciona en iPhone y en la mayoría de los Android. Mientras, puedes girarlo en 3D arriba o mandarnos una foto del lugar y te decimos si cabe
      </p>
    </div>

    <ol class="flex flex-col gap-2.5">
      {
        PASOS.map((p, i) => (
          <li class="flex items-start gap-3">
            <span class="border-noche bg-sol font-display flex size-8 shrink-0 items-center justify-center rounded-full border-2 font-bold">{i + 1}</span>
            <span class="pt-1 leading-[22px] font-semibold">{p}</span>
          </li>
        ))
      }
    </ol>

    <WaButton
      placement="ver-en-tu-espacio"
      size="l"
      message={`Hola, quiero saber si el ${i.nombre} cabe en el lugar de mi evento. Les mando una foto. Vengo de saltabum.cl`}
      class="mt-1 text-center leading-[22px]"
    >
      ¿Dudas? Mándanos una foto del lugar
    </WaButton>

    <nav aria-label="Ver otro juego en tu espacio" class="flex flex-col gap-2">
      <p class="text-sm font-extrabold">Ver otro juego en tu espacio</p>
      <div class="flex gap-2">
        {
          otros.map((o) => (
            <a
              href={verEnTuEspacio(o)}
              class="border-noche bg-blanco text-noche inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full border-2 px-3 text-center text-[15px] font-extrabold no-underline"
            >
              <Icon name={o.icono} size={22} strokeWidth={2.2} class="shrink-0" />
              {o.corto}
            </a>
          ))
        }
      </div>
    </nav>
  </main>
</div>

<script>
  import "@google/model-viewer";

  // Avisa si no hay realidad aumentada y quita el «cargando» cuando el modelo está listo.
  const visor = document.querySelector<HTMLElement & { canActivateAR?: boolean }>("[data-visor-espacio]");
  visor?.addEventListener("load", () => {
    document.querySelector("[data-cargando]")?.remove();
    // model-viewer decide si hay realidad aumentada un instante después de cargar el modelo.
    setTimeout(() => {
      if (!visor.canActivateAR) document.querySelector<HTMLElement>("[data-sin-ar]")?.removeAttribute("hidden");
    }, 400);
  });
</script>
