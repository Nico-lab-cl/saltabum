---
// /inflables/ — catálogo de juegos inflables: una tarjeta por inflable (src/design/inflables.ts) y la tabla para compararlos.
import { DESDE, DESDE_HORAS, HORA_EXTRA } from "../data";
import { INFLABLES, edadTexto, espacioTexto, medidas, pesos, type Inflable } from "../inflables";
import { COMUNAS_SEO } from "../seo";
import CtaFinal from "../components/CtaFinal.astro";
import HeroInterior from "../components/HeroInterior.astro";
import Icon from "../components/Icon.astro";
import Seccion from "../components/Seccion.astro";
import TarjetaInflable from "../components/TarjetaInflable.astro";
import Videos from "../sections/Videos.astro";
import WaButton from "../components/WaButton.astro";
import PaginaSeo, { type Miga } from "../layouts/PaginaSeo.astro";

interface Props {
  migas: Miga[];
}
const { migas } = Astro.props;

/** Filas de la tabla comparativa. La última es el precio. */
const COMPARAR: { t: string; v: (i: Inflable) => string; destacar?: boolean }[] = [
  { t: "Medidas (largo × ancho × alto)", v: medidas },
  { t: "Espacio libre que necesita", v: espacioTexto, destacar: true },
  { t: "Capacidad máxima", v: (i) => `${i.capacidad} niños` },
  { t: "Edad recomendada", v: edadTexto },
  { t: "Zonas de juego", v: (i) => i.caracteristicas.join(", ") },
  { t: "Pasto, cemento o interior", v: () => "Sí, los tres" },
  { t: `Precio por ${DESDE_HORAS}`, v: (i) => pesos(i.precio) },
];

const INCLUYE = [
  { icon: "despacho", t: "Despacho a la V Región", d: "Gratis en Valparaíso y Viña del Mar, $5.000 a Concón, Quilpué y Villa Alemana" },
  { icon: "estrella", t: "Calidad en nuestros juegos", d: "Inflables en buen estado, revisados antes de cada evento" },
  { icon: "calendario", t: "+15 eventos en la V Región", d: "Cumpleaños, colegios y empresas que ya saltaron con nosotros" },
  { icon: "puntual", t: `${DESDE_HORAS} de juego`, d: `Y cada hora adicional por ${HORA_EXTRA}` },
] as const;
---

<PaginaSeo migas={migas}>
  <HeroInterior
    eyebrow="Catálogo de inflables"
    titulo="Arriendo de juegos inflables en la V Región"
    bajada={`Juegos inflables para cumpleaños, colegios, empresas y eventos desde ${DESDE} por ${DESDE_HORAS}, con despacho, montaje y retiro incluidos`}
    destacado="V Región"
    placement="inflables-hero"
  />

  <Seccion titulo="Nuestros juegos inflables" eyebrow="Elige tu inflable" bajada="Cada juego tiene su ficha técnica con medidas, espacio que necesita, capacidad y edad" fondo="blanco">
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-7">
      {
        INFLABLES.map((i) => (
          <li>
            <TarjetaInflable inflable={i} placement="catalogo" />
          </li>
        ))
      }
    </ul>
  </Seccion>

  <Seccion titulo="Compara y elige según tu espacio" eyebrow="Ficha técnica" bajada="Mide tu patio o salón y revisa que quepa el juego con 1 metro de seguridad por lado" fondo="arena">
    <div class="border-noche bg-blanco shadow-pop-l overflow-x-auto rounded-[28px] border-2" role="region" aria-label="Tabla comparativa de inflables" tabindex="0">
      <table class="w-full min-w-[640px] text-left">
        <caption class="sr-only">Medidas, espacio, capacidad, edad y precio de cada inflable</caption>
        <thead>
          <tr class="border-noche border-b-2">
            <td class="w-[26%] p-4 lg:px-6"></td>
            {INFLABLES.map((i) => <th scope="col" class="font-display p-4 text-lg leading-6 font-semibold lg:px-6 lg:text-xl">{i.nombre}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            COMPARAR.map((fila, n) => (
              <tr class:list={["border-arena border-b-2 last:border-b-0", fila.destacar && "bg-crema"]}>
                <th scope="row" class="p-4 font-bold lg:px-6">{fila.t}</th>
                {INFLABLES.map((i) => <td class:list={["p-4 lg:px-6", fila.destacar && "font-extrabold", n === COMPARAR.length - 1 && "font-display text-xl font-bold"]}>{fila.v(i)}</td>)}
              </tr>
            ))
          }
          <tr>
            <td class="p-4 lg:px-6"><span class="sr-only">Ficha</span></td>
            {
              INFLABLES.map((i) => (
                <td class="p-4 lg:px-6">
                  <a href={i.ruta} class="text-azul-texto inline-flex min-h-11 items-center font-extrabold underline">Ver ficha técnica</a>
                </td>
              ))
            }
          </tr>
        </tbody>
      </table>
    </div>
    <div class="border-noche bg-azul shadow-pop-l flex flex-col gap-4 rounded-[28px] border-2 p-5 md:flex-row md:items-center md:justify-between lg:p-8">
      <div>
        <p class="font-display text-[26px] leading-8 font-semibold lg:text-3xl">¿No sabes si cabe en tu patio?</p>
        <p class="mt-1 font-semibold">Mándanos una foto con las medidas y te decimos cuál conviene</p>
      </div>
      <WaButton placement="catalogo-comparar" size="l" message="Hola, quiero saber qué inflable cabe en mi patio, te mando una foto. Vengo de saltabum.cl" class="shrink-0">
        Enviar foto por WhatsApp
      </WaButton>
    </div>
  </Seccion>

  <Videos />

  <Seccion titulo="Qué incluye el arriendo" fondo="arena">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        INCLUYE.map((i) => (
          <li class="border-noche bg-blanco flex flex-col gap-2 rounded-[20px] border-2 p-5">
            <Icon name={i.icon} size={30} />
            <strong class="text-lg leading-6 font-extrabold">{i.t}</strong>
            <span class="text-noche-suave">{i.d}</span>
          </li>
        ))
      }
    </ul>
  </Seccion>

  <Seccion titulo="Arriendo de juegos inflables por comuna" bajada="Llevamos los inflables a toda la Región de Valparaíso" fondo="crema">
    <ul class="flex flex-wrap gap-2.5">
      {
        COMUNAS_SEO.map((c) => (
          <li>
            <a href={`/juegos-inflables-${c.slug}/`} class="border-noche bg-blanco text-noche inline-flex min-h-12 items-center rounded-full border-2 px-5 font-bold no-underline hover:bg-sol">
              Juegos inflables en {c.titulo}
            </a>
          </li>
        ))
      }
    </ul>
  </Seccion>

  <CtaFinal placement="inflables-cta" />
</PaginaSeo>
