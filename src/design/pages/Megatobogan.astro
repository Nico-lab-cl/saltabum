---
// /inflables/megatobogan-arcoiris/ — ficha completa del producto con galería, medidas y modelo 3D.
import { DESDE, DESDE_HORAS, PRODUCTO } from "../data";
import type { Pregunta } from "../seo";
import CtaFinal from "../components/CtaFinal.astro";
import HeroInterior from "../components/HeroInterior.astro";
import ListaPreguntas from "../components/ListaPreguntas.astro";
import Seccion from "../components/Seccion.astro";
import PaginaSeo, { type Miga } from "../layouts/PaginaSeo.astro";
import Agenda from "../sections/Agenda.astro";
import Ficha from "../sections/Ficha.astro";
import Patio from "../sections/Patio.astro";

interface Props {
  migas: Miga[];
  preguntas: Pregunta[];
}
const { migas, preguntas } = Astro.props;
---

<PaginaSeo migas={migas}>
  <HeroInterior
    eyebrow="Tobogán inflable"
    titulo={`Arriendo del ${PRODUCTO.nombre}, tobogán inflable grande`}
    bajada={`Tobogán inflable doble con túneles y arcos para niños de ${PRODUCTO.edad}, de ${PRODUCTO.base} y ${PRODUCTO.alto} de alto, desde ${DESDE} por ${DESDE_HORAS}`}
    destacado={PRODUCTO.nombre}
    placement="megatobogan-hero"
    mensaje={`Hola, quiero consultar la disponibilidad del ${PRODUCTO.nombre}. Vengo de saltabum.cl`}
  />
  <Ficha />
  <Patio />
  <Agenda />
  <Seccion titulo={`Preguntas sobre el ${PRODUCTO.nombre}`} fondo="crema">
    <ListaPreguntas preguntas={preguntas} grupo="faq-megatobogan" />
  </Seccion>
  <CtaFinal placement="megatobogan-cta" />
</PaginaSeo>
