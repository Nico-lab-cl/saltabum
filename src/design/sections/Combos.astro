---
import { Image } from "astro:assets";
import foto from "../assets/megatobogan-arcoiris.webp";
import { PRODUCTO } from "../data";
import FotoPendiente from "../components/FotoPendiente.astro";
import Lobes from "../components/Lobes.astro";
import WaButton from "../components/WaButton.astro";
---

<Lobes color="#FF6FAE" side="top" />
<section id="combos" aria-labelledby="combos-titulo" class="bg-rosa">
  <div class="mx-auto max-w-[1320px] px-4 pt-7 pb-10 lg:px-10 lg:pt-14 lg:pb-16">
    <h2 id="combos-titulo" class="font-display text-[32px] leading-9 font-semibold lg:text-5xl lg:leading-[52px]">
      Combos para el cumpleaños completo
    </h2>
    <p class="mt-1.5 mb-6 lg:mb-8">Un solo despacho, más juegos, mejor precio.</p>

    <div class="flex flex-col gap-6 lg:flex-row lg:gap-7">
      <article class="border-noche bg-blanco shadow-pop relative flex flex-col overflow-hidden rounded-[20px] border-2 lg:flex-1 lg:flex-row lg:rounded-[28px] lg:shadow-pop-l">
        <span class="bg-sol border-noche absolute top-2.5 right-2.5 z-10 rotate-4 rounded-full border-2 px-3 py-1 text-sm font-extrabold lg:top-3.5 lg:right-auto lg:left-3.5 lg:-rotate-4 lg:text-[15px]">
          Ahorras $[X.XXX]
        </span>
        <div class="border-noche grid h-[150px] grid-cols-2 border-b-2 lg:h-auto lg:min-h-60 lg:flex-1 lg:border-r-2 lg:border-b-0">
          <Image src={foto} alt={PRODUCTO.nombre} widths={[300, 500]} sizes="(min-width: 1024px) 260px, 46vw" class="border-noche size-full border-r-2 object-cover object-[50%_52%]" />
          <FotoPendiente texto="taca-taca" />
        </div>
        <div class="flex flex-col gap-2.5 p-4 lg:flex-1 lg:gap-3 lg:p-6">
          <h3 class="font-display text-[22px] leading-[26px] font-semibold lg:text-[26px] lg:leading-[30px]">Megatobogán + Taca-taca</h3>
          <p class="text-noche-suave text-[15px]">Para los chicos y los grandes. 4 horas.</p>
          <div class="mt-auto flex items-center justify-between gap-3 lg:flex-col lg:items-stretch">
            <p class="text-noche-suave text-sm"><s>$[XX.XXX]</s> <strong class="font-display text-noche text-2xl font-bold lg:text-3xl">$[XX.XXX]</strong></p>
            <WaButton placement="combo" size="s" icon={false} message="Hola, quiero consultar el combo Megatobogán + Taca-taca. Vengo de saltabum.cl">Consultar combo</WaButton>
          </div>
        </div>
      </article>

      <article class="border-noche bg-blanco shadow-pop relative flex flex-col overflow-hidden rounded-[20px] border-2 lg:flex-1 lg:flex-row lg:rounded-[28px] lg:shadow-pop-l">
        <span class="bg-sol border-noche absolute top-2.5 right-2.5 z-10 -rotate-3 rounded-full border-2 px-3 py-1 text-sm font-extrabold lg:top-3.5 lg:right-auto lg:left-3.5 lg:rotate-3 lg:text-[15px]">
          Ahorras $[X.XXX]
        </span>
        <div class="border-noche grid h-[120px] grid-cols-3 border-b-2 lg:h-auto lg:min-h-60 lg:flex-1 lg:border-r-2 lg:border-b-0">
          <FotoPendiente texto="inflable" class="border-noche border-r-2" />
          <FotoPendiente texto="cama elástica" class="border-noche border-r-2" />
          <FotoPendiente texto="arcade" />
        </div>
        <div class="flex flex-col gap-2.5 p-4 lg:flex-1 lg:gap-3 lg:p-6">
          <h3 class="font-display text-[22px] leading-[26px] font-semibold lg:text-[26px] lg:leading-[30px]">Inflable + Cama elástica + Arcade</h3>
          <p class="text-noche-suave text-[15px]">El cumpleaños completo, resuelto. 4 horas.</p>
          <div class="mt-auto flex items-center justify-between gap-3 lg:flex-col lg:items-stretch">
            <p class="text-noche-suave text-sm"><s>$[XX.XXX]</s> <strong class="font-display text-noche text-2xl font-bold lg:text-3xl">$[XX.XXX]</strong></p>
            <WaButton placement="combo" size="s" icon={false} message="Hola, quiero consultar el combo Inflable + Cama elástica + Arcade. Vengo de saltabum.cl">Consultar combo</WaButton>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
<Lobes color="#FF6FAE" side="bottom" />
