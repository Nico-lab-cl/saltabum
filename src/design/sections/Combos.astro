---
// Combos: varios juegos en un solo despacho. Los combos concretos y sus precios están por confirmar con Saltabum.
import { PRODUCTO } from "../data";
import Icon from "../components/Icon.astro";
import WaButton from "../components/WaButton.astro";

const MENSAJE = "Hola, quiero armar un combo de inflables para mi evento. Vengo de saltabum.cl";
const VENTAJAS = [
  "Un solo despacho, montaje y retiro para todo",
  "Mejor precio que arrendar cada juego por separado",
  "Entretención para todas las edades al mismo tiempo",
];
const EJEMPLOS = [
  { titulo: `${PRODUCTO.nombre} + Plaza blanda`, texto: "Los grandes saltan y las guaguas juegan seguras." },
  { titulo: "Plaza blanda + Piscina de pelotas", texto: "La primera infancia completa, en colores suaves." },
  { titulo: "[Combo por confirmar]", texto: "[Otra combinación que ofrezca Saltabum]." },
];
---

<section id="combos" aria-labelledby="combos-titulo" class="border-noche bg-celeste border-b-2">
  <div class="mx-auto flex max-w-[1320px] flex-col gap-6 px-4 py-10 lg:gap-10 lg:px-10 lg:py-20">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-xs font-extrabold tracking-[1.2px] uppercase">Combos</p>
        <h2 id="combos-titulo" class="font-display mt-1.5 text-[34px] leading-[38px] font-semibold lg:text-5xl lg:leading-[52px]">
          Arma tu combo de entretención
        </h2>
      </div>
      <ul class="flex flex-col gap-1.5 font-semibold lg:items-end">
        {
          VENTAJAS.map((v) => (
            <li class="flex items-center gap-2">
              <Icon name="check" size={20} strokeWidth={3} class="shrink-0" />
              {v}
            </li>
          ))
        }
      </ul>
    </div>
    <ul class="flex flex-col gap-3.5 lg:grid lg:grid-cols-3 lg:gap-5">
      {
        EJEMPLOS.map((c) => (
          <li class="border-noche bg-blanco shadow-pop flex flex-col gap-2 rounded-[20px] border-2 p-4 lg:rounded-3xl lg:p-6">
            <h3 class="font-display text-[22px] leading-[26px] font-semibold">{c.titulo}</h3>
            <p class="text-noche-suave">{c.texto}</p>
            <p class="mt-auto pt-2 font-extrabold">$[XX.XXX] · 4 horas</p>
          </li>
        ))
      }
    </ul>
    <WaButton placement="combo" size="l" message={MENSAJE} class="text-center leading-[22px] lg:self-start">Cotizar mi combo</WaButton>
  </div>
</section>
