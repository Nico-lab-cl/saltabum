---
// Barra superior fija. Escritorio (xl): logo, secciones, botón Contacto, WhatsApp, llamar y redes sociales
// (llamar y redes se ven desde lg).
// Celular y tablet: logo, redes sociales y menú (WhatsApp y llamar van en la barra fija de abajo, StickyBar);
// dentro del menú van las secciones, Contacto y llamar. Desde sm también se ve el botón Contacto.
import { PUBLIC_WHATSAPP_NUMBER } from "astro:env/client";
import Icon from "../components/Icon.astro";
import Redes from "../components/Redes.astro";
import WaButton from "../components/WaButton.astro";
import Wordmark from "../components/Wordmark.astro";
import { NAV, RUTAS } from "../seo";

const telefono = (PUBLIC_WHATSAPP_NUMBER ?? "").replace(/\D/g, "");
const actual = Astro.url.pathname;
---

<header class="border-noche bg-sol text-noche sticky top-0 z-40 border-b-2">
  <div class="mx-auto flex max-w-[1400px] items-center gap-2 px-4 py-2.5 sm:gap-3 lg:px-8 lg:py-3 2xl:gap-5">
    <a href="/" class="shrink-0 no-underline" aria-label="Saltabum y Entretenciones, inicio">
      <Wordmark class="text-[25px] min-[380px]:text-[27px] lg:text-[32px]" />
    </a>

    <nav aria-label="Principal" class="hidden flex-1 justify-center gap-4 xl:flex 2xl:gap-6">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={actual === item.href ? "page" : undefined}
            class="text-noche hover:border-noche aria-[current=page]:border-noche border-b-[3px] border-transparent py-2.5 text-[15px] font-bold whitespace-nowrap no-underline 2xl:text-base"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 xl:ml-0">
      <!-- Celular y tablet: redes (WhatsApp y llamar van en la barra fija de abajo) -->
      <Redes class="gap-1.5 lg:hidden" />
      <a
        href={RUTAS.contacto}
        aria-current={actual === RUTAS.contacto ? "page" : undefined}
        class="bounce border-noche bg-blanco text-noche shadow-pop-s aria-[current=page]:bg-noche aria-[current=page]:text-crema hidden min-h-11 items-center gap-2 rounded-full border-2 px-4 font-extrabold whitespace-nowrap no-underline md:inline-flex"
      >
        <Icon name="correo" size={19} strokeWidth={2.2} />
        Contacto
      </a>

      <WaButton placement="header" size="s" class="whitespace-nowrap max-lg:hidden">WhatsApp</WaButton>

      <!-- Desde lg: llamar y redes -->
      <div class="hidden items-center gap-1.5 lg:flex">
        {
          telefono && (
            <a
              href={`tel:+${telefono}`}
              aria-label="Llamar a Saltabum"
              title="Llamar"
              class="bounce border-noche bg-blanco text-noche flex size-11 items-center justify-center rounded-full border-2 no-underline"
            >
              <Icon name="telefono" size={20} />
            </a>
          )
        }
        <Redes class="gap-1.5" />
      </div>

      <details class="group relative xl:hidden">
        <summary
          class="border-noche bg-blanco text-noche flex size-11 cursor-pointer list-none items-center justify-center rounded-full border-2 [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú"
        >
          <Icon name="menu" size={22} strokeWidth={2.4} class="group-open:hidden" />
          <Icon name="cerrar" size={22} strokeWidth={2.4} class="hidden group-open:block" />
        </summary>
        <nav
          aria-label="Principal"
          class="border-noche bg-crema shadow-pop absolute top-14 right-0 flex max-h-[calc(100dvh-80px)] w-[min(288px,calc(100vw-32px))] flex-col overflow-y-auto rounded-[20px] border-2 p-2"
        >
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={actual === item.href ? "page" : undefined}
                class="text-noche hover:bg-arena aria-[current=page]:bg-sol rounded-xl px-4 py-3 font-bold no-underline"
              >
                {item.label}
              </a>
            ))
          }
          <a href={RUTAS.contacto} class="bg-noche text-crema mt-1 flex items-center gap-2 rounded-xl px-4 py-3 font-extrabold no-underline">
            <Icon name="correo" size={19} strokeWidth={2.2} />
            Contacto
          </a>
          {
            telefono && (
              <a href={`tel:+${telefono}`} class="text-noche hover:bg-arena flex items-center gap-2 rounded-xl px-4 py-3 font-bold no-underline">
                <Icon name="telefono" size={19} />
                Llamar
              </a>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Cierra el menú mobile al elegir una sección.
  document.querySelectorAll<HTMLDetailsElement>("header details").forEach((menu) => {
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (menu.open = false)));
  });
</script>
