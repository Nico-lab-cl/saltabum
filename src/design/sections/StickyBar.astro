---
// Barra fija inferior (solo mobile). Se esconde mientras el formulario de contacto o la reserva están en pantalla.
import { PUBLIC_WHATSAPP_NUMBER } from "astro:env/client";
import Icon from "../components/Icon.astro";
import WaButton from "../components/WaButton.astro";

const telefono = (PUBLIC_WHATSAPP_NUMBER ?? "").replace(/\D/g, "");
---

<nav
  aria-label="Contacto rápido"
  data-sticky-bar
  class="border-noche bg-crema fixed inset-x-0 bottom-0 z-30 flex gap-2.5 border-t-2 px-4 pt-3 pb-[max(16px,env(safe-area-inset-bottom))] transition-transform duration-200 data-[oculta]:translate-y-full motion-reduce:transition-none lg:hidden"
>
  <WaButton placement="sticky" size="m" class="flex-1">WhatsApp</WaButton>
  {
    telefono && (
      <a
        href={`tel:+${telefono}`}
        class="bounce border-noche bg-blanco text-noche inline-flex min-h-13 items-center gap-1.5 rounded-full border-2 px-4.5 font-extrabold no-underline"
      >
        <Icon name="telefono" size={20} />
        Llamar
      </a>
    )
  }
</nav>

<script>
  // Se esconde mientras un formulario (contacto o reserva) está en pantalla, para no tapar sus botones.
  const bar = document.querySelector<HTMLElement>("[data-sticky-bar]");
  const forms = document.querySelectorAll("[data-lead-form], [data-reserva]");
  if (bar && forms.length) {
    const visibles = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)));
        bar.toggleAttribute("data-oculta", visibles.size > 0);
      },
      { threshold: 0.15 },
    );
    forms.forEach((f) => observer.observe(f));
  }
</script>
