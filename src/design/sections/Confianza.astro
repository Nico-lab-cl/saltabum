---
// Franja de confianza bajo el hero: los 2 valores de Saltabum como sellos grandes (estilo sticker, un poco girados) sobre
// noche con confeti. Al pasar el mouse se enderezan con el rebote de la marca.
import Icon from "../components/Icon.astro";

const CONFETI = [
  { c: "#ffc23a", x: "6%", y: "18%", s: 10 },
  { c: "#ff6fae", x: "18%", y: "78%", s: 8 },
  { c: "#7fd3f7", x: "47%", y: "12%", s: 9 },
  { c: "#2db866", x: "52%", y: "86%", s: 7 },
  { c: "#ff8a1f", x: "83%", y: "20%", s: 10 },
  { c: "#8e5be8", x: "94%", y: "72%", s: 8 },
];
const sello =
  "border-noche text-noche shadow-pop-l relative flex min-w-0 flex-col gap-2 rounded-[28px] border-2 p-4 transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:rotate-0 hover:-translate-y-1 motion-reduce:transition-none lg:flex-row lg:items-center lg:gap-6 lg:rounded-[36px] lg:p-7";
---

<section aria-label="Por qué elegir Saltabum" class="bg-noche text-crema relative isolate overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    {CONFETI.map((p) => <span class="absolute rounded-full" style={`left:${p.x};top:${p.y};width:${p.s}px;height:${p.s}px;background:${p.c}`} />)}
  </div>
  <ul class="mx-auto grid max-w-[1100px] grid-cols-2 gap-3 px-4 py-7 lg:gap-10 lg:px-10 lg:py-12">
    <li class:list={[sello, "bg-celeste -rotate-2"]}>
      <span class="font-display shrink-0 text-[52px] leading-[52px] font-bold tracking-tight lg:text-[96px] lg:leading-[96px]">+15</span>
      <span class="flex flex-col gap-1">
        <strong class="font-display text-[18px] leading-[22px] font-semibold lg:text-[28px] lg:leading-8">eventos en la V Región</strong>
        <span class="text-[13px] leading-[18px] font-semibold lg:text-base lg:leading-6">Cumpleaños, colegios y empresas ya saltaron con nosotros</span>
      </span>
    </li>
    <li class:list={[sello, "bg-sol rotate-2"]}>
      <span class="border-noche bg-blanco flex size-14 shrink-0 items-center justify-center rounded-full border-2 lg:size-24">
        <Icon name="estrella" size={30} strokeWidth={2.2} class="lg:size-12" />
      </span>
      <span class="flex flex-col gap-1">
        <strong class="font-display text-[18px] leading-[22px] font-semibold lg:text-[28px] lg:leading-8">Calidad en nuestros juegos</strong>
        <span class="text-[13px] leading-[18px] font-semibold lg:text-base lg:leading-6">Inflables limpios y revisados antes de cada evento</span>
      </span>
    </li>
  </ul>
</section>
