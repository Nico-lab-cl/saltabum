---
// Línea Primera Infancia: plaza blanda y piscina de pelotas en colores suaves (moca, rosa empolvado, salvia).
import ImagenPendiente from "../components/ImagenPendiente.astro";
import WaButton from "../components/WaButton.astro";

const MENSAJE = "Hola, quiero consultar la plaza blanda y piscina de pelotas para un primer cumpleaños. Vengo de saltabum.cl";
---

<section id="primera-infancia" aria-labelledby="pastel-titulo" class="border-noche bg-rosa-empolvado border-b-2">
  <div class="mx-auto flex max-w-[1320px] flex-col gap-5 px-4 py-10 lg:flex-row lg:items-center lg:gap-14 lg:px-10 lg:py-20">
    <div class="flex flex-col gap-4 lg:flex-1">
      <p class="bg-crema self-start rounded-full px-3 py-1 text-xs font-extrabold tracking-[1.2px] uppercase">Primera infancia · 1 a 4 años</p>
      <h2 id="pastel-titulo" class="font-display text-[34px] leading-[38px] font-semibold lg:text-5xl lg:leading-[52px]">
        Su primer cumpleaños, para la foto
      </h2>
      <p class="max-w-[480px] lg:text-lg">
        Plaza blanda y piscina de pelotas en moca, rosa empolvado y salvia: segura para guaguas de 1 a 4 años y en colores que
        combinan con tu decoración.
      </p>
      <ul class="flex flex-wrap gap-2">
        <li class="bg-moca border-noche rounded-full border-2 px-3.5 py-1.5 font-bold">Plaza blanda</li>
        <li class="bg-salvia border-noche rounded-full border-2 px-3.5 py-1.5 font-bold">Piscina de pelotas</li>
        <li class="bg-crema border-noche rounded-full border-2 px-3.5 py-1.5 font-bold">Desde $[XX.XXX] · 4 horas</li>
      </ul>
      <WaButton placement="primera-infancia" size="l" message={MENSAJE} class="text-center leading-[22px] lg:self-start">
        Consultar primera infancia
      </WaButton>
    </div>
    <ImagenPendiente
      n={14}
      ratio="4:3"
      texto="Plaza blanda y piscina de pelotas en moca, rosa empolvado y salvia, armadas para un primer cumpleaños"
      class="bg-crema aspect-[4/3] rounded-[28px] lg:flex-1"
    />
  </div>
</section>
