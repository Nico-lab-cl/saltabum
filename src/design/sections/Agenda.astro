---
// Agenda de reservas por pasos: 1) día en el calendario (se puede si al menos un inflable tiene horario), 2) juego,
// duración y hora de inicio (cada 30 minutos entre 09:00 y 22:00; cada inflable tiene su propia disponibilidad),
// 3) comuna y dirección, 4) datos de contacto. Todos los pasos ocupan el mismo alto (se apilan en la misma
// celda de la grilla, así el bloque mide lo que el paso más alto y no salta al avanzar). El total queda siempre a la
// vista: en el pie en celular y en el resumen lateral en escritorio.
// Reglas y precios: src/lib/reservas.ts. Datos y envío: src/lib/client/reservas.ts.
import WhatsAppLink from "@/components/core/WhatsAppLink.astro";
import { APERTURA, CIERRE, HORAS_BASE, HORAS_EXTRA_MAX, REGION, aHora, pesos } from "@/lib/reservas";
import { ABONO, COMUNAS, HORA_EXTRA, PRODUCTOS } from "../data";
import { INFLABLES } from "../inflables";
import Icon from "../components/Icon.astro";
import Rayos from "../components/Rayos.astro";
import WaButton from "../components/WaButton.astro";
import TituloSeccion from "../components/TituloSeccion.astro";

const DIAS_SEMANA = ["L", "M", "M", "J", "V", "S", "D"];
const PASOS = [
  { id: "fecha", nombre: "Fecha" },
  { id: "horario", nombre: "Horario" },
  { id: "comuna", nombre: "Lugar" },
  { id: "datos", nombre: "Tus datos" },
] as const;
const variosJuegos = PRODUCTOS.length > 1;

interface Props {
  /** Juego que aparece elegido al abrir la agenda (en la página de cada inflable). */
  juego?: string;
}
const { juego = PRODUCTOS[0].id } = Astro.props;

/** Casilla de formulario con la etiqueta adentro, arriba y en chico (como un checkout). */
const caja =
  "border-noche bg-crema relative flex min-h-14 min-w-0 cursor-text flex-col justify-center rounded-xl border-2 px-3.5 py-1.5 focus-within:outline-3 focus-within:outline-offset-2 focus-within:outline-azul-texto has-[:user-invalid]:border-rojo-texto";
const cajaEtiqueta = "text-noche-suave text-xs leading-4 font-bold";
const cajaInput =
  "text-noche placeholder:text-noche-suave/60 w-full min-w-0 bg-transparent text-base leading-6 outline-none focus-visible:outline-none";
const opcional = '<span class="font-semibold opacity-80">(opcional)</span>';
const etiqueta = "font-display text-[17px] leading-6 font-semibold lg:text-[19px]";
const tituloPaso = "font-display text-[22px] leading-7 font-semibold outline-none lg:text-[26px] lg:leading-8";
/** Cada paso va en la misma celda; el oculto queda invisible (sin perder su alto) e inerte. El que entra aparece suave. */
const capa =
  "col-start-1 row-start-1 flex min-w-0 flex-col gap-4 transition-[opacity,translate] duration-300 ease-out data-oculto:invisible data-oculto:translate-y-2 data-oculto:opacity-0 motion-reduce:transition-none";
const botonRedondo =
  "border-noche bg-crema flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-2 disabled:cursor-not-allowed disabled:opacity-30";
---

<section id="reservar" aria-labelledby="agenda-titulo" class="border-noche bg-sol text-noche relative isolate overflow-clip border-b-2" data-agenda>
  <Rayos x="78%" y="8%" />
  <div class="mx-auto flex max-w-[1320px] flex-col gap-4 px-4 py-8 lg:gap-9 lg:px-10 lg:py-20">
    <TituloSeccion id="agenda-titulo" eyebrow="Reserva en línea" titulo="Elige tu fecha y horario" bajada="Reserva en 4 pasos y con el total siempre a la vista" />

    <form
      data-reserva
      novalidate
      aria-label="Reserva en línea"
      class="group border-noche bg-blanco shadow-pop lg:shadow-pop-l grid overflow-clip rounded-[28px] border-2 lg:grid-cols-[minmax(0,1fr)_340px] xl:grid-cols-[minmax(0,1fr)_380px]"
    >
      <div class="flex min-w-0 flex-col">
        <!-- Pasos -->
        <ol data-stepper class="border-noche bg-crema grid grid-cols-4 border-b-2" aria-label="Pasos de la reserva">
          {
            PASOS.map((p, i) => (
              <li class:list={["min-w-0", i > 0 && "border-noche/15 border-l-2"]}>
                <button
                  type="button"
                  data-ir={p.id}
                  disabled={i > 0}
                  aria-current={i === 0 ? "step" : undefined}
                  class="group aria-[current=step]:bg-sol flex min-h-12 w-full cursor-pointer items-center justify-center gap-1.5 px-1 py-1.5 text-[12px] leading-4 font-extrabold disabled:cursor-default sm:gap-2 sm:text-sm lg:min-h-16 lg:text-[15px]"
                >
                  <span class="border-noche bg-blanco group-aria-[current=step]:bg-noche group-aria-[current=step]:text-crema group-data-hecho:bg-verde flex size-6 shrink-0 items-center justify-center rounded-full border-2 text-[12px] group-disabled:opacity-50 sm:size-7 sm:text-[13px]">
                    <span class="group-data-hecho:hidden">{i + 1}</span>
                    <Icon name="check" size={15} strokeWidth={3.2} class="hidden group-data-hecho:block" />
                  </span>
                  <span class="truncate group-disabled:opacity-60">{p.nombre}</span>
                </button>
              </li>
            ))
          }
        </ol>

        <!-- Escenario: los pasos apilados -->
        <div class="grid flex-1 p-3.5 sm:p-5 lg:p-7">
          <!-- 1 · Fecha -->
          <div data-paso="fecha" class={capa}>
            <h3 tabindex="-1" class={tituloPaso}>¿Qué día es tu evento?</h3>
            <div class="grid flex-1 content-between gap-3 lg:grid-cols-[minmax(0,1fr)_200px] lg:content-start lg:gap-6 xl:grid-cols-[minmax(0,1fr)_230px]">
              <div class="flex min-w-0 flex-col gap-2 lg:gap-3">
                <div class="flex items-center justify-between gap-3">
                  <button type="button" data-mes-anterior aria-label="Mes anterior" class={botonRedondo}>
                    <Icon name="flecha" size={20} strokeWidth={2.6} class="rotate-180" />
                  </button>
                  <p data-mes-titulo aria-live="polite" class="font-display text-[22px] leading-7 font-semibold first-letter:uppercase">&nbsp;</p>
                  <button type="button" data-mes-siguiente aria-label="Mes siguiente" class={botonRedondo}>
                    <Icon name="flecha" size={20} strokeWidth={2.6} />
                  </button>
                </div>
                <div class="grid grid-cols-7 gap-1.5 text-center" aria-hidden="true">
                  {DIAS_SEMANA.map((d) => <span class="text-noche-suave text-xs font-extrabold tracking-[1px]">{d}</span>)}
                </div>
                <div data-dias class="grid min-h-[260px] grid-cols-7 content-start gap-1 sm:min-h-[282px] sm:gap-1.5 lg:min-h-[318px]"></div>
                <p data-agenda-estado class="text-noche-suave text-sm">Cargando disponibilidad…</p>
              </div>
              <div class="flex flex-col gap-3 lg:pt-14">
                <ul class="flex flex-wrap gap-x-3 gap-y-1 text-[13px] lg:flex-col lg:gap-y-2 lg:text-sm" aria-label="Simbología">
                  <li class="flex items-center gap-2"><span class="border-noche bg-verde-burbuja size-4 rounded border-2"></span>Con horarios libres</li>
                  <li class="flex items-center gap-2"><span class="border-noche bg-sol size-4 rounded border-2"></span>Quedan pocos</li>
                  <li class="flex items-center gap-2"><span class="border-noche/30 bg-arena size-4 rounded border-2"></span>Sin horarios</li>
                </ul>
                <ul class="hidden flex-col gap-1.5 text-[13px] leading-5 font-semibold lg:flex lg:gap-2 lg:text-sm">
                  <li class="bg-crema flex items-start gap-2 rounded-xl px-3 py-2 lg:py-2.5"><Icon name="check" size={18} class="shrink-0" />El día se marca libre si al menos un inflable tiene horario</li>
                  <li class="bg-crema flex items-start gap-2 rounded-xl px-3 py-2 lg:py-2.5"><Icon name="despacho" size={18} class="shrink-0" />Despacho gratis en Viña y Valparaíso</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 2 · Horario -->
          <div data-paso="horario" data-oculto inert class={capa}>
            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5">
              <h3 tabindex="-1" class={tituloPaso}>¿Qué juego y a qué hora?</h3>
              <button type="button" data-ir="fecha" class="border-noche bg-crema inline-flex min-h-10 cursor-pointer items-center gap-2 rounded-full border-2 px-3 text-sm font-extrabold">
                <Icon name="calendario" size={17} />
                <span data-res="fecha-corta" class="first-letter:uppercase"></span>
                <span class="text-azul-texto underline">Cambiar</span>
              </button>
            </div>

            {
              variosJuegos ? (
                <fieldset class="min-w-0">
                  <legend class={`${etiqueta} mb-1.5`}>Juego</legend>
                  <div class="grid grid-cols-3 gap-2">
                    {INFLABLES.map((i) => (
                      <label class="border-noche has-checked:bg-noche has-checked:text-crema has-checked:shadow-sol bg-crema has-disabled:border-noche/25 has-disabled:bg-arena has-disabled:text-noche-suave flex min-h-[84px] min-w-0 cursor-pointer flex-col items-center justify-center gap-0.5 rounded-xl border-2 px-1 py-1.5 text-center has-disabled:cursor-not-allowed has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-azul-texto lg:flex-row lg:justify-start lg:gap-2.5 lg:px-3 lg:text-left">
                        <input type="radio" name="producto" value={i.id} checked={i.id === juego} class="sr-only" data-producto />
                        <Icon name={i.icono} size={26} strokeWidth={2.2} class="shrink-0" />
                        <span class="flex min-w-0 flex-col">
                          <span class="truncate text-[13px] leading-4 font-extrabold lg:text-[15px] lg:leading-5">{i.corto}</span>
                          <span class="text-xs leading-4 font-bold opacity-80 lg:text-[13px]">{pesos(i.precio)}</span>
                          <span data-juego-estado={i.id} class="text-[11px] leading-4 font-extrabold lg:text-xs">Elige un día</span>
                        </span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ) : (
                <input type="hidden" name="producto" value={PRODUCTOS[0].id} data-producto />
              )
            }
            <div class="bg-crema flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-2xl px-3.5 py-2">
              <div>
                <p class={etiqueta}>Duración</p>
                <p data-horas-extra class="text-noche-suave text-sm">Sin horas extra</p>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" data-menos aria-label="Una hora menos" class={`${botonRedondo} bg-blanco text-2xl font-extrabold`}>−</button>
                <p class="min-w-[74px] text-center" aria-live="polite">
                  <span data-horas class="font-display text-[26px] leading-8 font-bold">{HORAS_BASE}</span>
                  <span class="font-extrabold"> horas</span>
                </p>
                <button type="button" data-mas aria-label="Una hora más" class={`${botonRedondo} bg-blanco text-2xl font-extrabold`}>+</button>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <p class={etiqueta}>Hora de inicio</p>
              <div data-inicios role="group" aria-label="Hora de inicio" class="grid grid-cols-5 gap-1.5 min-[360px]:grid-cols-6 sm:gap-2 xl:grid-cols-7"></div>
              <p data-inicio-resumen aria-live="polite" class="text-noche-suave text-sm">Elige a qué hora quieres que esté listo el juego</p>
            </div>
            <WhatsAppLink
              placement="agenda-noche"
              message="Hola, mi evento dura toda la noche o pasa de las 22:00 y quiero cotizar un juego inflable. Vengo de saltabum.cl"
              class="border-noche/40 text-noche mt-auto flex min-h-11 items-center gap-2.5 rounded-xl border-2 border-dashed px-3 py-2 text-[13px] leading-[18px] font-bold no-underline"
            >
              <Icon name="whatsapp" size={18} class="shrink-0" />
              <span>¿Tu evento pasa de las {aHora(CIERRE)}? Cotízalo por WhatsApp</span>
            </WhatsAppLink>
          </div>

          <!-- 3 · Lugar -->
          <div data-paso="comuna" data-oculto inert class={capa}>
            <div>
              <h3 tabindex="-1" class={tituloPaso}>¿Dónde es el evento?</h3>
              <p class="text-noche-suave mt-1 hidden text-sm sm:block lg:text-base">El despacho depende de la comuna</p>
            </div>
            <fieldset>
              <legend class="sr-only">Comuna del evento</legend>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                {
                  COMUNAS.map((c) => (
                    <label class="border-noche has-checked:bg-noche has-checked:text-crema has-checked:shadow-sol bg-crema flex min-h-12 cursor-pointer flex-col justify-center rounded-xl border-2 px-3 py-1.5 has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-azul-texto sm:min-h-15 sm:gap-0.5 sm:py-2">
                      <input type="radio" name="comuna" value={c.nombre} class="sr-only" data-comuna data-ciudades={(c.ciudades ?? c.mapa ?? [c.nombre]).join("|")} />
                      <span class="text-[15px] leading-5 font-extrabold sm:text-base">{c.nombre}</span>
                      <span class="text-[13px] leading-4 font-semibold opacity-80 sm:text-sm">{c.despacho ? `+${pesos(c.despacho)} despacho` : "Despacho gratis"}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <fieldset class="grid grid-cols-2 gap-2.5">
              <legend class="sr-only">Dirección del evento</legend>
              <label class={`${caja} col-span-2 sm:col-span-1`}>
                <span class={cajaEtiqueta}>Dirección</span>
                <input name="direccion" required autocomplete="address-line1" placeholder="Calle y número" class={cajaInput} />
              </label>
              <label class={caja}>
                <span class={cajaEtiqueta}>Casa o depto <Fragment set:html={opcional} /></span>
                <input name="depto" autocomplete="address-line2" placeholder="Ej.: casa 12 o depto 304" class={cajaInput} />
              </label>
              <label class={caja}>
                <span class={cajaEtiqueta}>Ciudad</span>
                <input name="ciudad" required autocomplete="address-level2" list="agenda-ciudades" data-ciudad class={cajaInput} />
              </label>
              <label class={`${caja} bg-arena/60 cursor-default max-sm:hidden`}>
                <span class={cajaEtiqueta}>Región</span>
                <input name="region" value={REGION} readonly autocomplete="address-level1" class={`${cajaInput} text-noche-suave`} />
              </label>
              <datalist id="agenda-ciudades"></datalist>
            </fieldset>
            <p class="text-noche-suave mt-auto text-sm">
              ¿No está tu comuna? <a href="#despacho" class="text-azul-texto font-bold underline">Mira el mapa de despacho</a> o{" "}
              <WhatsAppLink placement="agenda-comuna" message="Hola, quiero arrendar un juego inflable y mi comuna no aparece en la agenda. Vengo de saltabum.cl" class="text-azul-texto font-bold underline">escríbenos por WhatsApp</WhatsAppLink>
            </p>
          </div>

          <!-- 4 · Tus datos -->
          <div data-paso="datos" data-oculto inert class={capa}>
            <div>
              <h3 tabindex="-1" class={tituloPaso}>¿A nombre de quién reservamos?</h3>
              <p class="text-noche-suave mt-1 text-sm lg:text-base">Te escribimos por WhatsApp para confirmar con el abono de {pesos(ABONO)}</p>
            </div>
            <div class="grid grid-cols-2 gap-2.5">
              <label class={caja}>
                <span class={cajaEtiqueta}>Nombre</span>
                <input name="nombre" required autocomplete="given-name" placeholder="Camila" class={cajaInput} />
              </label>
              <label class={caja}>
                <span class={cajaEtiqueta}>Apellido</span>
                <input name="apellido" required autocomplete="family-name" placeholder="Rojas" class={cajaInput} />
              </label>
              <label class={`${caja} col-span-2 sm:col-span-1`}>
                <span class={cajaEtiqueta}>Correo electrónico</span>
                <input name="email" type="email" required autocomplete="email" inputmode="email" placeholder="nombre@correo.cl" class={cajaInput} />
              </label>
              <label class={`${caja} col-span-2 sm:col-span-1`}>
                <span class={cajaEtiqueta}>Teléfono (WhatsApp)</span>
                <input name="telefono" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+56 9 1234 5678" class={cajaInput} />
              </label>
              <label class={`${caja} col-span-2`}>
                <span class={cajaEtiqueta}>Empresa <Fragment set:html={opcional} /></span>
                <input name="empresa" autocomplete="organization" placeholder="Nombre o RUT, para factura" class={cajaInput} />
              </label>
              <label class={`${caja} col-span-2`}>
                <span class={cajaEtiqueta}>Mensaje <Fragment set:html={opcional} /></span>
                <textarea name="mensaje" rows="1" placeholder="Tipo de evento, cantidad de niños, pasto o cemento" class={`${cajaInput} resize-none sm:min-h-12`}></textarea>
              </label>
            </div>
            <input name="website" hidden tabindex="-1" autocomplete="off" />
            <p class="text-noche-suave text-xs leading-5">
              Usamos tus datos solo para coordinar tu evento, según la Ley 19.628 y la Ley 21.719. Más en la <a href="/politica-de-privacidad" class="text-azul-texto underline">política de privacidad</a>
            </p>
            <p data-reserva-mensaje aria-live="polite" class="text-noche-suave text-sm empty:hidden"></p>
          </div>

          <!-- Listo -->
          <div data-paso="listo" data-oculto inert class={`${capa} justify-center`}>
            <span class="border-noche bg-verde flex size-14 items-center justify-center rounded-full border-2">
              <Icon name="check" size={30} strokeWidth={3} />
            </span>
            <h3 tabindex="-1" class={tituloPaso}>¡Tu horario quedó reservado!</h3>
            <p data-listo-detalle class="text-noche-suave max-w-[520px]"></p>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <WaButton placement="reserva" size="l" message="Hola, acabo de reservar en saltabum.cl y quiero confirmar con el abono." class="text-center leading-[22px]">
                Confirmar por WhatsApp
              </WaButton>
              <button type="button" data-otra class="text-azul-texto min-h-11 cursor-pointer px-2 font-extrabold underline">Hacer otra reserva</button>
            </div>
          </div>
        </div>

        <!-- Pie: total (celular) y navegación. Queda pegado abajo mientras se ve la reserva (por eso el form usa overflow-clip). -->
        <div data-pie class="border-noche bg-blanco sticky bottom-0 z-10 flex items-center gap-2 border-t-2 px-4 py-3 min-[360px]:gap-3 sm:px-5 lg:px-7 lg:py-4">
          <button type="button" data-atras hidden class="border-noche bg-crema flex size-12 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-full border-2 font-extrabold lg:w-auto lg:px-5">
            <Icon name="flecha" size={20} strokeWidth={2.6} class="rotate-180" />
            <span class="sr-only lg:not-sr-only">Atrás</span>
          </button>
          <div class="min-w-0 flex-1 lg:hidden" aria-live="polite">
            <p data-mini-detalle class="text-noche-suave truncate text-xs leading-4 font-semibold"></p>
            <p class="truncate leading-7 whitespace-nowrap"><span class="hidden text-sm font-extrabold min-[360px]:inline">Total </span><span data-mini-total class="font-display text-[22px] font-bold"></span></p>
          </div>
          <span class="hidden flex-1 lg:block"></span>
          <button
            type="button"
            data-siguiente
            disabled
            class="bounce bg-rojo-texto border-noche shadow-pop flex min-h-13 shrink-0 cursor-pointer items-center gap-2 rounded-full border-2 px-4 text-base font-extrabold text-white disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none min-[360px]:px-5 sm:px-6 lg:text-[17px]"
          >
            <!-- En celulares angostos basta con «Continuar»; el paso ya dice qué falta. -->
            <span data-siguiente-texto class="hidden min-[400px]:inline">Elige un día</span>
            <span class="min-[400px]:hidden">Continuar</span>
            <Icon name="flecha" size={18} strokeWidth={2.8} class="hidden min-[360px]:block" />
          </button>
          <button
            type="submit"
            data-reserva-boton
            hidden
            class="bounce bg-rojo-texto border-noche shadow-pop min-h-13 shrink-0 cursor-pointer rounded-full border-2 px-4 text-base font-extrabold text-white disabled:cursor-not-allowed disabled:opacity-60 min-[360px]:px-5 group-data-[state=sending]:pointer-events-none group-data-[state=sending]:opacity-75 sm:px-6 lg:text-[17px]"
          >
            Reservar
          </button>
        </div>
      </div>

      <!-- Resumen (escritorio) -->
      <aside class="border-noche bg-crema hidden min-w-0 flex-col gap-4 border-l-2 p-6 lg:flex xl:p-7" aria-label="Resumen de tu arriendo">
        <p class="font-display text-2xl leading-8 font-semibold">Tu arriendo</p>
        <dl class="flex flex-col gap-3">
          {
            [
              { id: "juego", nombre: "Juego", icono: "check" as const, paso: undefined },
              { id: "fecha", nombre: "Fecha", icono: "calendario" as const, paso: "fecha" },
              { id: "horario", nombre: "Horario", icono: "puntual" as const, paso: "horario" },
              { id: "comuna", nombre: "Despacho", icono: "ubicacion" as const, paso: "comuna" },
            ].map((r) => (
              <div class="flex items-center gap-3">
                <span class="border-noche bg-blanco flex size-10 shrink-0 items-center justify-center rounded-full border-2">
                  <Icon name={r.icono} size={19} />
                </span>
                <div class="min-w-0 flex-1">
                  <dt class="text-noche-suave text-xs font-extrabold tracking-[1px] uppercase">{r.nombre}</dt>
                  <dd data-res={r.id} class="leading-5 font-bold first-letter:uppercase data-vacio:text-noche-suave/70 data-vacio:font-semibold" />
                </div>
                {r.paso && (
                  <button type="button" data-ir={r.paso} hidden class="text-azul-texto min-h-10 shrink-0 cursor-pointer px-1 text-sm font-extrabold underline">
                    Cambiar
                  </button>
                )}
              </div>
            ))
          }
        </dl>
        <dl class="border-noche/20 flex flex-col gap-1.5 border-t-2 border-dashed pt-4 text-[15px]">
          <div class="flex justify-between gap-3"><dt>Arriendo por {HORAS_BASE} horas</dt><dd data-precio-base class="font-extrabold"></dd></div>
          <div class="flex justify-between gap-3"><dt data-linea-extra>Horas adicionales</dt><dd data-precio-extra class="font-extrabold"></dd></div>
          <div class="flex justify-between gap-3"><dt data-linea-despacho>Despacho</dt><dd data-precio-despacho class="font-extrabold"></dd></div>
          <div class="border-noche/20 mt-1.5 flex items-end justify-between gap-3 border-t-2 border-dashed pt-3">
            <dt class="font-extrabold">Total</dt>
            <dd data-precio-total class="font-display text-[32px] leading-9 font-bold"></dd>
          </div>
        </dl>
        <p class="text-noche-suave text-sm">Reservas con {pesos(ABONO)} de abono, que se descuentan del total</p>
        <WhatsAppLink
          placement="agenda-ayuda"
          message="Hola, tengo una duda sobre la reserva en saltabum.cl"
          class="text-noche mt-auto inline-flex min-h-11 items-center gap-2 text-sm font-extrabold underline"
        >
          <Icon name="whatsapp" size={18} />
          ¿Dudas? Escríbenos por WhatsApp
        </WhatsAppLink>
      </aside>
    </form>
  </div>
</section>

<script>
  import { cargarDisponibilidad, enviarReserva, type Disponibilidad } from "@/lib/client/reservas";
  import {
    HORAS_BASE,
    HORAS_EXTRA_MAX,
    aHora,
    calcularPrecio,
    estaLibre,
    etiquetaHorario,
    iniciosPosibles,
    pesos,
    VALOR_HORA_EXTRA,
  } from "@/lib/reservas";
  import { PRODUCTOS } from "../data";

  const ORDEN = ["fecha", "horario", "comuna", "datos"] as const;
  type Paso = (typeof ORDEN)[number] | "listo";
  /** Texto del botón «Continuar» mientras falta completar el paso. */
  const FALTA = { fecha: "Elige un día", horario: "Elige la hora", comuna: "Elige tu comuna" } as const;

  const root = document.querySelector<HTMLElement>("[data-agenda]");
  if (root) iniciar(root);

  function iniciar(root: HTMLElement) {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const $$ = <T extends Element>(sel: string) => [...root.querySelectorAll<T>(sel)];
    const form = $<HTMLFormElement>("[data-reserva]");
    const gridDias = $<HTMLElement>("[data-dias]");
    const tituloMes = $<HTMLElement>("[data-mes-titulo]");
    const btnAnterior = $<HTMLButtonElement>("[data-mes-anterior]");
    const btnSiguienteMes = $<HTMLButtonElement>("[data-mes-siguiente]");
    const estado = $<HTMLElement>("[data-agenda-estado]");
    const gridInicios = $<HTMLElement>("[data-inicios]");
    const resumenInicio = $<HTMLElement>("[data-inicio-resumen]");
    const btnMenos = $<HTMLButtonElement>("[data-menos]");
    const btnMas = $<HTMLButtonElement>("[data-mas]");
    const btnAtras = $<HTMLButtonElement>("[data-atras]");
    const btnSiguiente = $<HTMLButtonElement>("[data-siguiente]");
    const btnReservar = $<HTMLButtonElement>("[data-reserva-boton]");
    const pie = $<HTMLElement>("[data-pie]");
    const mensaje = $<HTMLElement>("[data-reserva-mensaje]");
    const setTexto = (sel: string, txt: string) => $$<HTMLElement>(sel).forEach((el) => (el.textContent = txt));

    const fechaLarga = new Intl.DateTimeFormat("es-CL", { weekday: "long", day: "numeric", month: "long", timeZone: "UTC" });
    const fechaCorta = new Intl.DateTimeFormat("es-CL", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });
    const nombreMes = new Intl.DateTimeFormat("es-CL", { month: "long", year: "numeric", timeZone: "UTC" });
    const aFecha = (iso: string) => new Date(`${iso}T12:00:00Z`);
    const iso = (d: Date) => d.toISOString().slice(0, 10);
    const sinPunto = (s: string) => s.replace(/\./g, "");

    let disp: Disponibilidad | undefined;
    let mes = ""; // "YYYY-MM"
    let dia: string | undefined;
    let inicio: number | undefined;
    let horas = HORAS_BASE;
    let paso: Paso = "fecha";

    const producto = () =>
      (root.querySelector<HTMLInputElement>("[data-producto]:checked") ?? root.querySelector<HTMLInputElement>("input[type=hidden][data-producto]"))?.value ??
      PRODUCTOS[0].id;
    const comuna = () => root.querySelector<HTMLInputElement>("[data-comuna]:checked")?.value;
    /** Campos de texto de un paso (los que se validan antes de avanzar o reservar). */
    const camposDe = (p: string) =>
      $$<HTMLInputElement | HTMLTextAreaElement>(
        `[data-paso="${p}"] input:not([type=radio]):not([type=hidden]):not([readonly]), [data-paso="${p}"] textarea`,
      );
    const validos = (p: string) => camposDe(p).every((c) => c.checkValidity());
    const completo: Record<(typeof ORDEN)[number], () => boolean> = {
      fecha: () => !!dia,
      horario: () => inicio !== undefined,
      comuna: () => !!comuna() && validos("comuna"),
      datos: () => false,
    };
    /** Si a un paso le falta algo, lo muestra y marca el primer campo pendiente. Devuelve true si está bien. */
    function revisar(p: "comuna" | "datos"): boolean {
      const malo = camposDe(p).find((c) => !c.checkValidity());
      if (!malo) return true;
      if (paso !== p) irA(p, false);
      malo.reportValidity();
      malo.focus();
      return false;
    }
    /** Hasta qué paso se puede llegar: el primero que falta completar. */
    const alcanzable = () => ORDEN.findIndex((p) => !completo[p]());

    /** Horas de inicio libres ese día para un juego (por defecto el elegido) y la duración. */
    const libres = (fecha: string, h = horas, juego = producto()) =>
      iniciosPosibles(h).filter((m) => estaLibre(fecha, juego, m, h, disp?.ocupados ?? []));
    /** Lo más libre que está el día entre todos los juegos: el día se puede elegir si al menos uno tiene horario. */
    const libresDelDia = (fecha: string) => Math.max(...PRODUCTOS.map((p) => libres(fecha, HORAS_BASE, p.id).length));
    const radiosJuego = $$<HTMLInputElement>("input[type=radio][data-producto]");

    /** Marca en cada juego si ese día tiene horarios y deshabilita los que no. Si el elegido no tiene, elige otro. */
    function pintarJuegos() {
      if (!dia || !radiosJuego.length) return;
      for (const r of radiosJuego) {
        const n = libres(dia, horas, r.value).length;
        r.disabled = n === 0;
        const marca = root.querySelector<HTMLElement>(`[data-juego-estado="${r.value}"]`);
        if (marca) marca.textContent = n === 0 ? "Ocupado" : n < 8 ? "Quedan pocos" : "Disponible";
      }
      const elegido = radiosJuego.find((r) => r.checked);
      if (!elegido || elegido.disabled) {
        const otro = radiosJuego.find((r) => !r.disabled);
        if (otro) otro.checked = true;
      }
    }

    // ── Navegación entre pasos ────────────────────────────────────────────────
    function irA(destino: Paso, enfocar = true) {
      paso = destino;
      $$<HTMLElement>("[data-paso]").forEach((el) => {
        const activo = el.dataset.paso === destino;
        el.toggleAttribute("data-oculto", !activo);
        el.inert = !activo;
      });
      // En «listo» el pie se esconde sin perder su alto, para que el bloque no cambie de tamaño.
      pie.classList.toggle("invisible", destino === "listo");
      pie.inert = destino === "listo";
      actualizar();
      if (!enfocar) return;
      // Si el usuario avanzó desde el pie y el inicio del bloque quedó fuera de la pantalla, se vuelve arriba.
      const arriba = form.getBoundingClientRect().top;
      if (arriba < 60) {
        const suave = !matchMedia("(prefers-reduced-motion: reduce)").matches;
        form.scrollIntoView({ behavior: suave ? "smooth" : "auto", block: "start" });
      }
      $<HTMLElement>(`[data-paso="${destino}"] h3`).focus({ preventScroll: true });
    }

    function siguiente() {
      if (paso === "listo" || paso === "datos") return;
      if (paso === "comuna" && comuna() && !revisar("comuna")) return;
      if (!completo[paso]()) return;
      irA(ORDEN[ORDEN.indexOf(paso) + 1]);
    }

    // ── Ciudad: se sugiere según la comuna de despacho ───────────────────────
    const inputCiudad = $<HTMLInputElement>("[data-ciudad]");
    const listaCiudades = $<HTMLDataListElement>("#agenda-ciudades");
    let ciudadSugerida = "";
    function sugerirCiudad() {
      const radio = root.querySelector<HTMLInputElement>("[data-comuna]:checked");
      if (!radio) return;
      const opciones = (radio.dataset.ciudades || radio.value).split("|");
      listaCiudades.replaceChildren(...opciones.map((o) => Object.assign(document.createElement("option"), { value: o })));
      inputCiudad.placeholder = `Ej.: ${opciones[0]}`;
      // Solo se reemplaza si el cliente no escribió otra cosa.
      if (!inputCiudad.value || inputCiudad.value === ciudadSugerida) {
        ciudadSugerida = opciones.length === 1 ? opciones[0] : "";
        inputCiudad.value = ciudadSugerida;
      }
    }

    // ── Calendario ────────────────────────────────────────────────────────────
    function pintarMes() {
      if (!disp) return;
      const [y, m] = mes.split("-").map(Number);
      const primero = new Date(Date.UTC(y, m - 1, 1, 12));
      tituloMes.textContent = nombreMes.format(primero);
      btnAnterior.disabled = mes <= disp.desde.slice(0, 7);
      btnSiguienteMes.disabled = mes >= disp.hasta.slice(0, 7);

      gridDias.replaceChildren();
      const vacios = (primero.getUTCDay() + 6) % 7; // semana parte el lunes
      for (let i = 0; i < vacios; i++) gridDias.append(document.createElement("span"));

      const diasDelMes = new Date(Date.UTC(y, m, 0)).getUTCDate();
      for (let d = 1; d <= diasDelMes; d++) {
        const fecha = iso(new Date(Date.UTC(y, m - 1, d, 12)));
        const boton = document.createElement("button");
        boton.type = "button";
        boton.textContent = String(d);
        boton.dataset.fecha = fecha;
        const fuera = fecha < disp.desde || fecha > disp.hasta;
        // El color del día se calcula con la duración base (3 horas) y el juego más libre ese día.
        const n = fuera ? 0 : libresDelDia(fecha);
        const tipo = fuera ? "fuera" : n === 0 ? "lleno" : n < 8 ? "pocos" : "libre";
        boton.disabled = tipo === "fuera" || tipo === "lleno";
        boton.setAttribute("aria-pressed", String(fecha === dia));
        const textoEstado = { fuera: "no disponible", lleno: "sin horarios", pocos: "quedan pocos horarios", libre: "con horarios libres" }[tipo];
        boton.setAttribute("aria-label", `${fechaLarga.format(aFecha(fecha))}, ${textoEstado}`);
        boton.className =
          "min-h-10 cursor-pointer rounded-xl border-2 text-[15px] font-extrabold sm:min-h-11 aria-pressed:bg-noche aria-pressed:text-crema aria-pressed:border-noche aria-pressed:shadow-sol disabled:cursor-not-allowed lg:min-h-12 lg:text-base " +
          {
            fuera: "border-transparent text-noche-suave/40",
            lleno: "border-noche/20 bg-arena text-noche-suave line-through",
            pocos: "border-noche bg-sol",
            libre: "border-noche bg-verde-burbuja",
          }[tipo];
        boton.addEventListener("click", () => elegirDia(fecha));
        gridDias.append(boton);
      }
    }

    function elegirDia(fecha: string) {
      dia = fecha;
      gridDias.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x.dataset.fecha === fecha)));
      pintarJuegos();
      pintarInicios();
      irA("horario");
    }

    function cambiarMes(delta: number) {
      const [y, m] = mes.split("-").map(Number);
      mes = iso(new Date(Date.UTC(y, m - 1 + delta, 1, 12))).slice(0, 7);
      pintarMes();
    }

    // ── Horario ───────────────────────────────────────────────────────────────
    /** Dibuja las horas de inicio de la duración elegida; las que chocan con otra reserva quedan tachadas. */
    function pintarInicios() {
      if (!dia) return;
      const ok = new Set(libres(dia));
      if (inicio !== undefined && !ok.has(inicio)) inicio = undefined;
      // Con más horas quedan menos opciones; se rellena con celdas vacías para que el paso no cambie de alto.
      const relleno = Array.from({ length: iniciosPosibles(HORAS_BASE).length - iniciosPosibles(horas).length }, () => {
        const vacio = document.createElement("span");
        vacio.className = "min-h-10 sm:min-h-11";
        return vacio;
      });
      gridInicios.replaceChildren(
        ...iniciosPosibles(horas).map((m) => {
          const b = document.createElement("button");
          b.type = "button";
          b.textContent = aHora(m);
          b.disabled = !ok.has(m);
          b.setAttribute("aria-pressed", String(m === inicio));
          b.setAttribute("aria-label", `${aHora(m)}${b.disabled ? ", ocupado" : ""}`);
          b.className =
            "border-noche bg-verde-burbuja aria-pressed:bg-noche aria-pressed:text-crema aria-pressed:shadow-sol min-h-10 cursor-pointer rounded-xl border-2 text-[14px] font-extrabold disabled:cursor-not-allowed disabled:border-noche/20 disabled:bg-arena disabled:text-noche-suave disabled:line-through sm:min-h-11 sm:text-[15px]";
          b.addEventListener("click", () => {
            inicio = m;
            pintarInicios();
          });
          return b;
        }),
        ...relleno,
      );
      if (ok.size === 0) resumenInicio.textContent = "Con esta duración no quedan horarios ese día, prueba con menos horas o con otro día";
      else if (inicio === undefined) resumenInicio.textContent = "Elige a qué hora quieres que esté listo el juego";
      else resumenInicio.textContent = `Tu juego estará de ${etiquetaHorario(inicio, inicio + horas * 60)}`;
      actualizar();
    }

    function cambiarHoras(delta: number) {
      horas = Math.min(HORAS_BASE + HORAS_EXTRA_MAX, Math.max(HORAS_BASE, horas + delta));
      pintarJuegos();
      pintarInicios();
    }

    // ── Resumen, total y botones ──────────────────────────────────────────────
    function actualizar() {
      const extra = horas - HORAS_BASE;
      setTexto("[data-horas]", String(horas));
      setTexto("[data-horas-extra]", extra ? `+${extra} hora${extra > 1 ? "s" : ""}, ${pesos(extra * VALOR_HORA_EXTRA)}` : "Sin horas extra");
      btnMenos.disabled = horas <= HORAS_BASE;
      btnMas.disabled = horas >= HORAS_BASE + HORAS_EXTRA_MAX;

      const c = comuna();
      const p = calcularPrecio(producto(), horas, c);
      const horario = inicio !== undefined ? etiquetaHorario(inicio, inicio + horas * 60) : undefined;
      const res = (id: string, valor: string | undefined, vacio = "Por elegir") =>
        $$<HTMLElement>(`[data-res="${id}"]`).forEach((el) => {
          el.textContent = valor ?? vacio;
          el.toggleAttribute("data-vacio", !valor);
        });
      res("juego", `${PRODUCTOS.find((x) => x.id === producto())?.nombre ?? ""}`);
      res("fecha", dia && fechaLarga.format(aFecha(dia)));
      res("fecha-corta", dia && sinPunto(fechaCorta.format(aFecha(dia))));
      res("horario", horario && `${horario} · ${horas} horas`);
      res("comuna", c && `${c} · ${p.despacho ? pesos(p.despacho) : "gratis"}`);

      setTexto("[data-precio-base]", pesos(p.base));
      setTexto("[data-linea-extra]", extra ? `${extra} hora${extra > 1 ? "s" : ""} adicional${extra > 1 ? "es" : ""}` : "Horas adicionales");
      setTexto("[data-precio-extra]", extra ? pesos(p.extras) : "$0");
      setTexto("[data-linea-despacho]", c ? `Despacho a ${c}` : "Despacho");
      setTexto("[data-precio-despacho]", c ? pesos(p.despacho) : "Por elegir");
      const total = `$${p.total.toLocaleString("es-CL")}`;
      setTexto("[data-precio-total]", total);
      setTexto("[data-mini-total]", total);
      setTexto(
        "[data-mini-detalle]",
        [dia && sinPunto(fechaCorta.format(aFecha(dia))), horario, c].filter(Boolean).join(" · ") || `${horas} horas${c ? "" : " · despacho aparte"}`,
      );

      // Pasos: el actual, los listos y hasta dónde se puede saltar.
      const tope = alcanzable();
      $$<HTMLButtonElement>("[data-stepper] [data-ir]").forEach((b, i) => {
        const id = b.dataset.ir as Paso;
        if (id === paso) b.setAttribute("aria-current", "step");
        else b.removeAttribute("aria-current");
        b.toggleAttribute("data-hecho", paso === "listo" || completo[id as (typeof ORDEN)[number]]());
        b.disabled = paso === "listo" || (tope >= 0 && i > tope);
      });
      $$<HTMLButtonElement>("aside [data-ir]").forEach((b) => (b.hidden = paso === "listo" || !completo[b.dataset.ir as (typeof ORDEN)[number]]()));

      btnAtras.hidden = paso === "fecha" || paso === "listo";
      const actual = paso;
      btnSiguiente.hidden = actual === "datos";
      btnReservar.hidden = actual !== "datos";
      if (actual !== "datos" && actual !== "listo") {
        // En «Lugar» basta la comuna para habilitar el botón; la dirección se revisa al tocarlo.
        const listo = actual === "comuna" ? !!comuna() : completo[actual]();
        btnSiguiente.disabled = !listo;
        $<HTMLElement>("[data-siguiente-texto]").textContent = listo ? "Continuar" : FALTA[actual];
      }
    }

    // ── Eventos ───────────────────────────────────────────────────────────────
    btnMenos.addEventListener("click", () => cambiarHoras(-1));
    btnMas.addEventListener("click", () => cambiarHoras(1));
    btnAnterior.addEventListener("click", () => cambiarMes(-1));
    btnSiguienteMes.addEventListener("click", () => cambiarMes(1));
    btnSiguiente.addEventListener("click", siguiente);
    btnAtras.addEventListener("click", () => {
      const i = ORDEN.indexOf(paso as (typeof ORDEN)[number]);
      if (i > 0) irA(ORDEN[i - 1]);
    });
    root.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("[data-ir]");
      if (b && !b.disabled) irA(b.dataset.ir as Paso);
    });
    $$<HTMLInputElement>("[data-comuna]").forEach((r) =>
      r.addEventListener("change", () => {
        sugerirCiudad();
        actualizar();
      }),
    );
    // Al escribir la dirección se actualizan los pasos (para poder saltar al siguiente).
    camposDe("comuna").forEach((c) => c.addEventListener("input", actualizar));
    $$<HTMLInputElement>("[data-producto]").forEach((r) =>
      r.addEventListener("change", () => {
        inicio = undefined;
        pintarInicios();
        actualizar();
      }),
    );
    $<HTMLButtonElement>("[data-otra]").addEventListener("click", () => {
      form.reset();
      dia = undefined;
      inicio = undefined;
      horas = HORAS_BASE;
      ciudadSugerida = "";
      radiosJuego.forEach((r) => (r.disabled = false));
      pintarMes();
      irA("fecha");
    });

    // La sección de despacho puede dejar elegida la comuna antes de llegar aquí.
    document.addEventListener("saltabum:comuna", (e) => {
      const nombre = (e as CustomEvent<string>).detail;
      const radio = $$<HTMLInputElement>("[data-comuna]").find((r) => r.value === nombre);
      if (radio) {
        radio.checked = true;
        sugerirCiudad();
        actualizar();
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const c = comuna();
      if (!dia || inicio === undefined || !c || form.dataset.state === "sending") return;
      if (!revisar("comuna") || !revisar("datos")) return;
      form.dataset.state = "sending";
      btnReservar.disabled = true;
      mensaje.textContent = "Reservando…";
      const data = new FormData(form);
      const txt = (k: string) => (typeof data.get(k) === "string" ? (data.get(k) as string) : undefined);
      const fecha = dia;
      const desde = inicio;
      const juego = producto();
      const r = await enviarReserva({
        fecha,
        producto: juego as never,
        inicio: aHora(desde),
        horas,
        nombre: txt("nombre") ?? "",
        apellido: txt("apellido"),
        email: txt("email"),
        telefono: txt("telefono") ?? "",
        empresa: txt("empresa"),
        comuna: c,
        direccion: txt("direccion"),
        depto: txt("depto"),
        ciudad: txt("ciudad"),
        region: txt("region"),
        mensaje: txt("mensaje"),
        website: txt("website"),
      });
      form.dataset.state = "idle";
      btnReservar.disabled = false;

      if (r.ok) {
        const fin = desde + horas * 60;
        disp?.ocupados.push({ fecha, producto: juego, inicio: desde, fin });
        const total = calcularPrecio(juego, horas, c).total;
        const lugar = [txt("direccion"), txt("depto"), txt("ciudad") || c].filter(Boolean).join(", ");
        const detalle = `${fechaLarga.format(aFecha(fecha))}, de ${etiquetaHorario(desde, fin)} en ${lugar}, total ${pesos(total)}`;
        $<HTMLElement>("[data-listo-detalle]").textContent = `${detalle}. Te escribimos por WhatsApp para confirmar con el abono`;
        const textoWhatsapp = `Hola, acabo de reservar en saltabum.cl para el ${detalle}. Quiero confirmar con el abono.`;
        const wa = $<HTMLAnchorElement>(`[data-paso="listo"] a[data-track]`);
        const url = new URL(wa.href);
        url.search = `?text=${encodeURIComponent(textoWhatsapp)}`;
        wa.href = url.toString();
        // El resumen queda a la vista hasta que el cliente pida hacer otra reserva.
        mensaje.textContent = "";
        pintarMes();
        irA("listo");

        // Página de gracias: el resumen viaja en sessionStorage (nunca en la URL). La breve espera deja salir
        // los avisos de conversión del navegador antes de cambiar de página.
        try {
          sessionStorage.setItem(
            "saltabum:reserva",
            JSON.stringify({
              nombre: txt("nombre")?.split(/\s+/)[0],
              juego: PRODUCTOS.find((p) => p.id === juego)?.nombre,
              fecha: fechaLarga.format(aFecha(fecha)),
              horario: `${etiquetaHorario(desde, fin)} · ${horas} horas`,
              lugar,
              total: pesos(total),
              whatsapp: textoWhatsapp,
            }),
          );
        } catch {
          // Sin almacenamiento la página de gracias igual funciona, sin el resumen.
        }
        setTimeout(() => location.assign("/gracias/"), 450);
        return;
      }
      if (r.error === "ocupado") {
        mensaje.textContent = "";
        await recargar();
        inicio = undefined;
        pintarJuegos();
        pintarInicios();
        irA("horario");
        resumenInicio.textContent = "Ese horario se acaba de tomar, elige otro";
        return;
      }
      mensaje.textContent =
        r.error === "limite"
          ? "Ya hiciste varias reservas hoy, escríbenos por WhatsApp para agendar otra"
          : "No pudimos reservar, inténtalo de nuevo o escríbenos por WhatsApp";
    });

    async function recargar() {
      try {
        disp = await cargarDisponibilidad();
        mes ||= disp.desde.slice(0, 7);
        estado.textContent = "";
        estado.hidden = true;
        pintarMes();
      } catch {
        estado.textContent = "No pudimos cargar la disponibilidad, escríbenos por WhatsApp";
      }
    }

    // ── Disponibilidad en vivo ────────────────────────────────────────────────
    // Lo que se reserva o bloquea en el panel /admin aparece aquí sin recargar: se vuelve a consultar cada 30 s
    // mientras la agenda está en pantalla y al volver a la pestaña. Si el horario elegido se tomó, se avisa.
    let enPantalla = false;
    new IntersectionObserver(([e]) => (enPantalla = e.isIntersecting)).observe(root);
    async function refrescar() {
      if (form.dataset.state === "sending" || paso === "listo") return;
      const elegido = inicio;
      await recargar();
      if (!dia) return;
      pintarJuegos();
      pintarInicios();
      if (elegido !== undefined && inicio === undefined) {
        if (paso === "comuna" || paso === "datos") irA("horario");
        resumenInicio.textContent = "El horario que elegiste se acaba de tomar, elige otro";
      }
    }
    setInterval(() => {
      if (enPantalla && document.visibilityState === "visible") void refrescar();
    }, 30_000);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible" && enPantalla) void refrescar();
    });

    irA("fecha", false);
    void recargar();
  }
</script>
