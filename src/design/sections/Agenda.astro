---
// Agenda de reservas: el cliente elige el día en el calendario y después arma su arriendo: juego, hora de inicio
// (cada 30 minutos entre 09:00 y 22:00), cuántas horas (3 más hasta 3 adicionales) y la comuna para el despacho.
// Ve el total al tiro y reserva. Reglas y precios: src/lib/reservas.ts. Datos y envío: src/lib/client/reservas.ts.
import Turnstile from "@/components/core/Turnstile.astro";
import WhatsAppLink from "@/components/core/WhatsAppLink.astro";
import { APERTURA, CIERRE, HORAS_BASE, HORAS_EXTRA_MAX, aHora, pesos } from "@/lib/reservas";
import { ABONO, COMUNAS, HORA_EXTRA, PRODUCTOS } from "../data";
import Icon from "../components/Icon.astro";
import Rayos from "../components/Rayos.astro";
import WaButton from "../components/WaButton.astro";

const DIAS_SEMANA = ["L", "M", "M", "J", "V", "S", "D"];
const input =
  "border-noche bg-crema text-noche placeholder:text-noche-suave/70 min-h-12 w-full min-w-0 rounded-xl border-2 px-3.5";
const titulo = "font-display text-[19px] leading-6 font-semibold";
---

<section id="reservar" aria-labelledby="agenda-titulo" class="border-noche bg-sol text-noche relative isolate overflow-hidden border-b-2" data-agenda>
  <Rayos x="78%" y="8%" />
  <div class="mx-auto flex max-w-[1320px] flex-col gap-6 px-4 py-10 lg:gap-10 lg:px-10 lg:py-20">
    <div>
      <p class="text-xs font-extrabold tracking-[1.2px] uppercase">Reserva en línea</p>
      <h2 id="agenda-titulo" class="font-display mt-1.5 text-[34px] leading-[38px] font-semibold lg:text-5xl lg:leading-[52px]">
        Elige tu fecha y horario
      </h2>
      <p class="mt-2 max-w-[600px] lg:mt-3 lg:text-lg">
        Arma tu arriendo en minutos, con la hora que quieras desde las {aHora(APERTURA)} y el total a la vista
      </p>
    </div>

    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:gap-8">
      <!-- Calendario -->
      <div class="border-noche bg-blanco shadow-pop flex flex-col gap-4 rounded-[28px] border-2 p-4 lg:flex-1 lg:p-6 lg:shadow-pop-l">
        <div class="flex items-center justify-between gap-3">
          <button
            type="button"
            data-mes-anterior
            aria-label="Mes anterior"
            class="border-noche bg-crema flex size-11 cursor-pointer items-center justify-center rounded-full border-2 disabled:cursor-not-allowed disabled:opacity-30"
          >
            <Icon name="flecha" size={20} strokeWidth={2.6} class="rotate-180" />
          </button>
          <p data-mes-titulo aria-live="polite" class="font-display text-2xl leading-7 font-semibold first-letter:uppercase">&nbsp;</p>
          <button
            type="button"
            data-mes-siguiente
            aria-label="Mes siguiente"
            class="border-noche bg-crema flex size-11 cursor-pointer items-center justify-center rounded-full border-2 disabled:cursor-not-allowed disabled:opacity-30"
          >
            <Icon name="flecha" size={20} strokeWidth={2.6} />
          </button>
        </div>

        <div class="grid grid-cols-7 gap-1.5 text-center lg:gap-2" aria-hidden="true">
          {DIAS_SEMANA.map((d) => <span class="text-noche-suave text-xs font-extrabold tracking-[1px]">{d}</span>)}
        </div>
        <div data-dias class="grid min-h-[300px] grid-cols-7 gap-1.5 lg:gap-2"></div>

        <p data-agenda-estado class="text-noche-suave text-sm">Cargando disponibilidad…</p>

        <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Simbología">
          <li class="flex items-center gap-2"><span class="border-noche bg-verde-burbuja size-4 rounded border-2"></span>Con horarios libres</li>
          <li class="flex items-center gap-2"><span class="border-noche bg-sol size-4 rounded border-2"></span>Quedan pocos</li>
          <li class="flex items-center gap-2"><span class="border-noche/30 bg-arena size-4 rounded border-2"></span>Sin horarios</li>
        </ul>
      </div>

      <!-- Arma tu arriendo -->
      <div class="border-noche bg-blanco flex flex-col gap-4 rounded-[28px] border-2 p-4 lg:flex-1 lg:p-6">
        <div data-paso="dia">
          <p class="font-display text-[22px] leading-7 font-semibold">Elige un día en el calendario</p>
          <p class="text-noche-suave mt-1.5">Puedes reservar desde mañana y después eliges la hora, las horas y tu comuna</p>
          <ul class="mt-4 flex flex-col gap-2">
            <li class="bg-crema flex items-center gap-2.5 rounded-xl px-3.5 py-2.5 font-semibold"><Icon name="puntual" size={20} />Inicio desde las {aHora(APERTURA)}, cada 30 minutos</li>
            <li class="bg-crema flex items-center gap-2.5 rounded-xl px-3.5 py-2.5 font-semibold"><Icon name="check" size={20} />{HORAS_BASE} horas, más hasta {HORAS_EXTRA_MAX} adicionales de {HORA_EXTRA}</li>
            <li class="bg-crema flex items-center gap-2.5 rounded-xl px-3.5 py-2.5 font-semibold"><Icon name="despacho" size={20} />Despacho según tu comuna, con el total a la vista</li>
          </ul>
        </div>

        <div data-paso="armar" hidden class="flex flex-col gap-5">
          <p data-dia-titulo class="font-display text-[24px] leading-7 font-semibold first-letter:uppercase"></p>

          <fieldset class="flex flex-col gap-2">
            <legend class={titulo}>Juego</legend>
            <div class="mt-2 grid gap-2">
              {
                PRODUCTOS.map((p, i) => (
                  <label class="border-noche has-checked:bg-noche has-checked:text-crema has-checked:shadow-sol bg-crema flex min-h-14 cursor-pointer items-center justify-between gap-3 rounded-xl border-2 px-3.5 py-2.5 font-extrabold">
                    <span class="flex items-center gap-2.5">
                      <input type="radio" name="producto" value={p.id} checked={i === 0} class="accent-sol size-4" data-producto />
                      {p.nombre}
                    </span>
                    <span class="text-sm font-semibold">{pesos(p.precio)} · {HORAS_BASE} horas</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="flex flex-col gap-2">
            <p class={titulo}>¿Cuántas horas?</p>
            <div class="flex items-center gap-3">
              <button type="button" data-menos aria-label="Una hora menos" class="border-noche bg-crema flex size-12 cursor-pointer items-center justify-center rounded-full border-2 text-2xl font-extrabold disabled:cursor-not-allowed disabled:opacity-30">−</button>
              <p class="min-w-[150px] text-center">
                <span data-horas class="font-display text-[28px] leading-8 font-bold">{HORAS_BASE}</span>
                <span class="font-extrabold"> horas</span>
                <span data-horas-extra class="text-noche-suave block text-sm">Sin horas adicionales</span>
              </p>
              <button type="button" data-mas aria-label="Una hora más" class="border-noche bg-crema flex size-12 cursor-pointer items-center justify-center rounded-full border-2 text-2xl font-extrabold disabled:cursor-not-allowed disabled:opacity-30">+</button>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <p class={titulo}>Hora de inicio</p>
            <div data-inicios role="group" aria-label="Hora de inicio" class="grid grid-cols-4 gap-2 sm:grid-cols-5"></div>
            <p data-inicio-resumen class="text-noche-suave text-sm">Elige a qué hora quieres que esté listo el juego</p>
            <WhatsAppLink
              placement="agenda-noche"
              message="Hola, mi evento dura toda la noche o pasa de las 22:00 y quiero cotizar un juego inflable. Vengo de saltabum.cl"
              class="border-noche bg-crema mt-1 flex min-h-12 items-center gap-2.5 rounded-xl border-2 border-dashed px-3.5 py-2 text-sm font-extrabold no-underline"
            >
              <Icon name="whatsapp" size={20} class="shrink-0" />
              <span>¿Tu evento dura toda la noche o pasa de las {aHora(CIERRE)}? Cotízalo con nosotros por WhatsApp</span>
            </WhatsAppLink>
          </div>

          <label class="flex flex-col gap-2">
            <span class={titulo}>Comuna del evento</span>
            <select data-comuna class={input}>
              <option value="">Elige tu comuna</option>
              {COMUNAS.map((c) => <option value={c.nombre}>{c.nombre} · {c.despacho ? `despacho ${pesos(c.despacho)}` : "despacho gratis"}</option>)}
            </select>
          </label>

          <!-- Total -->
          <div class="border-noche bg-crema rounded-[20px] border-2 p-4">
            <p class={titulo}>Tu arriendo</p>
            <dl class="mt-2 flex flex-col gap-1.5 text-[15px]">
              <div class="flex justify-between gap-3"><dt data-linea-base>Arriendo por {HORAS_BASE} horas</dt><dd data-precio-base class="font-extrabold"></dd></div>
              <div class="flex justify-between gap-3"><dt data-linea-extra>Horas adicionales</dt><dd data-precio-extra class="font-extrabold"></dd></div>
              <div class="flex justify-between gap-3"><dt data-linea-despacho>Despacho</dt><dd data-precio-despacho class="font-extrabold"></dd></div>
              <div class="border-noche/20 mt-1 flex items-end justify-between gap-3 border-t-2 border-dashed pt-2">
                <dt class="font-extrabold">Total</dt>
                <dd data-precio-total class="font-display text-[30px] leading-8 font-bold"></dd>
              </div>
            </dl>
            <p class="text-noche-suave mt-2 text-sm">Reservas con {pesos(ABONO)} de abono, que se descuentan del total</p>
          </div>

          <form data-reserva class="group grid grid-cols-2 gap-3.5">
            <label class="col-span-2 flex flex-col gap-1.5 font-bold sm:col-span-1">
              Nombre
              <input name="nombre" required autocomplete="name" placeholder="Ej.: Camila Rojas" class={input} />
            </label>
            <label class="col-span-2 flex flex-col gap-1.5 font-bold sm:col-span-1">
              Teléfono
              <input name="telefono" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+56 9 1234 5678" class={input} />
            </label>
            <label class="col-span-2 flex flex-col gap-1.5 font-bold">
              <span>Dirección <span class="text-noche-suave font-normal">(opcional)</span></span>
              <input name="direccion" autocomplete="street-address" class={input} />
            </label>
            <label class="col-span-2 flex flex-col gap-1.5 font-bold">
              <span>Mensaje <span class="text-noche-suave font-normal">(opcional)</span></span>
              <textarea name="mensaje" rows="2" placeholder="Tipo de evento, cantidad de niños, pasto o cemento" class={`${input} resize-y py-3`}></textarea>
            </label>
            <input name="website" hidden tabindex="-1" autocomplete="off" />
            <p class="text-noche-suave col-span-2 text-xs leading-5">Usamos tus datos solo para responder y coordinar tu evento, según la Ley 19.628 y la Ley 21.719. Más detalles en la <a href="/politica-de-privacidad" class="text-azul-texto underline">política de privacidad</a></p>
            <div class="col-span-2 min-h-[65px] w-[300px] max-w-full">
              <Turnstile theme="light" />
            </div>
            <button
              type="submit"
              data-reserva-boton
              class="bounce bg-rojo-texto border-noche shadow-pop col-span-2 min-h-14 cursor-pointer rounded-full border-2 px-6 text-[17px] leading-[22px] font-extrabold text-white disabled:cursor-not-allowed disabled:opacity-60 group-data-[state=sending]:pointer-events-none group-data-[state=sending]:opacity-75"
            >
              Elige la hora y tu comuna
            </button>
            <p data-reserva-mensaje aria-live="polite" class="text-noche-suave col-span-2 text-sm">
              Después te escribimos por WhatsApp para confirmar con el abono de {pesos(ABONO)}
            </p>
          </form>
        </div>

        <div data-paso="listo" hidden class="flex flex-col gap-3">
          <span class="border-noche bg-verde flex size-12 items-center justify-center rounded-full border-2">
            <Icon name="check" size={26} strokeWidth={3} />
          </span>
          <p class="font-display text-[26px] leading-8 font-semibold">¡Tu horario quedó reservado!</p>
          <p data-listo-detalle class="text-noche-suave"></p>
          <WaButton placement="reserva" size="l" message="Hola, acabo de reservar en saltabum.cl y quiero confirmar con el abono." class="text-center leading-[22px] lg:self-start">
            Confirmar por WhatsApp
          </WaButton>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { cargarDisponibilidad, enviarReserva, type Disponibilidad } from "@/lib/client/reservas";
  import {
    HORAS_BASE,
    HORAS_EXTRA_MAX,
    aHora,
    calcularPrecio,
    estaLibre,
    etiquetaHorario,
    iniciosPosibles,
    pesos,
    VALOR_HORA_EXTRA,
  } from "@/lib/reservas";

  const root = document.querySelector<HTMLElement>("[data-agenda]");
  if (root) iniciar(root);

  function iniciar(root: HTMLElement) {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const gridDias = $<HTMLElement>("[data-dias]");
    const tituloMes = $<HTMLElement>("[data-mes-titulo]");
    const btnAnterior = $<HTMLButtonElement>("[data-mes-anterior]");
    const btnSiguiente = $<HTMLButtonElement>("[data-mes-siguiente]");
    const estado = $<HTMLElement>("[data-agenda-estado]");
    const pasoDia = $<HTMLElement>('[data-paso="dia"]');
    const pasoArmar = $<HTMLElement>('[data-paso="armar"]');
    const pasoListo = $<HTMLElement>('[data-paso="listo"]');
    const tituloDia = $<HTMLElement>("[data-dia-titulo]");
    const gridInicios = $<HTMLElement>("[data-inicios]");
    const resumenInicio = $<HTMLElement>("[data-inicio-resumen]");
    const textoHoras = $<HTMLElement>("[data-horas]");
    const textoExtra = $<HTMLElement>("[data-horas-extra]");
    const btnMenos = $<HTMLButtonElement>("[data-menos]");
    const btnMas = $<HTMLButtonElement>("[data-mas]");
    const selComuna = $<HTMLSelectElement>("[data-comuna]");
    const form = $<HTMLFormElement>("[data-reserva]");
    const botonReservar = $<HTMLButtonElement>("[data-reserva-boton]");
    const mensaje = $<HTMLElement>("[data-reserva-mensaje]");
    const mensajeInicial = mensaje.textContent ?? "";

    const fechaLarga = new Intl.DateTimeFormat("es-CL", { weekday: "long", day: "numeric", month: "long", timeZone: "UTC" });
    const nombreMes = new Intl.DateTimeFormat("es-CL", { month: "long", year: "numeric", timeZone: "UTC" });
    const aFecha = (iso: string) => new Date(`${iso}T12:00:00Z`);
    const iso = (d: Date) => d.toISOString().slice(0, 10);

    let disp: Disponibilidad | undefined;
    let mes = ""; // "YYYY-MM"
    let dia: string | undefined;
    let inicio: number | undefined;
    let horas = HORAS_BASE;
    const producto = () => root.querySelector<HTMLInputElement>("[data-producto]:checked")?.value ?? "megatobogan";

    /** Horas de inicio libres ese día para el juego y la duración elegidos. */
    const libres = (fecha: string, h = horas) =>
      iniciosPosibles(h).filter((m) => estaLibre(fecha, producto(), m, h, disp?.ocupados ?? []));

    function pintarMes() {
      if (!disp) return;
      const [y, m] = mes.split("-").map(Number);
      const primero = new Date(Date.UTC(y, m - 1, 1, 12));
      tituloMes.textContent = nombreMes.format(primero);
      btnAnterior.disabled = mes <= disp.desde.slice(0, 7);
      btnSiguiente.disabled = mes >= disp.hasta.slice(0, 7);

      gridDias.replaceChildren();
      const vacios = (primero.getUTCDay() + 6) % 7; // semana parte el lunes
      for (let i = 0; i < vacios; i++) gridDias.append(document.createElement("span"));

      const diasDelMes = new Date(Date.UTC(y, m, 0)).getUTCDate();
      for (let d = 1; d <= diasDelMes; d++) {
        const fecha = iso(new Date(Date.UTC(y, m - 1, d, 12)));
        const boton = document.createElement("button");
        boton.type = "button";
        boton.textContent = String(d);
        boton.dataset.fecha = fecha;
        const fuera = fecha < disp.desde || fecha > disp.hasta;
        // El color del día se calcula con la duración base (3 horas).
        const n = fuera ? 0 : libres(fecha, HORAS_BASE).length;
        const tipo = fuera ? "fuera" : n === 0 ? "lleno" : n < 8 ? "pocos" : "libre";
        boton.dataset.estado = tipo;
        boton.disabled = tipo === "fuera" || tipo === "lleno";
        boton.setAttribute("aria-pressed", String(fecha === dia));
        const textoEstado = { fuera: "no disponible", lleno: "sin horarios", pocos: "quedan pocos horarios", libre: "con horarios libres" }[tipo];
        boton.setAttribute("aria-label", `${fechaLarga.format(aFecha(fecha))}, ${textoEstado}`);
        boton.className =
          "min-h-11 cursor-pointer rounded-xl border-2 text-[15px] font-extrabold aria-pressed:bg-noche aria-pressed:text-crema aria-pressed:border-noche aria-pressed:shadow-sol disabled:cursor-not-allowed lg:min-h-13 lg:text-base " +
          {
            fuera: "border-transparent text-noche-suave/40",
            lleno: "border-noche/20 bg-arena text-noche-suave line-through",
            pocos: "border-noche bg-sol",
            libre: "border-noche bg-verde-burbuja",
          }[tipo];
        boton.addEventListener("click", () => elegirDia(fecha));
        gridDias.append(boton);
      }
    }

    function elegirDia(fecha: string) {
      dia = fecha;
      pasoDia.hidden = true;
      pasoListo.hidden = true;
      pasoArmar.hidden = false;
      tituloDia.textContent = fechaLarga.format(aFecha(fecha));
      gridDias.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x.dataset.fecha === fecha)));
      pintarInicios();
    }

    /** Dibuja las horas de inicio de la duración elegida; las que chocan con otra reserva quedan tachadas. */
    function pintarInicios() {
      if (!dia) return;
      const ok = new Set(libres(dia));
      if (inicio !== undefined && !ok.has(inicio)) inicio = undefined;
      gridInicios.replaceChildren(
        ...iniciosPosibles(horas).map((m) => {
          const b = document.createElement("button");
          b.type = "button";
          b.textContent = aHora(m);
          b.disabled = !ok.has(m);
          b.setAttribute("aria-pressed", String(m === inicio));
          b.setAttribute("aria-label", `${aHora(m)}${b.disabled ? ", ocupado" : ""}`);
          b.className =
            "border-noche bg-verde-burbuja aria-pressed:bg-noche aria-pressed:text-crema aria-pressed:shadow-sol min-h-11 cursor-pointer rounded-xl border-2 text-[15px] font-extrabold disabled:cursor-not-allowed disabled:border-noche/20 disabled:bg-arena disabled:text-noche-suave disabled:line-through";
          b.addEventListener("click", () => {
            inicio = m;
            pintarInicios();
          });
          return b;
        }),
      );
      if (ok.size === 0) resumenInicio.textContent = "Con esta duración no quedan horarios ese día, prueba con menos horas o con otro día";
      else if (inicio === undefined) resumenInicio.textContent = "Elige a qué hora quieres que esté listo el juego";
      else resumenInicio.textContent = `De ${etiquetaHorario(inicio, inicio + horas * 60)}`;
      actualizar();
    }

    function cambiarHoras(delta: number) {
      horas = Math.min(HORAS_BASE + HORAS_EXTRA_MAX, Math.max(HORAS_BASE, horas + delta));
      pintarInicios();
    }

    /** Duración, desglose del precio y texto del botón. */
    function actualizar() {
      const extra = horas - HORAS_BASE;
      textoHoras.textContent = String(horas);
      textoExtra.textContent = extra ? `${extra} adicional${extra > 1 ? "es" : ""} de ${pesos(VALOR_HORA_EXTRA)}` : "Sin horas adicionales";
      btnMenos.disabled = horas <= HORAS_BASE;
      btnMas.disabled = horas >= HORAS_BASE + HORAS_EXTRA_MAX;

      const comuna = selComuna.value || undefined;
      const p = calcularPrecio(producto(), horas, comuna);
      $<HTMLElement>("[data-precio-base]").textContent = pesos(p.base);
      $<HTMLElement>("[data-linea-extra]").textContent = extra ? `${extra} hora${extra > 1 ? "s" : ""} adicional${extra > 1 ? "es" : ""}` : "Horas adicionales";
      $<HTMLElement>("[data-precio-extra]").textContent = extra ? pesos(p.extras) : "$0";
      $<HTMLElement>("[data-linea-despacho]").textContent = comuna ? `Despacho a ${comuna}` : "Despacho";
      $<HTMLElement>("[data-precio-despacho]").textContent = comuna ? pesos(p.despacho) : "Elige tu comuna";
      $<HTMLElement>("[data-precio-total]").textContent = `$${p.total.toLocaleString("es-CL")}`;

      const listo = dia && inicio !== undefined && comuna;
      botonReservar.disabled = !listo;
      botonReservar.textContent = listo
        ? `Reservar de ${etiquetaHorario(inicio!, inicio! + horas * 60)}`
        : inicio === undefined
          ? "Elige la hora de inicio"
          : "Elige tu comuna";
    }

    btnMenos.addEventListener("click", () => cambiarHoras(-1));
    btnMas.addEventListener("click", () => cambiarHoras(1));
    selComuna.addEventListener("change", actualizar);
    root.querySelectorAll("[data-producto]").forEach((r) =>
      r.addEventListener("change", () => {
        pintarMes();
        pintarInicios();
      }),
    );

    btnAnterior.addEventListener("click", () => cambiarMes(-1));
    btnSiguiente.addEventListener("click", () => cambiarMes(1));
    function cambiarMes(delta: number) {
      const [y, m] = mes.split("-").map(Number);
      mes = iso(new Date(Date.UTC(y, m - 1 + delta, 1, 12))).slice(0, 7);
      pintarMes();
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const comuna = selComuna.value;
      if (!dia || inicio === undefined || !comuna || form.dataset.state === "sending") return;
      form.dataset.state = "sending";
      botonReservar.disabled = true;
      mensaje.textContent = "Reservando…";
      const data = new FormData(form);
      const txt = (k: string) => (typeof data.get(k) === "string" ? (data.get(k) as string) : undefined);
      const fecha = dia;
      const desde = inicio;
      const r = await enviarReserva({
        fecha,
        producto: producto() as never,
        inicio: aHora(desde),
        horas,
        nombre: txt("nombre") ?? "",
        telefono: txt("telefono") ?? "",
        comuna,
        direccion: txt("direccion"),
        mensaje: txt("mensaje"),
        turnstile_token: txt("cf-turnstile-response"),
        website: txt("website"),
      });
      form.dataset.state = "idle";
      window.turnstile?.reset();

      if (r.ok) {
        const fin = desde + horas * 60;
        disp?.ocupados.push({ fecha, producto: producto(), inicio: desde, fin });
        const total = calcularPrecio(producto(), horas, comuna).total;
        root.querySelector("[data-listo-detalle]")!.textContent =
          `${fechaLarga.format(aFecha(fecha))}, de ${etiquetaHorario(desde, fin)} en ${comuna}, total ${pesos(total)}. Te escribimos por WhatsApp para confirmar con el abono`;
        pasoArmar.hidden = true;
        pasoListo.hidden = false;
        form.reset();
        inicio = undefined;
        mensaje.textContent = mensajeInicial;
        pintarMes();
        return;
      }
      actualizar();
      if (r.error === "ocupado") {
        mensaje.textContent = "Ese horario se acaba de tomar, elige otro";
        await recargar();
        elegirDia(fecha);
        return;
      }
      mensaje.textContent =
        r.error === "captcha"
          ? "No pudimos verificar que no eres un robot, inténtalo de nuevo"
          : r.error === "limite"
            ? "Ya hiciste varias reservas hoy, escríbenos por WhatsApp para agendar otra"
            : "No pudimos reservar, inténtalo de nuevo o escríbenos por WhatsApp";
    });

    async function recargar() {
      try {
        disp = await cargarDisponibilidad();
        mes ||= disp.desde.slice(0, 7);
        estado.textContent = "";
        estado.hidden = true;
        pintarMes();
      } catch {
        estado.textContent = "No pudimos cargar la disponibilidad, escríbenos por WhatsApp";
      }
    }
    actualizar();
    void recargar();
  }
</script>
