---
// «¿Cabe en tu espacio?»: medidas reales y modelo 3D del Megatobogán a escala 1:1 (armado por código en
// scripts/generar-modelo-3d.mjs a partir del video real, hasta que exista un escaneo).
// En el celular, «Verlo en tu espacio» lo pone en el terreno con la cámara (realidad aumentada:
// WebXR / Scene Viewer en Android y Quick Look en iPhone). El visor (model-viewer) se descarga
// recién cuando la sección se acerca a la pantalla.
import { getImage } from "astro:assets";
import QRCode from "qrcode";
import portada from "../assets/megatobogan-real-frente.jpg";
import { MODELO_3D, PRODUCTO } from "../data";
import { RUTAS } from "../seo";
import Cielo from "../components/Cielo.astro";
import Icon from "../components/Icon.astro";
import WhatsAppLink from "@/components/core/WhatsAppLink.astro";

const poster = await getImage({ src: portada, width: 1200, height: 800, fit: "cover", position: "center", format: "webp", quality: 80 });

// QR (SVG generado en el build) que abre en el celular la página «ver en tu espacio»: el modelo 3D con el botón
// para ponerlo en el suelo con la cámara.
const enlace = new URL(RUTAS.verEnTuEspacio, Astro.site).href;
const qr = await QRCode.toString(enlace, {
  type: "svg",
  margin: 1,
  errorCorrectionLevel: "M",
  color: { dark: "#1f2a5cff", light: "#ffffffff" },
});

const MENSAJE = `Hola, quiero saber si el ${PRODUCTO.nombre} cabe en el lugar de mi evento. Les mando una foto. Vengo de saltabum.cl`;
const MEDIDAS = [
  { icon: "despacho", label: "Base", valor: PRODUCTO.base },
  { icon: "alto", label: "Alto", valor: PRODUCTO.alto },
  { icon: "capacidad", label: "Espacio libre", valor: PRODUCTO.espacioLibre },
  { icon: "electricidad", label: "Enchufe", valor: "A menos de 15 m" },
] as const;
const REQUISITOS = [
  `Pasto o piso firme y parejo, sin ramas ni techos bajo los ${PRODUCTO.alto}`,
  "Un enchufe a menos de 15 m, consume menos de $2.000 por evento",
  "Un acceso por donde entrar con el juego enrollado",
];
---

<section id="patio" aria-labelledby="patio-titulo" class="border-noche bg-celeste text-noche relative isolate overflow-hidden border-b-2" data-cielo>
  <Cielo />
  <div data-cielo-contenido class="pointer-events-none mx-auto flex max-w-[1320px] flex-col gap-6 px-4 py-10 md:max-w-[680px] lg:max-w-[1320px] lg:flex-row lg:items-center lg:gap-14 lg:px-10 lg:py-20">
    <div class="pointer-events-auto flex flex-col gap-5 lg:min-w-0 lg:flex-1 lg:gap-6">
      <div>
        <p class="text-xs font-extrabold tracking-[1.2px] uppercase">Medidas</p>
        <h2 id="patio-titulo" class="font-display mt-1.5 text-[34px] leading-[38px] font-semibold lg:text-5xl lg:leading-[52px]">
          ¿Cabe en tu espacio?
        </h2>
        <p class="mt-2 lg:mt-3 lg:text-lg">Gíralo en 3D o míralo en tu patio a tamaño real</p>
      </div>

      <dl class="hidden grid-cols-2 gap-2.5 lg:grid">
        {
          MEDIDAS.map((m) => (
            <div class="border-noche bg-blanco flex items-center gap-3 rounded-2xl border-2 px-3.5 py-3">
              <Icon name={m.icon} size={26} class="shrink-0" />
              <div>
                <dt class="text-noche-suave text-xs font-extrabold tracking-[1px] uppercase">{m.label}</dt>
                <dd class="font-display text-xl leading-6 font-semibold">{m.valor}</dd>
              </div>
            </div>
          ))
        }
      </dl>

      <ul class="hidden flex-col gap-2.5 font-semibold lg:flex">
        {
          REQUISITOS.map((texto) => (
            <li class="flex items-start gap-2.5">
              <span class="border-noche bg-blanco flex size-7 shrink-0 items-center justify-center rounded-full border-2">
                <Icon name="check" size={16} strokeWidth={3.2} />
              </span>
              {texto}
            </li>
          ))
        }
      </ul>

      <WhatsAppLink
        placement="patio"
        message={MENSAJE}
        class="bounce border-noche bg-blanco text-noche shadow-pop inline-flex min-h-13 items-center justify-center rounded-full border-2 px-5 text-center leading-[21px] font-extrabold no-underline lg:self-start"
      >
        ¿Dudas? Mándanos una foto del lugar
      </WhatsAppLink>
    </div>

    <div class="pointer-events-auto lg:min-w-0 lg:flex-1">
      <div class="border-noche bg-blanco shadow-pop-l relative overflow-hidden rounded-[28px] border-2">
        <model-viewer
          data-modelo-3d
          src={MODELO_3D}
          poster={poster.src}
          alt={`Modelo 3D del ${PRODUCTO.nombre} a tamaño real: ${PRODUCTO.base} de base y ${PRODUCTO.alto} de alto`}
          loading="lazy"
          camera-controls
          touch-action="pan-y"
          auto-rotate
          auto-rotate-delay="1500"
          rotation-per-second="18deg"
          interaction-prompt="auto"
          shadow-intensity="1"
          exposure="1.05"
          camera-orbit="30deg 74deg 100%"
          ar
          ar-modes="webxr scene-viewer quick-look"
          ar-scale="fixed"
          ar-placement="floor"
          class="block h-[380px] w-full bg-[radial-gradient(circle_at_50%_40%,#fff6ea_0%,#f3e6d3_100%)] sm:h-[460px] lg:h-[540px]"
        >
          <button
            slot="ar-button"
            type="button"
            class="bounce bg-verde border-noche shadow-pop absolute bottom-4 left-1/2 inline-flex min-h-13 -translate-x-1/2 cursor-pointer items-center gap-2 rounded-full border-2 px-6 font-extrabold whitespace-nowrap"
          >
            <Icon name="despacho" size={22} />
            Verlo en tu espacio
          </button>
        </model-viewer>
        <p class="bg-crema/90 text-noche-suave pointer-events-none absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-bold">
          Arrastra para girar · tamaño real
        </p>
      </div>
      <p class="mt-3 hidden text-sm">
        En el celular, toca «Verlo en tu espacio», apunta al suelo y retrocede unos 10 metros. El Megatobogán aparece a tamaño real, con el espacio libre marcado en el suelo, para que veas si cabe
      </p>
      <!-- En computador no hay realidad aumentada: un QR abre esta misma sección en el celular. -->
      <div class="border-noche bg-blanco mt-4 hidden items-center gap-5 rounded-[20px] border-2 p-4 lg:flex">
        <div class="border-noche size-[120px] shrink-0 overflow-hidden rounded-xl border-2 p-1 [&_svg]:size-full" data-qr={enlace} set:html={qr} />
        <div class="flex flex-col gap-1.5">
          <p class="font-display text-[21px] leading-[26px] font-semibold">Míralo en tu espacio con el celular</p>
          <p class="text-noche-suave text-[15px] leading-[21px]">
            Escanea el código con la cámara, toca «Verlo en tu espacio», apunta al suelo y retrocede unos 10 metros. El Megatobogán aparece a tamaño real, con el espacio libre marcado
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Carga el visor 3D solo cuando la sección está por aparecer en pantalla.
  const visor = document.querySelector("[data-modelo-3d]");
  if (visor) {
    let cargado = false;
    const cargar = () => {
      if (cargado) return;
      cargado = true;
      window.removeEventListener("scroll", alAcercarse);
      void import("@google/model-viewer");
    };
    // Respaldo por si el observador no se dispara: revisa la posición al hacer scroll.
    const alAcercarse = () => {
      if (visor.getBoundingClientRect().top < innerHeight + 400) cargar();
    };
    window.addEventListener("scroll", alAcercarse, { passive: true });
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entradas) => {
          if (entradas.some((e) => e.isIntersecting)) {
            io.disconnect();
            cargar();
          }
        },
        { rootMargin: "400px" },
      );
      io.observe(visor);
    } else cargar();
  }
</script>
