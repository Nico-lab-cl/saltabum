---
import { Image } from "astro:assets";
import foto from "../assets/megatobogan-arcoiris.webp";
import { mensajeWhatsapp, OTROS_JUEGOS, PRODUCTO } from "../data";
import FotoPendiente from "../components/FotoPendiente.astro";
import WaButton from "../components/WaButton.astro";

const FILTROS = [
  { grupo: "Filtrar por edad", opciones: ["Todas", "1–4 años", "5–9 años", "10+ años"] },
  { grupo: "Filtrar por tipo", opciones: ["Todos", "Castillos", "Toboganes", "Acuáticos", "Plaza blanda", "Entretenciones"] },
];
const DATOS = [
  { label: "Edad", valor: "3–12", unidad: "años" },
  { label: "Base", valor: "7,5×7,5", unidad: "metros" },
  { label: "Alto", valor: "3,5", unidad: "metros" },
];
---

<section id="juegos" class="mx-auto max-w-[1320px] py-10 lg:px-10 lg:pt-20">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="px-4 lg:px-0">
      <p class="text-rojo-texto text-xs font-extrabold tracking-[1.2px] uppercase">Catálogo · precios a la vista</p>
      <h2 class="font-display mt-1.5 text-[32px] leading-9 font-semibold lg:text-5xl lg:leading-[52px]">Elige su juego</h2>
    </div>
    <div class="flex flex-col gap-2 lg:items-end">
      {
        FILTROS.map((f) => (
          <div role="group" aria-label={f.grupo} class="sin-scrollbar flex gap-2 overflow-x-auto px-4 py-0.5 lg:flex-wrap lg:justify-end lg:overflow-visible lg:px-0">
            {f.opciones.map((op, i) => (
              <button
                type="button"
                data-chip
                aria-pressed={i === 0 ? "true" : "false"}
                class="border-noche bg-blanco text-noche aria-pressed:bg-noche aria-pressed:text-crema aria-pressed:shadow-sol min-h-11 shrink-0 cursor-pointer rounded-full border-2 px-4 text-[15px] font-bold whitespace-nowrap"
              >
                {op}
              </button>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-5 flex flex-col gap-6 px-4 lg:mt-7 lg:flex-row lg:px-0">
    <article
      class="border-noche bg-blanco shadow-pop flex flex-col overflow-hidden rounded-3xl border-2 lg:flex-[2] lg:flex-row lg:rounded-[28px] lg:shadow-pop-l"
    >
      <div class="border-noche relative aspect-square border-b-2 lg:aspect-auto lg:min-h-[420px] lg:flex-1 lg:border-r-2 lg:border-b-0">
        <Image
          src={foto}
          alt={`${PRODUCTO.nombre} instalado`}
          widths={[400, 700]}
          sizes="(min-width: 1024px) 420px, 92vw"
          class="absolute inset-0 size-full object-cover object-[50%_51%]"
        />
        <span class="bg-sol border-noche absolute top-3 left-3 rounded-full border-2 px-2.5 py-1 text-xs font-extrabold tracking-[1px] uppercase">
          Tobogán + túneles
        </span>
      </div>
      <div class="flex flex-col gap-3.5 p-4 lg:flex-1 lg:gap-4 lg:p-7">
        <h3 class="font-display text-[26px] leading-[30px] font-semibold lg:text-[34px] lg:leading-[38px]">{PRODUCTO.nombre}</h3>
        <p class="text-noche-suave hidden lg:block">Para subir, cruzar túneles y tirarse en tobogán toda la tarde.</p>
        <dl class="grid grid-cols-3 gap-2 lg:gap-2.5">
          {
            DATOS.map((d) => (
              <div class="bg-arena rounded-xl px-2 py-2.5 text-center lg:rounded-[14px] lg:py-3">
                <dt class="text-noche-suave text-[11px] leading-[14px] font-extrabold tracking-[1px] uppercase">{d.label}</dt>
                <dd class="font-display text-xl leading-6 font-semibold lg:text-2xl lg:leading-7">{d.valor}</dd>
                <dd class="text-noche-suave text-xs">{d.unidad}</dd>
              </div>
            ))
          }
        </dl>
        <p class="text-noche-suave text-sm lg:mt-auto lg:text-[15px]">
          desde <strong class="font-display text-noche text-2xl font-bold lg:text-[34px]">{PRODUCTO.precio}</strong> · 4 horas
        </p>
        <div class="flex flex-wrap gap-2.5">
          <WaButton placement="tarjeta" size="m" message={mensajeWhatsapp(PRODUCTO.nombre)} class="flex-1">Consultar</WaButton>
          <a
            href="#contacto"
            class="bounce border-noche bg-blanco text-noche inline-flex min-h-13 items-center justify-center rounded-full border-2 px-5 font-extrabold no-underline"
          >
            Ver ficha
          </a>
        </div>
      </div>
    </article>

    <div class="flex flex-col gap-3 lg:flex-1 lg:gap-6">
      <h3 class="font-display text-xl font-semibold lg:hidden">Más juegos</h3>
      <div class="sin-scrollbar -mx-4 flex snap-x gap-3 overflow-x-auto px-4 pb-2 lg:mx-0 lg:flex-col lg:gap-6 lg:overflow-visible lg:px-0">
        {
          OTROS_JUEGOS.map((p, i) => (
            <article class:list={["border-noche bg-blanco flex w-[200px] shrink-0 snap-start flex-col overflow-hidden rounded-[20px] border-2 shadow-[0_3px_0_var(--color-noche)] lg:w-auto lg:flex-1 lg:flex-row lg:rounded-3xl lg:shadow-pop", i === 2 && "lg:hidden"]}>
              <FotoPendiente texto={p.foto} class="border-noche h-32 border-b-2 lg:h-auto lg:w-[42%] lg:border-r-2 lg:border-b-0" />
              <div class="flex flex-col gap-1 px-3 pt-2.5 pb-3 lg:px-4 lg:py-4.5">
                <strong class="font-display text-lg leading-[22px] font-semibold lg:text-[22px] lg:leading-[26px]">{p.nombre}</strong>
                <span class="text-noche-suave text-[13px] lg:text-sm">{p.meta}</span>
                <span class="mt-auto font-extrabold">{p.precio}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Chips de filtro: uno activo por grupo (el filtrado real llega con el catálogo completo).
  document.querySelectorAll<HTMLElement>("[role=group]").forEach((group) => {
    const chips = group.querySelectorAll<HTMLButtonElement>("[data-chip]");
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      }),
    );
  });
</script>
