---
// Hero con foto de fondo a sangre del Megatobogán sobre pasto (imagen referencial, 3840 px). Recorte horizontal en desktop y vertical en
// mobile, servidos en AVIF con respaldo WebP y en varios anchos para que cada pantalla baje solo lo que necesita.
import { getImage } from "astro:assets";
import fondo from "../assets/hero-inflable.jpg";
import fondoMovil from "../assets/hero-inflable-movil.jpg";
import { DESDE, DESDE_HORAS, PRODUCTO } from "../data";
import WaButton from "../components/WaButton.astro";

// Calidad alta: la foto es la protagonista del primer pantallazo.
const ANCHOS = [1280, 1920, 2560, 3200, 3840];
const ANCHOS_MOVIL = [640, 960, 1500];
const [avif, webp, avifMovil, webpMovil] = await Promise.all([
  getImage({ src: fondo, widths: ANCHOS, format: "avif", quality: 85 }),
  getImage({ src: fondo, widths: ANCHOS, format: "webp", quality: 90 }),
  getImage({ src: fondoMovil, widths: ANCHOS_MOVIL, format: "avif", quality: 85 }),
  getImage({ src: fondoMovil, widths: ANCHOS_MOVIL, format: "webp", quality: 90 }),
]);
---

<section id="inicio" class="bg-noche text-crema relative isolate overflow-hidden">
  <picture>
    <source media="(min-width: 1024px)" srcset={avif.srcSet.attribute} sizes="100vw" type="image/avif" />
    <source media="(min-width: 1024px)" srcset={webp.srcSet.attribute} sizes="100vw" type="image/webp" />
    <source srcset={avifMovil.srcSet.attribute} sizes="100vw" type="image/avif" />
    <img
      src={webpMovil.src}
      srcset={webpMovil.srcSet.attribute}
      sizes="100vw"
      width="1500"
      height="2160"
      alt={`${PRODUCTO.nombre} instalado sobre pasto, con niños bajando por el tobogán, saliendo del túnel y saltando`}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-20 size-full object-cover object-[50%_70%] lg:object-[70%_75%]"
    />
  </picture>
  <!-- Capa noche para que el texto se lea sobre la foto: arriba en mobile, a la izquierda en desktop. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(31_42_92/0.88)_0%,rgb(31_42_92/0.68)_50%,rgb(31_42_92/0.4)_100%)] lg:bg-[linear-gradient(90deg,rgb(31_42_92/0.9)_0%,rgb(31_42_92/0.7)_38%,rgb(31_42_92/0)_70%)]"
  ></div>

  <div class="mx-auto flex min-h-[620px] max-w-[1320px] flex-col justify-center gap-5 px-4 pt-10 pb-12 lg:min-h-[min(760px,82vh)] lg:px-10 lg:py-20">
    <div class="flex max-w-[640px] flex-col gap-5">
      <h1 class="font-display text-[44px] leading-[1.05] font-semibold tracking-tight lg:text-[clamp(52px,5.6vw,80px)] lg:leading-[1.02]">
        ¡A <span class="text-sol">saltar</span> se ha dicho!
      </h1>
      <p class="text-lg leading-[26px] lg:text-[21px] lg:leading-[31px]">
        <span class="block">Arriendo de inflables <strong class="font-extrabold">desde {DESDE} por {DESDE_HORAS}</strong>, con montaje, anclaje y retiro incluidos</span>
        <span class="mt-1 block">Tú organizas el evento y nosotros llevamos la diversión</span>
      </p>

      <div class="flex flex-col gap-3 sm:flex-row lg:mt-1 lg:gap-3.5">
        <WaButton placement="hero" size="l" class="text-center leading-[22px]">Consultar disponibilidad por WhatsApp</WaButton>
        <a
          href="#megatobogan"
          class="bounce border-crema text-crema hover:bg-crema hover:text-noche inline-flex min-h-12 items-center justify-center rounded-full border-2 px-7 font-extrabold whitespace-nowrap no-underline lg:min-h-15 lg:text-lg"
        >
          Ver medidas y precio
        </a>
      </div>

      <dl class="border-crema/30 mt-1 grid max-w-[460px] grid-cols-2 gap-2.5 border-t-2 border-dashed pt-4 lg:mt-2 lg:pt-5">
        <div class="flex flex-col gap-0.5">
          <dt class="font-display text-2xl leading-7 font-bold lg:text-[34px] lg:leading-10">+15</dt>
          <dd class="text-[13px] leading-[17px] lg:text-sm">eventos en la V Región de Valparaíso</dd>
        </div>
        <div class="flex flex-col gap-0.5">
          <dt class="font-display text-2xl leading-7 font-bold lg:text-[34px] lg:leading-10">10–15</dt>
          <dd class="text-[13px] leading-[17px] lg:text-sm">minutos de montaje</dd>
        </div>
      </dl>
    </div>
  </div>

  <div
    class="border-noche bg-celeste text-noche shadow-pop absolute right-6 bottom-8 hidden size-33 -rotate-12 flex-col items-center justify-center rounded-full border-2 text-center lg:flex xl:right-16"
  >
    <span class="text-sm leading-[15px] font-extrabold">desde</span>
    <span class="font-display text-[28px] leading-8 font-bold">{DESDE}</span>
    <span class="text-sm leading-[15px] font-extrabold">{DESDE_HORAS}</span>
  </div>

</section>

