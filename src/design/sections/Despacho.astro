---
import { COMUNAS, mensajeWhatsapp, PRODUCTO, TONO_BG } from "../data";
import WaButton from "../components/WaButton.astro";

const inicial = COMUNAS[0];
---

<section id="despacho" aria-labelledby="despacho-titulo" data-despacho>
  <div class="mx-auto max-w-[1320px] px-4 py-10 lg:px-10 lg:py-20">
    <div class="flex flex-col gap-2 lg:flex-row lg:items-end lg:justify-between lg:gap-4">
      <div>
        <p class="text-rojo-texto text-xs font-extrabold tracking-[1.2px] uppercase">Despacho</p>
        <h2 id="despacho-titulo" class="font-display mt-1.5 text-[32px] leading-9 font-semibold lg:text-5xl lg:leading-[52px]">
          ¿Llegamos a tu comuna?
        </h2>
      </div>
      <p class="text-noche-suave max-w-[420px]">Elige tu comuna y ve el despacho antes de preguntar. Montaje y retiro siempre incluidos.</p>
    </div>

    <div role="radiogroup" aria-label="Elige tu comuna" class="relative mt-5 flex flex-col gap-2 lg:mt-9 lg:flex-row lg:justify-between lg:gap-3">
      <span aria-hidden="true" class="border-noche absolute top-6 bottom-6 left-[25px] border-l-[3px] border-dashed lg:top-[31px] lg:right-10 lg:bottom-auto lg:left-10 lg:border-t-[3px] lg:border-l-0"></span>
      {
        COMUNAS.map((c, i) => (
          <button
            type="button"
            role="radio"
            aria-checked={i === 0 ? "true" : "false"}
            data-comuna={c.nombre}
            data-titulo={c.titulo}
            data-zonas={c.zonas}
            class="group border-noche bg-blanco text-noche aria-checked:bg-noche aria-checked:text-crema aria-checked:shadow-sol relative flex min-h-15 cursor-pointer items-center gap-3.5 rounded-[20px] border-2 py-2 pr-3 pl-3.5 text-left lg:flex-1 lg:flex-col lg:gap-2 lg:rounded-3xl lg:border-transparent lg:bg-transparent lg:px-2.5 lg:pt-4.5 lg:pb-4 lg:text-center lg:aria-checked:border-noche lg:aria-checked:shadow-[0_5px_0_var(--color-sol)]"
          >
            <span class:list={["border-noche group-aria-checked:border-crema size-[22px] shrink-0 rounded-full border-2 lg:size-6 lg:group-aria-checked:size-7.5", TONO_BG[c.tono]]}></span>
            <span class="flex-1 lg:flex-none">
              <strong class="block leading-5 font-extrabold lg:text-[17px]">{c.nombre}</strong>
              <span class="text-[13px] leading-[18px] opacity-85 lg:hidden">{c.zonas}</span>
            </span>
            <span class:list={["border-noche group-aria-checked:border-crema text-noche shrink-0 rounded-full border-2 px-2.5 py-0.5 text-sm font-extrabold", TONO_BG[c.tono]]}>
              {c.precio}
            </span>
          </button>
        ))
      }
    </div>

    <div
      aria-live="polite"
      class="lg:border-noche lg:bg-blanco mt-4 flex flex-col gap-3 lg:mt-8 lg:flex-row lg:items-center lg:gap-6 lg:rounded-3xl lg:border-2 lg:px-7 lg:py-5.5 lg:shadow-[0_5px_0_var(--color-noche)]"
    >
      <div class="hidden lg:block lg:flex-1">
        <strong data-out="titulo" class="font-display block text-3xl leading-[34px] font-semibold">{inicial.titulo}</strong>
        <span class="text-noche-suave"><span data-out="comuna">{inicial.nombre}</span> · <span data-out="zonas">{inicial.zonas}</span> · montaje y retiro incluidos.</span>
      </div>
      <WaButton placement="despacho" size="l" message={mensajeWhatsapp(PRODUCTO.nombre, inicial.nombre)} class="w-full lg:w-auto">
        Consultar fecha para <span data-out="comuna">{inicial.nombre}</span>
      </WaButton>
    </div>
    <p class="text-noche-suave mt-2.5 text-center text-[13px] lg:text-left">Valores por confirmar.</p>
  </div>
</section>

<script>
  import { mensajeWhatsapp, PRODUCTO } from "../data";

  document.querySelectorAll<HTMLElement>("[data-despacho]").forEach((root) => {
    const radios = root.querySelectorAll<HTMLButtonElement>("[role=radio]");
    const link = root.querySelector<HTMLAnchorElement>("a[data-track]");
    const select = (btn: HTMLButtonElement) => {
      radios.forEach((r) => r.setAttribute("aria-checked", String(r === btn)));
      const { comuna = "", titulo = "", zonas = "" } = btn.dataset;
      root.querySelectorAll('[data-out="comuna"]').forEach((el) => (el.textContent = comuna));
      root.querySelectorAll('[data-out="titulo"]').forEach((el) => (el.textContent = titulo));
      root.querySelectorAll('[data-out="zonas"]').forEach((el) => (el.textContent = zonas));
      if (link) {
        const url = new URL(link.href);
        url.search = `?text=${encodeURIComponent(mensajeWhatsapp(PRODUCTO.nombre, comuna))}`;
        link.href = url.toString();
      }
    };
    radios.forEach((btn) => btn.addEventListener("click", () => select(btn)));
    // Flechas para moverse dentro del radiogroup.
    root.addEventListener("keydown", (e) => {
      const i = [...radios].findIndex((r) => r === document.activeElement);
      if (i < 0 || !["ArrowDown", "ArrowRight", "ArrowUp", "ArrowLeft"].includes(e.key)) return;
      e.preventDefault();
      const next = radios[(i + (e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : radios.length - 1)) % radios.length];
      next.focus();
      select(next);
    });
  });
</script>
