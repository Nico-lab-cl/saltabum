---
// Ficha de un inflable sobre el cielo celeste, en la página de cada inflable. En el inicio van los 3 en un carrusel
// (NuestrosInflables). El contenido está en components/FichaInflable.astro.
import { inflable as buscar, type Inflable } from "../inflables";
import Cielo from "../components/Cielo.astro";
import FichaInflable from "../components/FichaInflable.astro";

interface Props {
  inflable?: Inflable;
  enPagina?: boolean;
}
const { inflable = buscar("megatobogan"), enPagina = false } = Astro.props;
---

<section id={inflable.id} aria-label={`Ficha del ${inflable.nombre}`} class="border-noche bg-celeste text-noche relative isolate overflow-hidden border-b-2" data-cielo>
  <Cielo />
  <div data-cielo-contenido class="pointer-events-none mx-auto max-w-[680px] px-4 py-10 lg:max-w-[1320px] lg:px-10 lg:py-20">
    <FichaInflable inflable={inflable} enPagina={enPagina} prioridad />
  </div>
</section>

<script>
  import { activarGalerias } from "../components/galeria";
  activarGalerias();
</script>
