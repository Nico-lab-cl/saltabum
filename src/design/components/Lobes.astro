---
// Borde de lóbulos (como el borde de un inflable) entre bandas de color.
// `side="top"`: lóbulos hacia arriba, va justo antes de la banda. `side="bottom"`: justo después.
interface Props {
  color: string;
  side: "top" | "bottom";
}
const { color, side } = Astro.props;
const id = `lob-${Math.random().toString(36).slice(2, 8)}`;
const d = side === "top" ? "M0 16 A15 15 0 0 1 30 16" : "M0 0 A15 15 0 0 0 30 0";
---

<svg
  width="100%"
  height="16"
  aria-hidden="true"
  class:list={["relative block", side === "top" ? "-mb-0.5" : "-mt-0.5"]}
>
  <defs>
    <pattern id={id} width="30" height="16" patternUnits="userSpaceOnUse">
      <path d={d} fill={color} stroke="#1F2A5C" stroke-width="2"></path>
    </pattern>
  </defs>
  <rect width="100%" height="16" fill={`url(#${id})`}></rect>
</svg>
