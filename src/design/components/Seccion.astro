---
// Sección de contenido con su título en la placa azul (TituloSeccion). `fondo` cambia el color (un color dominante por
// sección); «cielo» es el celeste con nubes y globos que se revientan (Cielo), como en «Nuestros inflables».
import Cielo from "./Cielo.astro";
import TituloSeccion from "./TituloSeccion.astro";

interface Props {
  titulo: string;
  eyebrow?: string;
  bajada?: string;
  id?: string;
  fondo?: "crema" | "blanco" | "arena" | "celeste" | "verde" | "cielo";
}
const { titulo, eyebrow, bajada, id, fondo = "crema" } = Astro.props;
const FONDOS = {
  crema: "bg-crema",
  blanco: "bg-blanco",
  arena: "bg-arena",
  celeste: "bg-celeste",
  verde: "bg-verde-burbuja",
  cielo: "bg-celeste relative isolate overflow-hidden",
};
const cielo = fondo === "cielo";
---

<section id={id} class:list={["border-noche border-b-2", FONDOS[fondo]]} data-cielo={cielo ? "" : undefined}>
  {cielo && <Cielo />}
  <div data-cielo-contenido={cielo ? "" : undefined} class="mx-auto flex max-w-[1320px] flex-col gap-5 px-4 py-10 lg:gap-8 lg:px-10 lg:py-16">
    <TituloSeccion titulo={titulo} eyebrow={eyebrow} bajada={bajada} />
    <slot />
  </div>
</section>
