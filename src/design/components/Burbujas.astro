---
// Fondo de preguntas: globos de diálogo con signo de pregunta, en los colores de la marca, que asoman por los
// bordes de la sección y flotan lento, sin pasar por detrás del texto.
// Va en una sección `relative isolate overflow-hidden bg-rojo-suave`.
const GLOBOS = [
  { pos: "left: 2%; top: -8px", s: 96, c: "#ffc23a", r: -10, d: "0s" },
  { pos: "left: -26px; top: 42%", s: 116, c: "#7fd3f7", r: 8, d: "-2s" },
  { pos: "left: 22%; bottom: -14px", s: 84, c: "#2db866", r: -6, d: "-4s" },
  { pos: "right: 4%; top: 6px", s: 104, c: "#ff6fae", r: 12, d: "-1s" },
  { pos: "right: -22px; top: 50%", s: 100, c: "#ff8a1f", r: -14, d: "-3s" },
  { pos: "right: 26%; bottom: -12px", s: 80, c: "#8e5be8", r: 6, d: "-5s" },
];
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  <div class="burbujas-puntos absolute inset-0"></div>
  {
    GLOBOS.map((g) => (
      <svg class="burbuja absolute" style={`${g.pos}; --s: ${g.s}px; --r: ${g.r}deg; --d: ${g.d}`} viewBox="0 0 48 48">
        <path
          d="M24 4c11 0 20 8 20 18s-9 18-20 18c-3 0-5.6-.5-8-1.4L6 42l2.8-8.4C5.8 30.4 4 26.4 4 22 4 12 13 4 24 4z"
          fill={g.c}
          stroke="#1f2a5c"
          stroke-width="2.5"
          stroke-linejoin="round"
        />
        <path d="M19.6 17.6a4.6 4.6 0 0 1 8.8 1.8c0 3.2-4.4 3.6-4.4 6.8" fill="none" stroke="#1f2a5c" stroke-width="3" stroke-linecap="round" />
        <circle cx="24" cy="31" r="1.8" fill="#1f2a5c" />
      </svg>
    ))
  }
</div>

<style>
  .burbujas-puntos {
    background-image: radial-gradient(rgb(240 70 45 / 0.24) 1.8px, transparent 2px);
    background-size: 26px 26px;
  }
  .burbuja {
    width: calc(var(--s) * 0.72);
    rotate: var(--r);
    animation: burbuja-flotar 7s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @media (min-width: 1024px) {
    .burbuja { width: var(--s); }
  }
  @keyframes burbuja-flotar {
    50% { translate: 0 -12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .burbuja { animation: none; }
  }
</style>
