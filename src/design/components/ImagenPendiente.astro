---
// Espacio para una imagen generada con IA que aún no está producida (lista en el brief, #1 a #10).
interface Props {
  n: number;
  ratio: string;
  texto: string;
  class?: string;
}
const { n, ratio, texto, class: className } = Astro.props;
---

<div
  role="img"
  aria-label={`Imagen pendiente: ${texto}`}
  class:list={[
    "border-noche text-noche flex flex-col items-center justify-center gap-1.5 border-2 border-dashed p-4 text-center",
    className,
  ]}
>
  <span class="bg-noche text-crema rounded-full px-3 py-0.5 text-xs font-extrabold tracking-[1px]">IMG {n} · {ratio}</span>
  <span class="max-w-[320px] leading-[21px] font-extrabold">{texto}</span>
</div>
