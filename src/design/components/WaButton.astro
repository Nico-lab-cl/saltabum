---
// Botón de WhatsApp de la marca: siempre el mismo componente (WhatsAppLink → tracking),
// con una posición (`placement`) y un tamaño.
import WhatsAppLink from "@/components/core/WhatsAppLink.astro";
import Icon from "./Icon.astro";

interface Props {
  placement: string;
  message?: string;
  size?: "s" | "m" | "l";
  icon?: boolean;
  class?: string;
}
const { placement, message, size = "m", icon = true, class: className } = Astro.props;

const SIZES = {
  s: "min-h-11 px-4 text-base gap-2 shadow-pop-s",
  m: "min-h-13 px-5 text-[17px] gap-2 shadow-[0_3px_0_var(--color-noche)]",
  l: "min-h-14 px-6 text-[17px] lg:min-h-15 lg:px-7 lg:text-lg gap-2.5 shadow-pop lg:shadow-[0_5px_0_var(--color-noche)]",
};
---

<WhatsAppLink
  placement={placement}
  message={message}
  class:list={[
    "bounce bg-verde text-noche border-noche inline-flex items-center justify-center rounded-full border-2 font-extrabold no-underline",
    SIZES[size],
    className,
  ]}
>
  {icon && <Icon name="whatsapp" size={size === "s" ? 20 : 24} />}
  <slot>WhatsApp</slot>
</WhatsAppLink>
