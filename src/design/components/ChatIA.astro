---
// Burbuja del chat con IA (abajo a la derecha). Solo lo visual: la lógica está en src/lib/client/chat.ts y se engancha
// por estos atributos:
//   [data-chat] (raíz, recibe data-abierto) · [data-chat-abrir] · [data-chat-cerrar] · [data-chat-panel]
//   [data-chat-lista] (mensajes) · <template data-chat-plantilla="cliente|ia|equipo|sistema"> con [data-chat-texto]
//   [data-chat-escribiendo] · <form data-chat-form> con <textarea name="texto"> · [data-chat-whatsapp] (enlace oculto)
//   [data-chat-pendientes] (contador de respuestas del equipo que llegaron con el chat cerrado)
//   <form data-chat-contacto> con nombre, email y telefono (se pide antes de chatear) y [data-chat-contacto-error]
//   El <form data-chat-form> parte oculto y se muestra cuando ya están los datos.
import Icon from "./Icon.astro";
---

<div data-chat class="group fixed right-4 bottom-24 z-40 lg:right-6 lg:bottom-6">
  <section
    data-chat-panel
    role="dialog"
    aria-label="Chat con Saltabum"
    hidden
    class="border-noche bg-crema text-noche shadow-pop-l fixed inset-x-3 top-20 bottom-3 flex flex-col overflow-hidden rounded-[24px] border-2 sm:absolute sm:inset-auto sm:right-0 sm:bottom-0 sm:h-[min(620px,calc(100dvh-120px))] sm:w-[380px]"
  >
    <header class="border-noche bg-sol flex items-center gap-3 border-b-2 px-4 py-3">
      <span class="border-noche bg-blanco grid size-10 shrink-0 place-items-center rounded-full border-2">
        <Icon name="chat" size={22} />
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-display text-lg leading-tight font-semibold">Eduardo · Saltabum</p>
        <p class="text-noche-suave flex items-center gap-1.5 text-xs font-bold">
          <span class="bg-verde size-2 rounded-full"></span>
          En línea
        </p>
      </div>
      <button type="button" data-chat-cerrar aria-label="Cerrar chat" class="bounce grid size-10 place-items-center rounded-full">
        <Icon name="cerrar" size={22} />
      </button>
    </header>

    <div data-chat-lista aria-live="polite" class="flex flex-1 flex-col gap-2.5 overflow-y-auto px-3 py-4">
      <p class="bg-blanco border-noche/15 max-w-[85%] self-start rounded-2xl rounded-bl-md border px-3.5 py-2.5 text-[15px] leading-snug">
        Hola, soy Eduardo, asistente comercial de Saltabum 👋 ¿Cómo te puedo ayudar?
      </p>
    </div>

    <template data-chat-plantilla="cliente">
      <p
        data-chat-texto
        class="bg-azul text-blanco max-w-[85%] self-end rounded-2xl rounded-br-md px-3.5 py-2.5 text-[15px] leading-snug whitespace-pre-line"
      >
      </p>
    </template>
    <template data-chat-plantilla="ia">
      <p
        data-chat-texto
        class="bg-blanco border-noche/15 max-w-[85%] self-start rounded-2xl rounded-bl-md border px-3.5 py-2.5 text-[15px] leading-snug whitespace-pre-line"
      >
      </p>
    </template>

    <template data-chat-plantilla="equipo">
      <div class="flex max-w-[85%] flex-col gap-0.5 self-start">
        <span class="text-noche-suave px-1 text-[11px] font-extrabold">Equipo Saltabum</span>
        <p
          data-chat-texto
          class="bg-celeste border-noche/20 rounded-2xl rounded-bl-md border px-3.5 py-2.5 text-[15px] leading-snug whitespace-pre-line"
        >
        </p>
      </div>
    </template>
    <template data-chat-plantilla="sistema">
      <p data-chat-texto class="text-noche-suave self-center px-4 text-center text-xs font-bold"></p>
    </template>

    <div data-chat-escribiendo hidden aria-label="Escribiendo" class="px-3 pb-2">
      <span class="bg-blanco border-noche/15 inline-flex items-center gap-1 rounded-2xl rounded-bl-md border px-3.5 py-3">
        <span class="bg-noche-suave size-2 animate-bounce rounded-full"></span>
        <span class="bg-noche-suave size-2 animate-bounce rounded-full [animation-delay:150ms]"></span>
        <span class="bg-noche-suave size-2 animate-bounce rounded-full [animation-delay:300ms]"></span>
      </span>
    </div>

    <a
      data-chat-whatsapp
      hidden
      href="#"
      target="_blank"
      rel="noopener"
      data-track="whatsapp"
      data-track-placement="chat"
      class="bounce bg-verde border-noche shadow-pop-s mx-3 mb-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-full border-2 px-4 font-extrabold no-underline"
    >
      <Icon name="whatsapp" size={20} />
      Seguir por WhatsApp
    </a>

    <form data-chat-contacto novalidate class="border-noche bg-blanco flex flex-col gap-2 border-t-2 p-3">
      <input name="nombre" required autocomplete="name" maxlength="120" placeholder="Nombre y apellido" aria-label="Nombre y apellido" class="bg-crema min-h-11 rounded-xl px-3.5 text-base outline-none focus-visible:ring-2 focus-visible:ring-azul" />
      <input name="email" type="email" required autocomplete="email" maxlength="200" placeholder="Correo" aria-label="Correo" class="bg-crema min-h-11 rounded-xl px-3.5 text-base outline-none focus-visible:ring-2 focus-visible:ring-azul" />
      <input name="telefono" type="tel" required autocomplete="tel" inputmode="tel" maxlength="30" placeholder="WhatsApp (+56 9…)" aria-label="Teléfono o WhatsApp" class="bg-crema min-h-11 rounded-xl px-3.5 text-base outline-none focus-visible:ring-2 focus-visible:ring-azul" />
      <p data-chat-contacto-error class="text-rojo-texto text-sm font-bold" aria-live="polite"></p>
      <button class="bounce bg-sol border-noche shadow-pop-s min-h-11 rounded-full border-2 font-extrabold disabled:opacity-50">Empezar a chatear</button>
      <p class="text-noche-suave text-center text-[11px]">
        Usamos tus datos solo para responderte y coordinar tu reserva. <a href="/politica-de-privacidad" class="underline">Privacidad</a>
      </p>
    </form>

    <form data-chat-form hidden class="border-noche bg-blanco flex items-end gap-2 border-t-2 p-2.5">
      <label class="sr-only" for="chat-texto">Escribe tu mensaje</label>
      <textarea
        id="chat-texto"
        name="texto"
        rows="1"
        maxlength="1000"
        placeholder="Escribe tu mensaje…"
        class="bg-crema max-h-32 min-h-11 flex-1 resize-none rounded-2xl px-3.5 py-2.5 text-base leading-snug outline-none focus-visible:ring-2 focus-visible:ring-azul"
      ></textarea>
      <button
        type="submit"
        aria-label="Enviar"
        class="bounce bg-sol border-noche shadow-pop-s grid size-11 shrink-0 place-items-center rounded-full border-2 disabled:opacity-50"
      >
        <Icon name="enviar" size={20} />
      </button>
    </form>
    <p data-chat-pie hidden class="text-noche-suave bg-blanco px-3 pb-2 text-center text-[11px]">
      Eduardo es el asistente virtual de Saltabum
    </p>
  </section>

  <button
    type="button"
    data-chat-abrir
    aria-label="Abrir chat con Saltabum"
    class="bounce bg-sol border-noche shadow-pop text-noche relative flex min-h-14 items-center gap-2 rounded-full border-2 px-4 font-extrabold group-data-[abierto]:hidden"
  >
    <Icon name="chat" size={24} />
    <span class="hidden sm:inline">¿Te ayudo?</span>
    <span
      data-chat-pendientes
      hidden
      class="bg-rojo-texto absolute -top-1.5 -right-1.5 inline-flex min-w-6 items-center justify-center rounded-full px-1.5 text-xs leading-6 text-white"
    ></span>
  </button>
</div>
