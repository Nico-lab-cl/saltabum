---
// Hero de las páginas internas, con la misma foto de fondo del home (FondoHero): un solo H1 con la palabra clave,
// bajada y botones. `destacado` es la parte del título que va en amarillo, como «V Región» en el home.
import { DESDE, DESDE_HORAS } from "../data";
import { RUTAS } from "../seo";
import FondoHero from "./FondoHero.astro";
import WaButton from "./WaButton.astro";

interface Props {
  eyebrow: string;
  titulo: string;
  destacado?: string;
  bajada: string;
  placement: string;
  mensaje?: string;
  /** Precio del sello redondo. En la página de un inflable va su precio y no «desde». */
  precio?: string;
}
const { eyebrow, titulo, destacado, bajada, placement, mensaje, precio } = Astro.props;

// Parte el título en tres para pintar la palabra clave sin tocar el texto del H1.
const i = destacado ? titulo.indexOf(destacado) : -1;
const partes = i < 0 ? null : [titulo.slice(0, i), destacado!, titulo.slice(i + destacado!.length)];
---

<section class="border-noche bg-noche text-crema relative isolate overflow-hidden border-b-2">
  <FondoHero />

  <div class="mx-auto flex min-h-[520px] max-w-[1320px] flex-col justify-center gap-5 px-4 pt-10 pb-12 lg:min-h-[min(600px,70vh)] lg:px-10 lg:py-16">
    <div class="flex max-w-[680px] flex-col gap-4 lg:gap-5">
      <p class="text-sol text-xs font-extrabold tracking-[1.2px] uppercase lg:text-sm">{eyebrow}</p>
      <h1 class="font-display text-[36px] leading-[1.08] font-semibold tracking-tight lg:text-[clamp(42px,4.2vw,60px)] lg:leading-[1.05]">
        {partes ? (<>{partes[0]}<span class="text-sol">{partes[1]}</span>{partes[2]}</>) : titulo}
      </h1>
      <p class="max-w-[620px] text-lg leading-[27px] lg:text-xl lg:leading-[30px]">{bajada}</p>
      <div class="grid w-fit gap-3 sm:flex sm:w-auto lg:mt-1 lg:gap-3.5">
        <WaButton placement={placement} size="l" message={mensaje} class="text-center leading-[22px] whitespace-nowrap">
          <span class="lg:hidden">Consultar por WhatsApp</span><span class="hidden lg:inline">Consultar disponibilidad por WhatsApp</span>
        </WaButton>
        <a
          href={RUTAS.reservar}
          class="bounce border-crema text-crema hover:bg-crema hover:text-noche inline-flex min-h-14 items-center justify-center rounded-full border-2 px-7 font-extrabold whitespace-nowrap no-underline lg:min-h-15 lg:text-lg"
        >
          Ver fechas disponibles
        </a>
      </div>
      <slot />
    </div>
  </div>

  <div
    aria-hidden="true"
    class="border-noche bg-celeste text-noche shadow-pop absolute right-6 bottom-8 hidden size-33 -rotate-12 flex-col items-center justify-center rounded-full border-2 text-center lg:flex xl:right-16"
  >
    {!precio && <span class="text-sm leading-[15px] font-extrabold">desde</span>}
    <span class="font-display text-[28px] leading-8 font-bold">{precio ?? DESDE}</span>
    <span class="text-sm leading-[15px] font-extrabold">{DESDE_HORAS}</span>
  </div>
</section>
