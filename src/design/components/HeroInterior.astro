---
// Encabezado de las páginas internas: un solo H1 con la palabra clave, bajada, botones e imagen opcional.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { RUTAS } from "../seo";
import WaButton from "./WaButton.astro";

interface Props {
  eyebrow: string;
  titulo: string;
  bajada: string;
  imagen?: ImageMetadata;
  alt?: string;
  placement: string;
  mensaje?: string;
}
const { eyebrow, titulo, bajada, imagen, alt = "", placement, mensaje } = Astro.props;
---

<section class="border-noche bg-sol border-b-2">
  <div class="mx-auto flex max-w-[1320px] flex-col gap-6 px-4 py-10 lg:flex-row lg:items-center lg:gap-14 lg:px-10 lg:py-16">
    <div class="flex flex-col gap-4 lg:flex-1">
      <p class="text-xs font-extrabold tracking-[1.2px] uppercase">{eyebrow}</p>
      <h1 class="font-display text-[38px] leading-[42px] font-semibold lg:text-[54px] lg:leading-[58px]">{titulo}</h1>
      <p class="max-w-[620px] text-lg leading-[27px] lg:text-xl lg:leading-[30px]">{bajada}</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <WaButton placement={placement} size="l" message={mensaje} class="text-center leading-[22px]">
          Consultar disponibilidad por WhatsApp
        </WaButton>
        <a
          href={RUTAS.reservar}
          class="bounce border-noche bg-blanco text-noche inline-flex min-h-14 items-center justify-center rounded-full border-2 px-7 font-extrabold whitespace-nowrap no-underline"
        >
          Ver fechas disponibles
        </a>
      </div>
      <slot />
    </div>
    {
      imagen && (
        <div class="lg:flex-1">
          <Image
            src={imagen}
            alt={alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 600px, 92vw"
            loading="eager"
            fetchpriority="high"
            class="border-noche shadow-pop-l aspect-[3/2] w-full rounded-[28px] border-2 object-cover"
          />
        </div>
      )
    }
  </div>
</section>
